          },
          {
            "domain": "default",
            "utterance": "As the global leader in agile market research, GutCheck works as an extension of your team and blends rigor, speed, and experience to uncover valuable audience insights – helping you make more informed decisions quickly and with confidence.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "GutCheck Culture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are driven to find future GutCheckers who thrive in an agile environment, who embody our GASI Values – aka hire people who Give A S***. We're not for everyone, and that's ok! Do you have grit? Do you want to grow by challenging yourself? Do you want to be part of something greater than yourself?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At GutCheck we believe that the best ideas come from within, and everyone's voice matters. We strive together every day to make heroes out of our clients. If this type of mindset ignites the passion within you, come join us!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our Technology",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "React, Typescript/JavaScript, NextJS, Cypress, Spring Boot, ElasticSearch, Kafka, MongoDB, Java, Microservices, AWS, Graph Database",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will conduct some of the most complex and vital work critical to the engineering department. You will help GutCheck diversify our technology, ensuring our competitive advantage in the marketplace and thereby creating value for the company, including high impact projects such as automation, platform development, and big data integration.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a collaborative full stack engineer to design, build and deploy solutions to complex problems.",
            "intent": "job_description"
          },
