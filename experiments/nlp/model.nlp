          {
            "domain": "default",
            "utterance": "ClearQuote app helps assess damages in cars based on images/videos - used by insurers, mobility providers and workshops.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What’s on offer – Opportunity to lead development of a global tech product, competitive pay and stock options",
            "intent": "job_description"
          },
          {
