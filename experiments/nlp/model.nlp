          {
            "domain": "default",
            "utterance": "Veteran Owned Firm Seeking a Java Developer with TS/SCI for Role in Springfield, VA",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "My name is Stephen Hrutka and I am the owner of a Veteran-owned firm in Washington, DC focused on Supply Chain, Strategic Sourcing, and Technical/Cleared Recruiting.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "HRUCKUS helps other Veteran Owned businesses recruit for positions across the SBA, HHS, DARPA, and other cutting-edge R&D related defense agencies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We just signed a new client looking to hire a Java Developer with active TS/SCI for a role in Springfield, VA.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Please see below for the position description. If you’re interested, I'd be glad to provide more details about the role and further discuss your qualifications.",
