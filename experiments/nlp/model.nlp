          },
          {
            "domain": "default",
            "utterance": "A best-in-class safety culture built to protect our employees – the mothers, fathers, sons, and daughters who deserve to go home safely each night.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "This is a full-time position averaging 40-45 hours per week. Interested candidates should apply at https://www.trihydro.com/about-us/careers with their application, resume, and cover letter addressed to Trihydro’s Recruiting Team.",
            "intent": "job_description"
