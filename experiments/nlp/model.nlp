            "utterance": "Opportunity",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a highly motivated individual, passionate about machine learning and AI, who enjoy working with high-end technologies to join our Team. As the Data Scientist, you will focus on developing impactful and innovative machine learning-based solutions for Orgn, partnering with the business stakeholders across the globe.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will partner with our business stakeholders across Orgn to identify opportunities to drive business solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Partner with leaders from across the business to translate the company's business objectives, market opportunities & portfolio of offerings into a formal, cohesive global commercial strategy",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Apply a broad array of analytics skills including machine learning, statistics, text-mining/NLP, and modeling to extract insights from structured and unstructured data sources and complementary real-world & digital information streams to business challenges",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Developing and evolving core commercial models used across all analytics packages. Examples of the models will be: Multi-Channel Analytics, Patient Pathways, Omni-Channel Segmentation, Territory Design, Customer Targeting, Attribution Modeling, & Predictive Commercial Mix",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design data test and learn experiments to drive personalized solutions across the customer journeys addressing key customer needs as well as enabling personalized experiences across each touchpoint through connective analytics",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborate across the business to prototype, launch and Iterate analytics capabilities that quickly scale globally",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Lead the development and implementation measurement planning aligning to strategy",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Lead the collaboration with local and global teams to ensure data-driven decisions are embedded in the business process.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Automate analytics models and simplify information management",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Consult with markets, regions, and leadership on defining the business questions to apply to be answered with analytic and then pulled through for measured value.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will perform data mining and analyzing given data to optimize and improve Orgn’s operation and business strategies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will assess data sources and data gathering techniques for effectiveness and accuracy.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will develop custom data models and algorithms to apply to the given data sets.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will apply predictive modeling to increase and optimize business outcomes.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will develop a testing framework such as A/B and test the quality of the framework.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will implement data models and monitor the outcomes of the models implemented.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will develop processes and tools for models to monitor and analyze the performance and accuracy of the models developed.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will gather and analyze data, devise innovative data science solutions, and build prototypes to enable the development of high-performance algorithms in scalable, product-ready code.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will contribute to application development.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will upskill and mentor team members on the data science tools and technologies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Total 4+ years of experience in data science.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Expert in using data mining/data analysis methods, building and implementing models, using/creating algorithms, and creating/running simulations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in using large data sets and using models to test the effectiveness of different courses of action.",
            "intent": "job_description"
          },
          {
