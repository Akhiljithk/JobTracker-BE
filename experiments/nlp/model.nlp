            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "SailPoint is the Worldwide Leader for Enterprise-Class IAM",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We minimize risk and maximize business growth by managing access to data and resources across your enterprise. We do it effectively and securely for every person who interacts with your organization—any user, on any device, anywhere in the world.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We were first to recognize that companies could benefit from an approach to identity that addresses both IT and business priorities. We developed a unique, risk-based model and leveraged that approach for everything from compliance to user provisioning. Then we followed that with the industry's first solution for truly extending enterprise identity management to applications in the cloud.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Today, we offer comprehensive products that can handle enterprise IAM on-premises or as a cloud-based service. This gives you the freedom to choose the best solution for your current needs, while at the same time establishing a clear path for future growth.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The ideal candidate on the DevOps team will be a self-starter who enjoys a fast-paced job, thrives on problem solving, and is committed to delivering seamless product availability to large enterprises around the world.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build and maintain a resilient, secure, and efficient SaaS application platform to meet established SLAs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Automate build, test, and deployment for distributed, fault-tolerant infrastructure",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Monitoring and incident response for distributed applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborate with developers to bring new features and services into production",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Utilize a combination of open-source and custom software to solve product challenges",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and implement IP Networking in VPC environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Drive improvement to operational practices and procedures",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proactively meet standards for information security and compliance, such as ISO, SOX, SSAE 16, etc.",
            "intent": "job_description"
          },
