            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Are you ready to explore a world of possibilities?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Join our DTCC family, and you’ll grow your expertise and become the best version of you. As you embark on a new journey, you’ll tackle challenges with flexibility and grace, learning new skills and advancing your career while having the time of your life.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Why You Would Love This Job:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Being a member of the SIFMU IT team means you will be a part of a technology team with a rich diverse skill sets and a great enthusiastic committed team. Whether it’s Java, Spring suite, JavaScript, AngularJS, Unix or Database skillset required for the project initiatives, we are there for each other collaborating and helping each other to achieve the common goal. We are embarking on an incredible multi-year transformation journey and we are looking for best-of-breed software engineers to join us on this journey.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In this role would be responsible to contribute towards new project implementations related to building of a modern data platform that is the backbone for all systems and applications at DTCC. There is also significant opportunity for advancement and growth in this role based on your performance and contribution towards the organization goals.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Your Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· 8+ years' experience in software development and architecture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Bachelor's degree preferred with Masters or equivalent experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Expertise in application, data, and infrastructure architecture disciplines",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Knowledge of industry-wide technology trends and best practices",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Advanced knowledge of software architecture, design, and development principles and practices",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Experience with building messaging, event-driven, and cloud-native application architectures",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Strong understanding of domain driven design and micro services architecture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Participate in requirements gathering with Product owners, business users and subject matter experts and come up with an elegant solution design adhering to best design patterns.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Write clean, self-documenting code following best practices on coding incorporating unit testing.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Collaborate with the Senior Application Architects and other technical contributors at all levels during the application development and resolve application defects identified during System Integration and User Acceptance Testing Phases",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Participate in code reviews, Sprint meetings and retrospectives.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Provide on-going maintenance support for the applications during Post-deployment support phase.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· In-depth understanding of all aspects of the Java platform and the Spring family of frameworks",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Expertise in working in in large, collaborative teams to achieve organizational goals",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Passionate about building an innovative culture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Be a self-starter providing creative and innovative ideas or solutions continuously improving the technological offering.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "**NOTE: Responsibilities of this role are not limited to the details above. **",
            "intent": "job_description"
          },
