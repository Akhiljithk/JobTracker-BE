          },
          {
            "domain": "default",
            "utterance": "Company Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Crown Equipment Corporation is a leading innovator in world-class forklift and material handling equipment and technology. As one of the world’s largest lift truck manufacturers, we are committed to providing the customer with the safest, most efficient and ergonomic lift truck possible to lower their total cost of ownership.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Primary Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Code, modify, and debug, web based applications in the .Net Framework or Java using additional technologies including Spring, Angular, HTML, JavaScript, and CSS.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Perform code review of team members to learn new techniques while providing code quality review.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Assist in analysis of interacting systems to ensure changes made to one system will not impact other systems. Work closely with the Business Analyst to ensure proper documentation of requirements.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Prepare technical specifications and other system and programming documentation in accordance with internal standards.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Provide knowledge transfer to Support and Operations personnel related to changes to systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Work with Quality Analysts to ensure changes are thoroughly tested before release. Write unit and integration tests for new code. Assist with the diagnosis of problematic applications and system testing.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Stay informed of advances and pertinent changes in hardware and software technologies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Minimum Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Understanding of Object Oriented programing principles, why they work, and how to best use them.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• A high school diploma or equivalent is required.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• 2-4 years experience required (Salary/level will commensurate with experience).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Preferred Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience with Scrum and Kanban desired.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Good written, verbal, analytics, and interpersonal skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Familiar with Test-Driven Development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Knowledgeable of Service-Oriented Architecture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work Authorization:",
            "intent": "job_description"
          },
          {
