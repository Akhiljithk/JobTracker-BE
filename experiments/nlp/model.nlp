          {
            "domain": "default",
            "utterance": "Job description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a senior backend developer in the product development team, your main responsibility is to build new and exciting features for our creative automation platform. Our platform is built on modern technologies like Vue.js, Laravel and Node.js. You will join a highly skilled team of developers (and designers) who enjoy a technical challenge and maximizing product value and user experience. The team works in two-week sprints where tasks are always a combination of roadmap features and the team’s own input.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Your main responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Building new platform features to add value for users",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Working on our infrastructure and nudging the team more towards a DevOps culture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Building new and improved features for our rendering infrastructure",
            "intent": "job_description"
          },
