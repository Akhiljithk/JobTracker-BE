          },
          {
            "domain": "default",
            "utterance": "Position Overview:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for iOS Developers responsible for the design and development of high volume end user products aimed at a range of iOS devices. Your primary focus will be development of iOS applications and shipping the project/module you own. A commitment to collaborative problem solving, high quality code, and a passion for technology is essential.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and build applications for the iOS platform using Swift, Rx Swift, and Objective-C.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Gradually take on more responsibility and have a bigger impact, take on more challenging tasks, mentor others, lead a module, manage a team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You own your modules end-to-end. We provide a sandbox to experiment and trust you to work through issues and deliver.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Stay up-to-date with technical trends. Be a part of RSL's learning culture by giving Tech Talks.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3-5+ Years Experience.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Development experience in Objective-C, Swift or Rx Swift.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with iOS frameworks such as Core Data, Core Animation, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding of Apples design principles and interface guidelines.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of the iOS ecosystem and the libraries available for common tasks.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Self-motivated, eager to learn, with strong logical reasoning skills.",
            "intent": "job_description"
          },
          {
