            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Over 8 years of experience as a Java developer with proven track record",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrated experience in Agile development methodology",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in Struts, Spring, Hibernate, Angular.js, Micro services and Restful services",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in developing integration software specifically IBM websphere; demonstrated experience in Rational Application Development (RAD) framework",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in Oracle RDBMS, PL/SQL and SQL*Plus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in UNIX/LINUX shell scripting.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proven track record as a self-learner keeping current with the latest techniques to include automated code scanning, automated testing, continuous integration and continuous deployment concepts",
            "intent": "job_description"
          },
          {
            "domain": "default",
