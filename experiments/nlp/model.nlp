          {
            "domain": "default",
            "utterance": "Job ID: 20WD40430",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Position Overview",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We’re growing our managed cloud team within Autodesk’s Infrastructure-as-a-Service organization. This team leverages Software Engineering and DevOps principles to build re-usable managed cloud stacks. Our engineering culture will empower you to make effective decisions, work collaboratively and take accountability for engineering projects at the core of the company and the leading edge of the latest industry technology trends. The team is seeking a Cloud DevOps Engineer who will have a critical role on how we design, build and deliver reusable managed cloud stacks",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and develop systems and processes that support highly available, scalable, fault-tolerant software deployments",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Automate provisioning, infrastructure, and code deployment by leveraging the latest in configuration management tools and containers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design, develop, and deploy tools and frameworks to improve and automate software releases",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Partner with QA to test application resiliency and gauge readiness for software releases",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build and maintain the environments and processes that create efficiencies for developers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Partner with Security Engineering to ensure security and compliance across enterprise environments",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Respond to platform failures and notifications swiftly and address any issues that affect the platform availability",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsible to build new features, upgrade the existing and maintain the platform with Operations and DevOps best practices",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding of modern development, tools and methodologies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Minimum Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "UNIX / Linux Operating systems and Bash scripting. Ability to design, develop, and maintain CI/CD environments. Configuration management tools including Ansible, Puppet, and Chef. Programming languages such as Perl, Python, Ruby, C++, and Java Containerization tools and techniques",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good knowledge on developing Complex cloud formation templates. (CFTs)",
            "intent": "job_description"
          },
          {
