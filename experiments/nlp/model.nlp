          },
          {
            "domain": "default",
            "utterance": "Job: Python Developer*",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are a professionally managed IT company based in Central Delhi, India. Our services include Website, Designing, Web Development, E-Commerce Website, Word-press Website, Logo & Banner, Web Hosting, SEO (Search Engine Optimization), SMO (Social Media Optimization), Pay Per Click (PPC), Digital Marketing & e-Learning, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description: *",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a Python Web Developer responsible for managing the interchange of data between the server and the users. Your primary focus will be the development of all server-side logic, ensuring high performance and responsiveness to requests from the front-end. You will also be responsible for integrating the front-end elements built by your co-workers into the application; therefore, a basic understanding of front-end technologies is necessary as well.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Duties and Responsibilities: *",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Daily duties for Python developers vary based on the websites, applications, and programs used by the hiring company. However, these main responsibilities are the same across all businesses and industries:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Maintain Existing Programs: Python developers maintain existing programs and apps used by the company, troubleshooting to spot potential problems and ensuring they continue to function smoothly.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Write New Programs: Python developers write new programs and applications to streamline business functions and increase productivity company-wide.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Reprogram Databases: Python developers reprogram existing databases to increase functionality and data capacity.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Manage Online Pages: Python developers streamline web portals by writing new programs in addition to designing and maintaining websites.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Manage Servers: Python developers manage and maintain company servers to keep them functioning efficiently across the network.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Design Marketing Programs: Python developers design programs for marketing campaigns, including promotional emails and web applications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Create Online Tools: Python developers create digital tools and applications to monitor online traffic and maximize the customer experience on web pages.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Skills And Qualifications: *",
            "intent": "job_description"
          },
