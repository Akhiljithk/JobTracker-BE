          },
          {
            "domain": "default",
            "utterance": "We are looking for a Node.js Developer responsible for managing the interchange of data between the server and the users. Your primary focus will be the development of all server-side logic, definition and maintenance of the central database, and ensuring high performance and responsiveness to requests from the front-end. You will also be responsible for integrating the front-end elements built by your co-workers into the application. Therefore, a basic understanding of front-end technologies is necessary as well.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Integration of user-facing elements developed by front-end developers with server side logic",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Writing reusable, testable, and efficient code",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and implementation of low-latency, high-availability, and performant applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Implementation of security and data protection",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Integration of data storage solutions {{may include databases, key-value stores, blob stores, etc.}}",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Skills And Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong proficiency with JavaScript {{or CoffeeScript depending on your technology stack}}",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of Node.js and frameworks available for it {{such as Express, StrongLoop, etc depending on your technology stack}}",
