            "domain": "default",
            "utterance": "Network Administrator",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "We are now looking for a Senior Network Engineer.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "NVIDIA Network Engineering is looking for a Senior Network Engineer to join its fast paced and results oriented team. Challenges include balancing project responsibilities with escalated operational issues. If you have a primary skillset in the routing and switching foundation, with the ability to define and lead primarily Data Center & Site projects globally this job might be for you.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What you’ll be doing:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Designs, plans and coordinates the implementation of network technologies in support of defined requirements generated by business and growth demands",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Validate project requirements, define project scope, develop project schedules and produce detailed designs for assigned projects",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Produce work breakdown structures that demonstrate understanding of proposed changes and how the change will be executed with minimal service impact",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Performs analysis and diagnosis of highly complex networking problems",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Builds simulated networks in test labs to resolve highly challenging problems and compatibility issues",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Prepare and maintain up to date documentation detailing configuration of deployed solutions. Generates network configurations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Plans and executes highly complex network upgrade and migration activity",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Assists with deployment and strategy of tools and related Network Management Systems",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provides mentor-ship for existing network team members as appropriate",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What we need to see:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "BS or equivalent plus 10+ years progressive experience in network engineering support environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience and expertise in network operations and service optimization in highly available, network infrastructure solutions in a large-scale, multi site, international environment. Some design experience is also a requirement.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Expert knowledge of Arista & Cisco Datacenter Switching technologies used in large scale Data Center Deployments",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong and In-depth knowledge of Datacenter Network Technologies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Expertise in IP inter networking, LAN Switching & Wireless Technologies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "WAN circuits and protocols (VPLS, MPLS, DWDM, DMVPN, Optimization)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Dynamic IP Routing protocols (OSPF, ISIS, EIGRP, BGP, PIM Multicast)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience on latest hardware and operating systems (Arista EOS, CRS, Nexus, IOS-XR, NX-OS, Junos)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in inter-AS connectivity (eBGP, MPLS)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "High Availability protocols and Global Server Load Balancing technologies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "New Generation Firewalls, Stateful firewalls, SSL, VPN",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Virtualization technologies, both networking (VRF, VDC, Nexus1kv) and compute (VMware, Openstack)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "High level inter networking troubleshooting in a large-scale network environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of network management, network availability and capacity planning",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Expertise in interfacing with carriers to manage circuit delivery, troubleshooting and migration",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must have exceptional verbal, written, interpersonal, and presentation skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must be creative and have initiative",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "CCIE or equivalent is a plus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ways to stand out from the crowd:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Self-driven and resourceful to achieve goals independently as well as work well in groups.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Flexibility to adjust to changing requirements, schedules and priorities. The ability to socialize ideas, make recommendations and gather team consensus to move forward.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must be able to effectively communicate both orally and in writing to technical and non-technical audiences at all levels in the organization; develop procedural documentation; develop and conduct effective presentations; and effectively demonstrate products and solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to connect new technology initiatives to cost savings and ROI calculations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "NVIDIA is leading the way in groundbreaking developments in Artificial Intelligence, High-Performance Computing and Visualization. The GPU, our invention, serves as the visual cortex of modern computers and is at the heart of our products and services. Our work opens up new universes to explore, enables amazing creativity and discovery, and powers what were once science fiction inventions from artificial intelligence to autonomous cars. NVIDIA is looking for exceptional people like you to help us accelerate the next wave of artificial intelligence.",
            "intent": "job_description"
          },
