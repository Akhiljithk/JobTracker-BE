          {
            "domain": "default",
            "utterance": "GlowRoad has 2 days work from office on Monday and Friday. Hence, no remote work from home option.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "About GlowRoad:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Glowroad is building India’s most profitable social e-commerce platform where resellers share the catalog of products through their network on Facebook, Whatsapp, Instagram, etc, and convert them to sales. Glowroad is on a mission to create micro-entrepreneurs (resellers) who can set up their web-store, market their products, and track all transactions through GlowRoad’s platform. Glowroad app has ~10M downloads and 1 lakhs DAU’s.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Glowroad has been funded by Accel Partners and recently raised series B+ funding for a total of 24.5 million USD. We are scaling our operations across India.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Glowroad is looking for team members passionate about building platforms for next billion users and reimagine the e-commerce for mobile-first users",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A fun, open, energetic, and creative environment. Approachable leadership, filled with passionate people, open communication, and provides high growth for employees.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What are we looking for:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Looking for team members passionate about building platforms for next billion users and re-imagine the e-commerce for mobile-first users. You will be building solutions for personalization, logistics, search & discovery, payments, fraud prevention, and scalability that works and solve problems elegantly.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As Back end developer, we expect you to be motivated in solving real-life complex problems and create compelling experiences for our Resellers. Being a small company we have a culture of creative problem solving, intellectual design, fast-paced development, and passionate product delivery. Enhance or build Restful web services for our mobile app.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop server-side components, REST APIs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Assume ownership for existing and new modules including design, development, and unit testing for enhancements of existing modules and development of new modules.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Analyse problems logically and exercise sound judgment in defining, evaluating, and solving difficult technical and operational problems where solutions may be of a precedent-establishing nature.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Lead the design and architectural improvements",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Participate and collaborate with team members in design discussions, determines areas of complexity, potential risks to successful implementation, suggest enhancements to architecture, implement POCs, and enhance application.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Reduce technical debt with quality coding",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A solid grounding in Computer Science fundamentals (based on a BS or MS in CS or related field) from IITs and Premier Engineering College.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent Object Orientation, coupled with excellent problem solving and debugging skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Highly skilled at Java and related technologies, including Java Frameworks like Spring-boot or Drop wizard, RESTful web services, JSON, Servlet, JSP, MySQL, MongoDB, Kafka, AWS Solr.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must have hands-on experience in building scalable and secure back end systems.",
            "intent": "job_description"
