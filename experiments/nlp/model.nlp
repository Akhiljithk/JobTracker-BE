            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "DESCRIPTION",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Department: Operations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Title: DevOps Engineer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Location: Bangalore, India",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The Syncron Operations Team is seeking engineers that enjoy solving problems, working with customers, have a strong technical background in application management and software development including Terraform, Git, Gerrit, Jenkins and at least one popular programming language (Python preferred). Do you have experience as a Systems Administrator working with Linux or Unix and understand the advantages of working in a highly distributed virtual environment? Can you read and troubleshoot code snippets? You will be responsible for deploying, automating, maintaining, troubleshooting and improving the systems that keep the backend infrastructure running smoothly. The role requires you to have hands-on technical experience and a can-do approach towards environment automation / management and continuous improvement. The role will encompass the use of a broad range of AWS technologies including but not limited to EC2, RDS, Lambda, IAM, Athena, VPCs, Terraform, etc with an emphasis on the implementation of best practice cloud security principles If you fit the description, you might be the person we are looking for!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Troubleshoot application deployments, recreate customer issues, build proof of concept applications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Apply advanced troubleshooting techniques to provide unique solutions to our customers' individual needs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build and maintain the backbone of the Syncron infrastructure in AWS cloud",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build and maintain Terraform deployments, Jenkins pipelines and shell and Python scripts to automate and deploy AWS",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborate and help build utilities and tools for internal use that enable you and your fellow Syncron Engineers to operate safely at high speed and wide scale",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Leverage your day-to-day experiences to provide feedback on customer experience to internal Syncron teams",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Drive communication during critical events",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Write tutorials, how-to, and other technical articles",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work on critical, complex problems that will span multiple AWS services and Syncron products",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Learn and use groundbreaking technologies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Systems administration (Linux based Operation System)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2+ years of experience in a DevOps role, or experience setting up, maintaining and coordinating the automated patch and configuration management of production servers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with Infrastructure as a Code tools, preferably Terraform",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with CI/CD tools, preferably Jenkins, particularly pipelines to automate deployment and maintenance of Linux application servers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Programming/scripting with Python and/or Bash. Other languages a bonus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience managing full 3 tier application stacks from the OS up through custom applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent written and oral communication skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with AWS, GCP or Azure. AWS Certificates would be a plus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "About Syncron",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Syncron empowers the world’s leading manufacturers to maximize product uptime and deliver exceptional after-sales service experiences while driving significant revenue and profit improvements. From industry-leading investments in research and development to provide the fastest time-to-value, Syncron’s award-winning, cloud-based service parts inventory, price, order and uptime management solutions are designed to continually exceed customer expectations. Top brands from around the world trust Syncron to transform their after-sales service operations into competitive differentiators. For more information, visit syncron.com",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As data controller of your personal data, we are required to provide you with several information to foster your data privacy rights. Please read them here.",
