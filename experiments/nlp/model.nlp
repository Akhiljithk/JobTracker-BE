          {
            "domain": "default",
            "utterance": "A solid understanding of configuration management principles and tools such as Chef.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Comfortable with supporting and operating high availability Cloud services and provide on-call support for Sev1 incidents on production and critical development/QA cloud environments.",
