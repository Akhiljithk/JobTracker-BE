          {
            "domain": "default",
            "utterance": "Monitor and optimize systems to ensure best performance.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Perform unit testing using tools like MSTest, NUnit and Jasmine and mocking frameworks like Moq.",
