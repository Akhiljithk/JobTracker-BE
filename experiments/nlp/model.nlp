            "utterance": "· Strong background in applying statistical machine learning techniques to predictive modelling and experience with Machine Learning libraries (via R, H2O, Python, Spark, etc.)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Proficiency in programming in Python, R, SQL, Javascript, Java/Scala and shell scripting",
            "intent": "job_description"
          },
          {
