          {
            "domain": "default",
            "utterance": "Node js developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Node JS Developer 1-5 yrs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Department: App Backend,Mobility,Web Development | Number Of Positions: 2",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a Node.js Developer responsible for managing the interchange of data between the server and the users. Your primary focus will be the development of all server-side logic, definition, and maintenance of the central database, and ensuring high performance and responsiveness to requests from the front-end. You will also be responsible for integrating the front-end elements built by your co-workers into the application. Therefore, a basic understanding of front-end technologies is necessary as well.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Type: Full-time",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Salary: Rs 200,000.00 – ₹ 550,000.00 per year",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Candidate should have 6 Months to 4 years",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Mongodb: 1 year (Required)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Node: 1 year (Required)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong proficiency with JavaScriptKnowledge of Node.js, MongoDB, REST API (#1-2), Socket.IO, Express.js, Parse.com, HTML, CSS, Angular and frameworks available for it Understanding the nature of asynchronous programming and its quirks and workarounds Good understanding of server-side templating languages Understanding accessibility and security complianceUser authentication and authorization between multiple systems, servers, and environments Integration of multiple data sources and databases into one system Understanding fundamental design principles behind a scalable application Understanding differences between multiple delivery platforms, such as mobile vs. desktop, and optimizing output to match the specific platform Creating database schemas that represent and support business processes Proficient understanding of code versioning tools, such as Git Good understanding of at least one Node js development frameworks, such as Express js, Hapi js, etc. If the person is familiar with Mac development environment that would be even better. Candidate's minimum qualification should be graduation (B.Tech/B.E./B.C.A)",
            "intent": "job_description"
          },
