          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are seeking a WordPress Developer responsible for both back-end and front-end development, including creating WordPress themes and plugins. This position requires a combination of programming skills (namely PHP, HTML5, CSS3, and JavaScript) and aesthetics (understanding element arrangements on the screen, the color and font choices, and so on). The candidate should have a strong understanding of industry trends and content management systems. Experience with the responsive and adaptive design is strongly preferred. Also, an understanding of the entire web development process, including design, development, and deployment is preferred.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Designing and implementing new features and functionality",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Establishing and guiding the website’s architecture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensuring high-performance and availability, and managing all technical aspects of the CMS",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Helping formulate an effective, responsive design and turning it into a working theme and plugin.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Skills and Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good understanding of front-end technologies, including HTML5, CSS3, JavaScript, jQuery",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience building user interfaces for websites and/or web applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience designing and developing responsive design websites",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Comfortable working with debugging tools like Firebug, Chrome inspector, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to understand CSS changes and their ramifications to ensure consistent style across platforms and browsers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to convert comprehensive layout and wireframes into working HTML pages",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of how to interact with RESTful APIs and formats (JSON, XML)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient understanding of code versioning tools {{such as Git, SVN, and Mercurial}}",
            "intent": "job_description"
