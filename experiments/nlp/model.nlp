            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Machine Learning Engineer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for an expert in machine learning to help us extract value from our data. You will lead all the processes from data collection, cleaning, and preprocessing, to training models and deploying them to production. The ideal candidate will be passionate about artificial intelligence and stay up-to-date with the latest developments in the field, and know how to program in C++ (we rarely use Python).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "B.Tech./ B.E / MCA degree in Computer Science, Engineering or a related stream.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3+ years of machine learning experience.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficiency with a deep learning framework such as TensorFlow or TensorRT.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Expertise in visualizing and manipulating big datasets.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficiency with Linux, C++, OpenCL, OpenMP and OpenCV (we have no use of Python in deployments).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to determine hardware requirements to run an ML model with the required latency.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Extremely good understanding of embeddings, and how to play with them.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Extremely good understanding of CNN, LSTM, GANs, Attention Models, Advanced Loss Functions, Hyper-convergence and batch processing.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What we Expect from you?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Analyzing the ML algorithms that could be used to solve a given problem and ranking them by their success probability.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Exploring and visualizing data to gain an understanding of it, then identifying differences in data distribution that could affect performance when deploying the model in the real world.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Verifying data quality, and/or ensuring it via data cleaning.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Supervising the data acquisition process if more data is needed.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Defining validation strategies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Defining the preprocessing or feature engineering to be done on a given dataset.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Defining data augmentation pipelines.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Training models with hyper-convergence strategies and tuning their hyperparameters.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Analyzing the errors of the model and designing strategies to overcome them.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Deploying models to production in C++.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding business objectives and developing models that help to achieve them, along with metrics to track their progress.",
            "intent": "job_description"
          },
          {
