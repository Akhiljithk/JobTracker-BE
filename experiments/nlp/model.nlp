            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Req ID:97606",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "NTT DATA Services strives to hire exceptional, innovative and passionate individuals who want to grow with us. If you want to be part of an inclusive, adaptable, and forward-thinking organization, apply now.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are currently seeking a Network Security Specialist Advisor to join our team in Noida, Uttar Pradesh (IN-UP), India (IN).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge, Skills and Abilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to grasp complex issues to arrive at optimal solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong ethics and integrity",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Flexible to changing needs of customer , account and team",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent customer facing communication skills, customer support and knowledge of ITIL best practices.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Advanced experience and proven knowledge in atleast 4 of different network security products likes Firewalls (Cisco, Checkpoint, Palo Alto, Juniper, Sonicwall), Content Filtering (Bluecoats, Websense, McAfee Web gateway) and IDS/IPS (Cisco Sourcefire, McAfee, Tipping Point, Snort)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Advanced networking troubleshooting skills and extensive knowledge of web connectivity and protocols (WCCP, PAC files, TCP/IP, HTTP, HTTPS, SSL, FTP, Telnet, SSH, etc.)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Integration with authentication protocols such as LDAP, IWA, IWA-direct, SSO, Active directory.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience deploying and supporting forward proxy, explicit and transparent Web Content Filtering / Web Proxy configurations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "8+ years of network troubleshooting experience and at least 6 years of Network Security administration and design experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Atleast 2-3 Advanced level certification from Cisco, Checkpoint, Juniper, McAfee, BlueCoat, SourceFire (CCSE, CCIE, CCNP Security, PCNSE, CCSP, JNCIP, BCCPA, BCCPP etc)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent Time Management skills required to properly manage operations duties and other task that will assist in the optimization of the firewall team",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to chair bridge calls delegating tasks and drive to resolution Escalation calls for Technical Security issues collaborating with other support teams.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong understanding of Windows and Linux operating systems",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelors degree or equivalent experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Desired Skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Current Cisco Certified Internetwork Expert (CCIE) Proficiency is a plus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Implementing and managing multiple IDS/IPS solutions technologies (Sourcefire, McAfee, TippingPoint, Snort or Cisco)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experienced with ITIL best practices and familiar with regulations such as SOX, PCI, HIPPA",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Professional level certification in Web Content Filtering products such for Bluecoat, Websense, Cisco, Microsoft, McAfee such as BCCPA, BCCPP, CISSP, CCNA, CCSP, CEH are desirable.",
            "intent": "job_description"
          },
          {
