          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Ideas2IT* is a high-end product firm. Started by an ex-Googler, we count Siemens, Motorola, eBay, Microsoft, and Zynga among our clients. We solve some very interesting problems in the USA startup ecosystem and have created great products in the process. When we build, we build great! We actively contribute to open source projects. We’ve built our own frameworks. We’re betting the house on Big Data, and with a Stanford grad leading the team, we’re sure to win.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ideas2IT* has successfully rolled out multiple products that have become startups in their own right. Example: *Pipecandy*. Continuing in this path, currently, we are developing a new-age AI-driven Process Automation Platform.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a strong *DevOps Engineer* to work on our and our customer products.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Role Responsibilities: *",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Perform capacity planning, automation, testing, performance tuning, and tools development.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Develop and maintain continuous integration and continuous delivery pipeline.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Develop and deploy a control plane for all platform services to guarantee observability, monitoring, analytics, and alerting.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Provide on-call support for the platform.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Collaborate with the DevOps teams of the SaaS products built on the platform to resolve incidents and implement changes quickly and efficiently.",
            "intent": "job_description"
          },
