          },
          {
            "domain": "default",
            "utterance": "Who are we?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At Amdocs, our purpose is to enrich lives and progress society. With our creativity and technology, we help make a better connected world. Amdocs and its 25,000 employees serve the leading players in the communications and media industry, enabling next-generation experiences in 85 countries. Our cloud-native, open and dynamic portfolio of digital solutions, platforms and services brings greater choice, faster time to market and flexibility, to better meet the evolving needs of our customers as they drive growth, transform and take their business to the cloud. Listed on the NASDAQ Global Select Market, Amdocs had revenue of $4.1 billion in fiscal 2019. For more information, visit Amdocs at http://www.amdocs.com",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In one sentence",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsible for automating and maintaining complicated installations none production and production environments and process of software development and testing.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "All you need is...",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelors Degree in Computers or related field.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Total Experience - 2 to 4 years",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in writing deployment and full life cycle for complicated systems and defining architecture requirements for deployment and automations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At least 2 years of experience in DevOps development and support experience (like Jenkins CI/CD, Nexus, NPM, GIT, Maven)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At least 2 years of experience in Deployment tools - Ansible (playbooks and roles), Kubernetes and Containers (Docker)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At least 2 year of experience in scripting tools - bash, Python, Perl, Groovy, PowerShell",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At least 2 years of experience in Public cloud development (AWS, Google) or private Clouds (OpenStack, VMWare)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in DevOps tools (monitoring and tracing tools, security, logging)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in Linux (like Ubuntu, RHEL, ALM)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Team Worker with good interpersonal, communication and fast learning skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Highly adaptive to any type of work environment and technology.",
            "intent": "job_description"
          },
          {
            "domain": "default",
