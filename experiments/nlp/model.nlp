            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong Software Test engineering methodology and process knowledge",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Skills Required",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with automation and automated test tools (Python) is a must",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in test engineering concepts and methodologies including test planning, test case design, test execution and test automation",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good knowledge and testing skills in L2 and IP/MPLS forwarding technologies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": ": IGP (OSPF, ISIS), BGP, L2 VPNs (VPWS, VPLS), MPLS (LDP, TE, FRR), Segment Routing",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge on Optical technologies and Layer-1 protocols such as OTN, SONET, SDH is preferred",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good working knowledge on Python and Automation methodologies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good working knowledge with traffic generators and analyzers (e.g. Agilent, Spirent, IXIA, JDSU etc)",
