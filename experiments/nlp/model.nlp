            "utterance": "Network Administrator",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Company Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Positioned at Publicis Groupe's core, Epsilon is a leader in interaction management, empowering brands to transform ordinary customer experiences into meaningful, human experiences. Through a connected suite of products and services, Epsilon combines leading-edge identity management, industrial strength data and technology expertise with big brand acumen gained over five decades working with the industry’s top brands. Our human-powered, data-led marketing delivers unmatched depth, breadth and scale to help brands turn meaningful human interactions into exceptional business outcomes. For more information, visit us at https://india.epsilon.com/",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Follow us on social: LinkedIn, Facebook, Instagram, and Twitter",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsible for design, development and implementation of network services and technologies to meet our client and enterprise requirements. Primary objective is to identify optimal networking and communications solutions that deliver long term capabilities, capacity, reliability and resiliency for the enterprise and clients to successfully maintain and grow business and client operations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Duties and Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Lead (Preferably) level role that involves understanding client and enterprise technical requirements and designing and deploying optimal networking and connectivity solutions that enable clients and the enterprise to achieve their operational and business goals.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required to prepare recommendations and supporting details for formal project proposals for network connectivity and configurations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Day-to-day interaction with telecom providers, equipment suppliers and 3rd party network vendors, to engage their technical resources to perform tasks.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Role requires on-call support as well as scheduling and attendance for maintenance windows.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Resource can expect to routinely be called upon to analyze and interpret traffic and utilization of services on network connections.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Participation in disaster recovery exercises, pre-production certification testing and troubleshooting events is expected.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Coordinate internal operations to meet and exceed data communications project expectations (including but not limited to engineering/development, certifications testing, Network and IT Operations, capacity planning and production readiness.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Accountable for resolving all project level, cross-functional, partnership issues and escalations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage client expectations for data communications connectivity and related services to Epsilon products and applications, throughout project(s) lifecycle. Client expectations include functionality, cost, delivery schedule, support readiness and relationships (usually working directly with senior level technical resources, project managers and business decision makers).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "High organizational skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to handle multi-tasks and meet deadlines",
            "intent": "job_description"
          },
          {
            "domain": "default",
