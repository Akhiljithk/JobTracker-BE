          },
          {
            "domain": "default",
            "utterance": "We’re looking for a DevOps Engineer to help revolutionize our infrastructure, automate our operational day to day tasks and managing high-throughput business-critical services, with specific emphasis on long-term maintainability, resilience against failures, and high scalability.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You are going to interact, communicate, and collaborate also improve the relationship between Development ( Product Engineers ), Test Engineer, Network Engineer, and Security Engineer to deliver production system and software that is more stable and maintainable.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You need to empower the team and people around you to build the culture of join responsibility for faster and safer delivery, work together as a team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "About Your Responsibilities for the Role",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage infrastructure use CI/CD process and automation tools such as Ansible",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build script to automate operational and deployment process use programming language like Python, Go, Ruby",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Optimizing Infrastructure Automation thru repetitive refactors and Infra Architecture Review",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Deploying, automating, maintaining, building and managing On-Prem and Cloud-based production systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop and integrate monitoring, logging, dashboard, and alert systems to quickly and proactively prevent or detect errors",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure the availability, performance, scalability, and security of Infrastructure.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build, release and manage configuration management of infrastructure and application in multiple environments.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Within a cross-functional team, collaborate with other engineers specializing in backend services, web frontend, mobile apps, and test automation, as well as product design and ideation.",
            "intent": "job_description"
          },
