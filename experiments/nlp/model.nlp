          },
          {
            "domain": "default",
            "utterance": "2. Pixel-perfect implementation of approved user interface meeting business & functional requirements.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3. Ensure the best possible performance, quality, and responsiveness of the application.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "4. Design and implementation of continuous integration and deployment/release apps to Google and Apple stores.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "5. Work on bug fixing, improving application performance and help in code optimization.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "6. Ensuring the entire stack is designed and built for speed, scalability and reliability.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "7. Continuously discover, evaluate, and implement new technologies to maximize development efficiency.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required Skills:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "1. Strong understanding of iOS and Android Native architecture and development tools.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2. Solid understanding of best practices in mobile UX design.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3. Experience with third-party libraries and REST APIs familiarity with OOP design principles.",
