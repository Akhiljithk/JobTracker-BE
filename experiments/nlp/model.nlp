          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Company Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "ixigo is an AI-based travel app that helps millions of users plan and book their trips every day. Launched in 2007, ixigo is proud to have built numerous industry-first AI-innovations over the last decade. With pre-emptive help from ixigo at every touch-point of their journey, 150 million Indians are now making smarter travel decisions every year. ixigo uses Artificial Intelligence for deal discovery, personalized recommendations, dynamic marketing, airfare predictions, train delay information, PNR confirmation status, infrastructure cost optimization, business intelligence and providing fully-automated customer service over chat and voice. This makes ixigo a lean, tech-intensive and capital-efficient travel business, serving millions of travelers with a team size of under 200. Founded in 2007 by Aloke Bajpai & Rajnish Kumar, ixigo’s investors include Sequoia Capital India, Fosun RZ Capital, SAIF Partners, MakeMyTrip & Micromax.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Details",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a Devops Engineer, you will be involved in providing production support of a highly complex Linux multi-tier infrastructure. You will also take responsibility for the installation, administration & maintenance of our Linux production & development servers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You need proficiency on:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Data Servers: MySQL, Neo4J & MongoDB Database administration",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Web & Application Servers: JBOSS, Apache Tomcat, NodeJS administration",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "File systems, data backup and disaster recovery for all servers and desktops",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "High availability monitoring and alerting systems (MRTG / SNMP experience)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Cloud management: Create new nodes, provide new servers and services",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "xNIX OS updates, configurations changes, user management and access control",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "System and Database security as well as documenting the configuration of the system",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Handling office system and network infrastructure.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Skills & Qualifications:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "BE/BTech from a premiere Engineering college",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2-4 years of experience in Systems and Database administration",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to independently handle daily sysadmin requests as well as performing scheduled system checkups",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of Linux deployment and daytoday administration",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience on Terraform, Kubernetes, Docker, Helm, Jenkins, CI/CD, Github",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Building and deploying Micro Services on Kubernetes.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of Cloud infrastructures will be required (Amazon EC2, VPC)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with Logging, Monitoring and reporting solutions such as Prometheus, Grafana, Kibana (ELK), New Relic etc",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good knowledge of web infrastructure and common paradigms: Memcached, reverse proxies, SSL, CDN",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in administering Linux servers including the use of backup solutions, OS level, and application-level security, monitoring and troubleshooting",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Functional knowledge of TCP/IP, Firewalls, DMZs, DNS essential",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of JBoss / Tomcat administration will be preferred",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient in installing, administering and automating MySQL and/or MongoDB server databases",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Extensive experience automating system tasks and infrastructure using a scripting language (Python, Bash, Shell)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Compensation: Commensurate to skills & experience; comparable to the best in the industry.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Culture: ixigo is proud to have built an entrepreneurial culture that has become a folk-lore in the startup ecosystem. One in every four ixigems has gone on to build successful startups and companies. Our cultural values of integrity, empathy, ingenuity, awesomeness, and resilience have stood the tests of time and we’ve built a fun, flexible and creative work environment that is driven by people with a high degree of ownership. You will get to work with some of the smartest folks in the Indian startup ecosystem, and solve some of the toughest problems for the next billion users by using bleeding-edge technologies. Oh, and we have an awesome “play” area, great chai/coffee, free lunches (yes, they exist!) and a workspace you will fall in love with.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Additional Information",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Securonix (securonix.com) is the market leader in entity and user behavior analytics offering risk mitigation, incident response and rapid detection of sophisticated insider threats and cyber-attacks. Securonix helps their clients across the globe address their cyber security needs including the detection of advanced persistent threats (APTs), insider threats, privilege account misuses, and enterprise and online fraud. Our security analytics platform is used by some of the largest organizations in the financial, healthcare, pharmaceutical, manufacturing, and federal sectors.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Securonix is looking for a dev-ops Engineer to join the Content, Threat Research and Analytics (CTA) team to own the content migration management along with integrating with new data science algorithms.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will be required to work with different cross-functional teams including product engineering, field engineers, threat researchers and data scientists. The role will require automating the content migration process and integrating with various big data technologies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Role and Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Own all automation aspects of committing new content",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work closely with Product Management and Development teams to oversee updates to content",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Automate and be responsible for content packing while maintaining versions around content updates and changes",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to translate and automate any changes to content files / XMLs as required",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understand business needs for updates and translate those to a solution",
            "intent": "job_description"
          },
