            "utterance": "Very Strong knowledge of databases and hands on MS SQL/MySQL/PostgreSQL or NoSQL DB DynamoDB/MongoDB.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of any JavaScript framework like Angular JS (version >2)/ NodeJS etc.",
            "intent": "job_description"
