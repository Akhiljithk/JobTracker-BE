            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Staff Engineer (Java Full Stack)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "6 to 9 years of experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "ABOUT NAGARRO:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Nagarro helps clients transform, adapt, and build new ways into the future through an entrepreneurial, agile, and caring mindset. We excel at digital product engineering and deliver on our promise of thinking breakthroughs. Today, we are 8,400+ experts across 25 countries, forming a Nation of Nagarrians, ready to help our customers succeed.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At Nagarro, you can look forward to a work culture that is dynamic and non-hierarchical. You will be given opportunities to add value to challenging and complex assignments, while collaborating with world class technologists. The versatile environment here, helps foster fresh perspectives and enables you to deliver high quality code. There will be ample opportunities provided for skill upgradation to accelerate your professional and personal development.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "WHAT MAKES YOU A GOOD FIT FOR THIS ROLE:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Relevant experience in Java 8 or higher, Spring Framework-Core/Boot/MVC, Hibernate/JPA, HTML, CSS, Angular4+, React JS/Ember.js/Vue.js, JavaScript and Microservices Architecture.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in SOA based architecture, Web Services (Apache/CXF/JAXWS/JAXRS/SOAP/REST)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in CI/CD DevOps - Jenkins/Docker/Ansible, Cloud – AWS Unit Testing, Performance Tuning,",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Hands on experience of RDBMS like SQL Server, Oracle, MySQL, PostgreSQL.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A good understanding of UML and design patterns",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of high-quality professional software engineering practices for agile software development cycle, including coding standards, code reviews, source control management, build processes, testing, and deployment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Fundamental knowledge of design patterns",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in communicating effectively with users, other technical teams, and management to collect requirements, describe software product features, and technical designs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Passionate about building great solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Mentoring the team members to meet the client's needs and holding them accountable for high standards of delivery",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Being able to understand and relate technology integration scenarios and be able to apply these learnings in complex troubleshooting scenarios",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "WHAT ARE YOUR RESPONSIBILITIES:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Writing and reviewing great quality code",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding functional requirements thoroughly and analyzing the client’s needs in the context of the project",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Envisioning the overall solution for defined functional and non-functional requirements, and being able to define technologies, patterns and frameworks to realize it",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Determining and implementing design methodologies and tool sets",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Enabling application development by coordinating requirements, schedules, and activities.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Being able to lead/support UAT and production roll outs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Creating, understanding and validating WBS and estimated effort for given module/task, and being able to justify it",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Addressing issues promptly, responding positively to setbacks and challenges with a mindset of continuous improvement",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Giving constructive feedback to the team members and setting clear expectations.",
            "intent": "job_description"
          },
          {
