            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "1. Developing new user-facing features using React.js",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2. Building reusable components and front-end libraries for future use",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3. Translating designs and wireframes into high quality code",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "4. Optimizing components for maximum performance across a vast array of web-capable devices and browsers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "1. Strong proficiency in JavaScript, including DOM manipulation and the JavaScript object model",
