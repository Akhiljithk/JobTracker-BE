            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with Bash, Python, Cloud Platform, MongoDB, Cassandra, ElasticSearch, CI/CD (Jenkins), and Ansible",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Able to collaborate effectively and create open communication cross-functionally",
            "intent": "job_description"
          },
          {
            "domain": "default",
