            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What will your job look like?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will drive the automation of multiple parts of infrastructure and deployment systems, striving to improve and shorten processes to enable engineering and operations teams work smarter and faster.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will collaborate with related product development teams to drive automation of configuration management, build, release, deployment and monitoring processes including team’s instruction on the developed tools.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will work with IT and development in order to create the integration and continuity of the code holding holistic view of their working environments.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will support engineering and operations teams to meet infrastructure needs.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will provide professional support for the developed automations, responding to incidents in an effort to avoid system outages or restore availability to meet SLAs.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will monitor AWS instances and other web based applications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will lead the integration between product infrastructure system and Amdocs infrastructure system.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will design and develop infrastructure interfaces and stay abreast of industry best practices and contribute ideas for improvements in DevOps practices, delivering innovation through automation to enable standard deployable units of infrastructure through multiple environments into production.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will research new technology on the market.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will plan, design, program and implement new technology in accounts/products life cycle.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will participate in the planning, design, and implementation efforts",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Why you will love this job:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will be have the opportunity to lead the integration between a major product infrastructure system and the Amdocs infrastructure system, driving automation helping teams work smarter and faster",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will be a key member of a global, dynamic and highly collaborative team with various possibilities for personal and professional development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will have the opportunity to work in multinational environment for the global market leader in its field",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Amdocs is an equal opportunity employer. We welcome applicants from all backgrounds and are committed to fostering a diverse and inclusive workforce",
            "intent": "job_description"
          },
          {
