          },
          {
            "domain": "default",
            "utterance": "Job Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Micro Focus is one of the worlds largest enterprise software providers, delivering the mission-critical software that keeps the digital world running. We combine pragmatism, discipline, and customer-centric innovation to deliver trusted, proven solutions that customers need in order to succeed in todays rapidly evolving marketplace. Thats high tech without the drama.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "About the opportunity",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a dynamic, highly motivated, hands-on Senior Engineering manager who can lead and develop a team of software engineers. The teams will be developing and managing products in the emerging Cybersecurity and Predictive Analytics areas. You will be responsible for leading a team in full stack product development of enterprise software. You must have good technical acumen and aptitude to oversee & coach the team on agile practices, building enterprise software, performance, scalability & maintainability. You will be expected to manage the dynamics of the fast paced environment, multitude of technology. You will be responsible for managing and coordinating resources, tuning processes in order to make quality & timely deliveries.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Guide and coach first line managers and senior technical members in the domain/product in ensuring successful and timely project deliveries with sufficient risk mitigations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensuring on-time and quality deliveries in train model across different product lines in parallel.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Exhibit cross-functional knowledge to monitor efficiency of the systems/process in the entire software development and supply chain",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strategic engagement with Product Management team and Customer facing teams to understand the product opportunities and influence the roadmaps",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Handle customer escalations and provide swift actions and satisfactory experience to the customers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to create goals, facilitate cascade through first line management, provide clarity & priority of the same in line with organization goals",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong written and verbal communication skills to be able to conduct effective group/stakeholder meetings",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong interpersonal strengths to understand the strength of the team, conflict management work towards excellence",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Effective talent management within the group, and setting up good hiring and training plans",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Working across the group with peers for shared goals",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Effective budget utilization within the group",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good leadership and negotiation skills to deal with ambiguities and challenging interactions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Innovative thought process in problem solving",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop & manage relationships through the organization to re-inforce culture of collaboration",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Keep abreast of latest technologies, best practice and apply relevant to the org,",
            "intent": "job_description"
          },
          {
