          {
            "domain": "default",
            "utterance": "Role and Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Execute data mining projects, training and deploying models over a typical duration of 2 -12 months.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The ideal candidate should be able to innovate, analyze the customer requirement, develop a solution in the time box of the project plan, execute and deploy the solution.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Integrate the data mining projects embedded data mining applications in the FogHorn platform (on Docker or Android).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Core Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Candidates must meet ALL of the following qualifications:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have analyzed, trained and deployed at least three data mining models in the past. If the candidate did not directly deploy their own models, they will have worked with others who have put their models into production. The models should have been validated as robust over at least an initial time period.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Three years of industry work experience, developing data mining models which were deployed and used.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Programming experience in Python is core using data mining related libraries like Scikit-Learn. Other relevant Python mining libraries include NumPy, SciPy and Pandas.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Data mining algorithm experience in at least 3 algorithms within any of the bullets below:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "deep learning (TensorFlow, Convolutional Neural Nets (CNN) or related),",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "prediction (statistical regression, neural nets, deep learning, decision trees, SVM, ensembles),",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "clustering (k-means, DBSCAN or other) or Bayesian networks",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bonus Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Any of the following extra qualifications will make a candidate more competitive:",
