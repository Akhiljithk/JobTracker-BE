          },
          {
            "domain": "default",
            "utterance": "SPNS (Service Provider Networking Systems) is a multi-billion dollar business that generates its revenue primarily from the service provider Edge, Core & optical markets. SPNS organization in India is responsible for development of High End Routers like ASR9000, CRS, NCS5500, NCS500 series and Optical Switches like NCS4000 and NCS2000 series. Exciting career opportunities open for Experienced Software/Platform Test Engineer in India",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Role Expectations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Delivering outstanding quality SW to customers – achieved through strong automated test suites and knowledge on deployment and solution offerings.",
            "intent": "job_description"
