            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "VividCloud is immediately hiring a full-time, permanent, full-benefit, Java Software developers at all levels from JR to SR level.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are located in Brunswick, ME and will consider remote candidates in ME, NH and MA. Candidates outside of these regions will not be considered at this time.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "*We have NOT been slowed down from the recent COVID-19 virus, we are actually expanding and growing. *",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "*WE OFFER HEALTH INSURANCE STARTING ON YOUR FIRST DAY OF HIRE!*",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "*We offer very competitive wages *",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "VividCloud is a fast-growing software services company with a focus on helping clients digitally transform their products and businesses using the AWS cloud technology stack. Our engineering teams are 100% US-based with our first engineering center in Brunswick, ME. We focus on applications in Medical, Industrial, Consumer Devices, Automotive, and Financial industries.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Software is the engine of the 21st-century economy. We are creating nationally strategic software jobs *here,* in the US.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for key contributors for very interesting development projects involving the transformation of multiple software systems to cutting-edge cloud technologies. \\*This role requires strong Java and JavaScript skills and a solid understanding of building and deploying microservices. Candidate must have been a Full Stack Developer in the past. Hands-on coding across all tiers is preferred.\\*",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\*No visa sponsorship is available for this job.\\**",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\*Responsibilities and Duties\\**",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* Design and develop highly scalable production level code using Java and JavaScript",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* Implement core REST + JSON based APIs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* Develop native AWS cloud applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* Participate in design discussions and ensure designs are aligned with architecture and roadmap",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* Work closely alongside other developers and QA engineers using the Agile software development lifecycle",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* Work in a dynamic, changing environment using continuous integration and a dev-ops model to rapidly develop, test, and deploy code into production",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* Research and recommend relevant technologies toward overall technical strategy",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\*Qualifications and Skills\\**",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* Bachelor's degree in Computer Science, Engineering, or related discipline",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* 2-8 years of professional software development experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* 2-4 years of in-depth development experience with Java/J2EE",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* 1-4 years performing object-oriented design and building backend applications with REST API services using Java and Node.js",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "\\* 3+ years of solid experience with SQL and NoSQL based solutions",
            "intent": "job_description"
          },
          {
