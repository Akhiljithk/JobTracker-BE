            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Jump Trading launched our India office in 2019, expanding our footprint in the dynamic Asia market. Working in the India office has the feel of a small start-up with the benefits of being part of one of the leading quantitative trading firms in the World. As part of the elite Asia team, you will work collaboratively with colleagues of diverse backgrounds, all focused on creating innovative solutions that position the firm for the future.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a global company, Jump has equipment in over 50 locations worldwide in a variety of facilities ranging from co-location sites to fully self-managed Data Centers. The individual in this role will be part of the team responsible for the implementation of data networks, not only in new locations but expansions and re-models on a global scale. More specifically, this uniquely structured role will manage the deployment of technology equipment throughout the firms Data Center sites.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What you'll do:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Project delivery on infrastructure implementation and optimization for proprietary low latency trading systems",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Utilize monitoring tools and take an automated data driven approach to locate, diagnose and resolve infrastructure (Datacenter, Network, Server, Telecom) related issues",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Communicate impact of infrastructure related issues to traders, developers and other business resources",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Leverage automation skills and take a \"DevOps\" approach to improve efficiency of solving complex infrastructure issues, management, and maintenance of trading applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Other duties as assigned or needed",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Skills you'll need:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor's Degree (preferably in Information Technology)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Previous experience demonstrating strategic thinking skills and maturity in tackling complex problems, dealing with people, technology and processes",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "5+ years of experience in infrastructure (Datacenter, Network, Server, Telecom)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in building, supporting, and optimizing large scale global infrastructure environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience planning for space, power, and structure cabling within data center environments.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience working with telecommunication providers. Plan, procure, and implement telecommunication circuits",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong interpersonal skills and excellent communicator",
            "intent": "job_description"
          },
