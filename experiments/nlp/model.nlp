          },
          {
            "domain": "default",
            "utterance": "If you are an enthusiastic person wanting to learn and explore the various possibilities and magic you can create using WordPress, come to join our team of WordPress Developers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Brainstorm Force is currently building WordPress themes & plugins that are available publicly for downloading as products. As a WordPress Developer, you will be working with a knowledgeable and dedicated team known for world-class products like Astra, the Ultimate Addons for Visual Composer, the iMedica theme, ConvertPlus and more.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Roles and responsibilities",
