          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Job Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "If you have serious experience with building and running high-performing corporate applications and infrastructure, then we want you to be the new Senior Azure DevOps Engineer who will help our clients leverage Microsoft Azure to migrate, build, and run enterprise applications in the cloud.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will help our clients improve their efficiency and effectiveness using modern technologies and techniques. You will take our customers to the next level of velocity and agility by implementing the principles of CI/CD and Infrastructure as Code.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for someone who is passionate about using cloud technology to solve business challenges and relishes in developing solutions that are truly solutions. Keeping our skills cutting edge is a must, and part of your role will be to share the same education and enthusiasm that you give our clients with our internal teams. Curiosity, confidence, and a holistic application of technical skills to business problems are your hallmark!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Plan, analyze, design, and deploy enterprise scale Azure infrastructure & Application delivery solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Review and manage technical requirements and business functional requirements for establishing new Azure platforms",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provide input to improve scalability and reliability of infrastructure & Application delivery to our clients",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design, build and support advanced cloud automation workflows and tools used to support automated CI/CD pipeline application deployments into Azure",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provide guidance and direction to client teams regarding DevOps processes and technical pipeline standards",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required Experience:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2+ years implementing and administrating Azure DevOps organizations, pipelines, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3+ years Application Development/Modernization or System Administration and engineering experience (Linux or Windows operating systems; experience with mixed environments a plus)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3+ years experience with infrastructure automation tools (Terraform, Kubernetes, Ansible, etc)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledgeable with internet architectures, including web, application, and database components",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of infrastructure automation, configuration management, developer workflows and practices",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong practical Linux and Windows-based systems administration skills in a Cloud or Virtualized environment preferred",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of modern technology service architectural hosting, security, and risk management concerns such as IAM, access control, monitoring, IaaS/PaaS/SaaS, and containers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Thorough understanding of configuration management concepts",
            "intent": "job_description"
          },
          {
            "domain": "default",
