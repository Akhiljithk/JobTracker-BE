      ],
      [
        "en",
        "Dynamic IP Routing protocols (OSPF, ISIS, EIGRP, BGP, PIM Multicast)"
      ],
      [
        "en",
        "Experience on latest hardware and operating systems (Arista EOS, CRS, Nexus, IOS-XR, NX-OS, Junos)"
      ],
