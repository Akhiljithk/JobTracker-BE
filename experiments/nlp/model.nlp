          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Company Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "KlearNow is an exciting new company providing an innovative state of the art solutions that brings the global supply chain into the digital age. KlearNow is funded by serial entrepreneurs with proven track record and sizable exits already. We are now building our initial team post the founders and are looking for exceptional talent to join us.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Get in on the ground floor of a startup company with a new product offering that is changing the way technology is leveraged in the global supply chain. We are looking for is an experienced DevOps engineer with a passion for systems automation. You will be responsible for managing innovation in our software release processes, increase the robustness and automation. In this role, you will help bring significant gains to how we build and deploy software, all towards the end- goal of achieving releases that are swift, predictable and of the highest quality.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience and responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Participate in all aspects of the builds, integration, deployment, merging, tools used and automation for our cloud environments",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Troubleshooting and solve issues relating to mission critical services across the entire stack",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build robust monitoring for production systems with Nagios, collectd, Prometheus, and Grafana",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop automation and monitoring tools to help prevent problem recurrence",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Define metrics and build systems to measure performance and scale, highlighting the biggest bottlenecks",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Craft load tests that prepare our services for large volume of active users",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Support internal and customer external SLA’s",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Serve as an escalation point for any product issues and ability to be on-call duties to provide 24x7x365 services",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Define and own appropriate compliance audits and reports",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Comfortable with continuous integration concepts and tools",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provide reporting that provides appropriate context to multiple audiences including product owners, engineering, and sales teams",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2+ years / 5+ years (Senior Role) of experience “doing” DevOps, including working at large scale with real, highly concurrent, user traffic across multiple data centers and regions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience supporting production traffic on AWS or another cloud PaaS",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent Linux system administration and automation skills (Ruby, Python, Bash etc.)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with firewalls and network security technologies at scale",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Passion for implementing best practices with a focus on rapid growth",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Solid hands on skills with at least 50% (75% senior role) of the following:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Servers: Apache, Nginx, Varnish, Memcached, Aerospike, ElasticSearch, Cassandra, RocksDB",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Databases: MySQL, PostgreSQL",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Automation tools: Ansible, Puppet, Chef, SaltStack or Terraform",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Frameworks & tools: Nagios, Docker, Vagrant, Network Analysis Tools",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "AWS APIs and CLI Tools, EC2 Autoscaling, RDS, S3, Route53",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "5+ years’ experience with developing and delivering configuration and deployment automation using configuration automation tools",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to solve mission critical services issues and build automation to proactively detect and prevent their re-occurrences",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with firewalls and network security technologies at scale",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with Agile methodologies and working in a fast-paced small startup",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent written and oral communication skills",
