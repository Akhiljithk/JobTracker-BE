            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Familiarity with SQL/ MySQL databases and and related technologies like Javascript, Jquery, Ajax, JSON, Laravel, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient understanding of code versioning tools.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent command in PHP, mySQL",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Type: Full-time",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Salary: ₹10,000.00 - ₹25,000.00 per month",
            "intent": "job_description"
          },
          {
            "domain": "default",
