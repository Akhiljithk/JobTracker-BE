            "utterance": "Software Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "To get the best candidate experience, please consider applying for a maximum of 3 roles within 12 months to ensure you are not duplicating efforts.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Department Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Express Application engineering team is engaged with multiple industry verticals to enable the customers reap the benefits of Unified and Tested, Easy to get started, Continuously maintained and enhanced Applications. These applications provide enhanced business process, digital experience, component library, prebuilt integrations and analytics.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Role Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a strong hands-on Java full stack developer to work on new Products/Applications. Along with the Product and Engineering teams, we expect the person to be involved in developing new Industry Use cases, Web design and Front end development. You’ll be supported by a wealth of technical resources and empowered to showcase your ideas, to drive change and challenge the status quo.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Your Impact:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Success will be measured by the overall performance of the team of product engineering.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to showcase your passion and skills in product engineering",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to understand and translate the requirements into product design.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Contribute to the design and architecture to enable secure, scalable, and maintainable software products.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Code, test, debug, and documents software, and enhance existing components to ensure that software meets business needs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop test strategies, design automation frameworks, write unit/functional tests to drive up code coverage and automation metrics",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Mentor others in development technologies, tools, and processes",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Minimum Requirements:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "5+ years of full Software Development Life Cycle experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3+ years of experience working as a full stack developer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience or familiarity with technologies such as Core Java/J2EE,Hibernate, Spring, REST and/or SOAP web services, XML, JBoss, Adobe CQ5 DAM, Node JS, Angular/React JS, Bootstrap, Git",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Expertise in client side technologies like JS, CSS3, HTML5",
            "intent": "job_description"
          },
          {
            "domain": "default",
