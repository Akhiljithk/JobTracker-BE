          },
          {
            "domain": "default",
            "utterance": "Uline is proud to operate as a drug-free workplace. All new hires must complete a pre-employment drug screening.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Position Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and develop multitier web applications for customers and internal users using ASP.NET, MVC, SQL, JavaScript frameworks and jQuery.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Enhance and support e-commerce and mobile sites as well as sales, intranet and web applications that support business activities.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design, develop, maintain and enhance systems based on business requirements using approved technologies and coding standards.",
            "intent": "job_description"
