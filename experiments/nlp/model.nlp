            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience assisting with design, coding benchmark testing, debugging and documentation of programs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience working with multiple phases of software systems programming applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience working with multiple programming languages",
            "intent": "job_description"
          },
          {
