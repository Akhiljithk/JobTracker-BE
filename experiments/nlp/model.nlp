            "utterance": "Software Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Join us as a Software Engineer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In your new role, you’ll engineer and maintain innovative, customer centric, high performance, secure and robust solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We’ll look to you to design and engineer software focusing on the customer or user experience as the primary objective",
