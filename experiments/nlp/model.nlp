            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong Linux Shell (all utilities) and scripting",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Trading industry experience would be highly preferred",
