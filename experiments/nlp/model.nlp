          {
            "domain": "default",
            "utterance": "Job Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for an experienced Data Scientist having excellent working knowledge of NLP & deep learning frameworks. He/She should be keen to collaborate with product and engineering heads using notebooks and visualizations. He/she should ask right questions, connect the dots and uncover hidden potential of data.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Work as the lead data strategist, identifying and integrating new datasets that can be leveraged through the product capabilities and work closely with the engineering team to strategize and execute the development of data products",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Develop advanced algorithms that solve problems of large dimensionality in a computationally efficient and statistically effective manner",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Execute application of statistical and data mining techniques (e.g. hypothesis testing, machine learning and retrieval processes) on large, unstructured data sets to identify trends, figures and other relevant information",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Evaluate emerging datasets and technologies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Own development of select assets/accelerators that create scale",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Mandatory skillset:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Deep understanding and experience with Python libraries - Pandas and Numpy in regards to Large dataset processing and Linear Algebra respectively",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Excellent understanding of Statistics & Probability using Python",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Ability to write, debug and resolve issues in complex SQL scripts",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Good experience with at least one NLP library - Spacy, Gensim, NLTK",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Good understanding of NLP concepts - Stemming, Lemmatization, NER, TF-IDF, WordNet, Bag of words, Rule based NLP vs Statistical NLP, current challenges in NLP",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Good experience with at least one Notebook - Jupyter, Google Collab, AWS sagemaker and comfortable with visualization using matplotlib, seaborn",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Exposure to Scikit based machine learning models",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Experience with Feature Engineering concepts - Feature Selection, Feature transformation, Feature extraction",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Experience with AWS services; Conceptual understanding of AWS Lambda",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Experience with distributed training, MLOps - model.joblib, pkl, model deployment, awareness of approach towards shipping trained model to production",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Conceptual understanding/POC of Deep learning basics - Neural networks, Tensorflow/Keras, Classification, Regression",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Optional Skillset:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Transfer Learning using BERT",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Experience with Data warehouse like AWS Redshift, Snowflake, Google Bigquery",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "deep learning frameworks, Scripting, NLP libraries, Testing, Python, Algorithms, aws, SQL",
            "intent": "job_description"
          },
