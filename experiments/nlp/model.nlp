      ],
      [
        "en",
        "-Diagnose complex issues affecting performance and scaling."
      ],
      [
        "en",
        "-Review,monitoring and setup alerts for all the various services."
      ],
      [
        "en",
        "-Help with cost optimization of infrastructure."
      ],
      [
        "en",
        "-Work with terabytes of data."
      ],
