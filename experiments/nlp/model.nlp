          {
            "domain": "default",
            "utterance": "Job Summary",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "SetBlue is looking for an experienced WordPress and WooCommerce developer to join our team of dedicated employees. A candidate with a positive attitude and dedication towards work is highly preferred. Should be able to manage work under pressure.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities and Duties",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop the Website which is fully functional and responsive.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Should have knowledge of PHP, MySQL, XHTML, CSS and JavaScript, WooCommerce.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Theme/Template integration",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Building WordPress/WooCommerce websites using the best practice & de-facto standard plugins.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience working with WordPress at a PHP code level.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of existing inbuilt WordPress functions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Creation of plugins/widgets written to conform with the WordPress coding standards.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Creation of clean, logical, well-documented and re-usable code.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good understanding of cross-platform and cross-browser issues.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Deep understanding of WordPress architecture, developing themes and custom plugins.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in creating, building and working with APIs.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required Experience and Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good knowledge of Plugins, Themes and Shortcodes.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Comfortable developing own shortcodes, plugins if required.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build websites, prototypes and applications using the latest frontend technologies.",
            "intent": "job_description"
