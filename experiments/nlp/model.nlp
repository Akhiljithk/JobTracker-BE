          },
          {
            "domain": "default",
            "utterance": "The mission of the DevOps team is to build and operate data centers containing up to thousands of servers across several continents. Members of the DevOps team support the application development teams, working directly with them using scrum methodologies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The team is responsible for the building and maintenance of data centers, monitoring services development, platform integration and management, capacity planning, release management, application and development support, network support and troubleshooting.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a member of the DevOps team you must be able to ask the right questions, understand the business and technical requirements of internal and external clients, and then translate those needs into actionable items for execution in conjunction with other cross-functional team members.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Ensure the operational integrity of the global infrastructure using well controlled processes",
            "intent": "job_description"
