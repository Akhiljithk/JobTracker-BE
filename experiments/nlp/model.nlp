      ],
      [
        "en",
        "Ensuring integration and submission of solution into software configuration management system, within committed delivery timelines."
      ],
      [
        "en",
        "Performing regular technical coordination / review with partners and ensuring timely reporting and blocking issues if any."
      ],
      [
        "en",
        "Takes strong initiatives and highly result oriented"
      ],
      [
        "en",
        "Good at presenting within the team as well as with all the partners"
      ],
      [
        "en",
        "Strong customer focus and good learner."
      ],
      [
        "en",
        "Highly proactive and excellent teammate"
      ],
      [
        "en",
        "We don’t need superheroes, just super minds"
      ],
      [
        "en",
        "You must have BE / B.Tech / MCA / ME / M.Tech qualification with 4 years of confirmed ability?"
      ],
