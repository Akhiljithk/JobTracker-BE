            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· · Excellent problem solving skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· · Possess an extremely sound understanding of areas in the basic areas of Computer Science such as Algorithms, Data Structures, Object Oriented Design, Databases.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· · Be able to write Amazon quality code in an object oriented language - preferably in C/C++/Java in a Linux environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· · Candidate must have good written and oral communication skills, be a fast learner and have the ability to adapt quickly to a fast-paced development environment.",
