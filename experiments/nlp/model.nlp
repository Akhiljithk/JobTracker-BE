            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a Data Scientist that will help us discover the information hidden in vast amounts of data, and help us make smarter decisions to deliver even better products. Your primary focus will be in applying data mining techniques, doing statistical analysis, and building high quality prediction systems integrated with our products.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Selecting features, building and optimizing classifiers using machine learning techniques.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Data mining using state-of-the-art methods.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Extending company’s data with third party sources of information when needed.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Enhancing data collection procedures to include information that is relevant for building analytic systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Processing, cleansing, and verifying the integrity of data used for analysis.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Doing ad-hoc analysis and presenting results in a clear manner.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Creating automated anomaly detection systems and constant tracking of its performance.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required Skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Excellent understanding of machine learning techniques and algorithms, such as k-NN, Naive Bayes, SVM, Decision Forests, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience with common data science toolkits, such as R, Perl, Python, SparkML, Weka, NumPy, MatLab, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience with data visualization tools, such as D3.js, GGplot, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Proficiency in using query languages such as SQL, Hive, Pig.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience with NoSQL databases, such as MongoDB, Cassandra, HBase.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience with Hadoop or similar distributed computing and storage platforms.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Good applied statistics skills, such as distributions, statistical testing, regression, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Good scripting and programming skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Exceptional analytical abilities,creativity and attention to details.",
            "intent": "job_description"
