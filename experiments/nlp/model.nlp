          {
            "domain": "default",
            "utterance": "Software Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Company Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "IncubXperts is IT Products and Services company founded in 2016. We focus on building Web solutions for Enterprises and Independent Software Vendors or Product companies. We optimize cloud costs, build migration plan and build or maintain your existing Web/Mobile products.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are a domain agnostic software technology company. Our founders come with an experience of about 20+ years in the software industry. Our primarily work area is Enterprise Web and Mobile solutions that are built on cloud. Azure AI using Cognitive services, Enterprise BOTs are other areas where we have built solutions to help our customers. Using technology that is latest we intend to solve business problems for our customers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Know More at http://incubxperts.com/",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "An Intern at IncubXperts will be put on “LIVE” project. He/She will be expected to learn in the live environment, build software applications under guidance of leadership that carries multiple years of experience.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Please note that an Internship will be split into 2 phases (3 months + 3 months). Initial 3 months performance will be assessed and if performance is good, internship will extend by additional 3 months. At the end of Internship, suitable candidates will be extended an invitation to join IncubXperts.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Technology/Skills: Angular 2+, .NET Core or .NET MVC, MS SQL Server, Azure (Some experience in these technologies is preferred for Interns but not must)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Final Year or Graduate from BE / B.Tech / BCA / MCA or equivalent disciplines.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to learn faster, demonstrate ownership, and one who possess good technology skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Additional Information",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "People with ownership grow at IncubXperts. Most of our customers have less or no in house developers. This means a lot of learning opportunities and massive upgrade to the skills every passing year.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Latest technology, many projects – no stagnancy (unlike large companies where one ends up spending multiple years in single project)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with leadership that carries 20 years of exp. Maturity of big company and culture of small company. Grow fast! Since inception, we double our size every year.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Software Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "We're looking for a seasoned software engineer who would work on next generation technologies that touch millions of customers world-wide.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We're a team of 5,000 ambitious, curious people building marketplace platforms that make it super easy for anyone to buy and sell almost anything, boosting local economies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What you will be doing:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will be writing high-quality code using object oriented principles with 100% unit and integration tests.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will be Translating high level business problems into scalable design and code. Creating libraries for larger consumption, define APIs and own end to end services.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Mentoring junior engineers while optimizing application architectures for Docker/Kubernetes/AWS and using micro-services best practices (logging, metrics, database etc)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will ensure platform and application readiness in terms of capacity, performance, monitoring and stability.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will influence product requirements and operational plans. Instill best practices for development and champion their adoption, while working with product manager to estimate and plan projects in agile development framework.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Who we're looking for:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A strong technologist at OLX cares about code modularity, scalability and reusability as the problems we solve today become the foundation for and thrives ambiguous environment, rapidly changing environment, continuously adapting and bringing newer solutions. An ideal candidate should",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have deep expertise in Object Oriented design principles using any modern language preferably Java.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have experience in building and maintaining large scale web applications in service oriented architecture.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of design patterns, and an uncanny ability to design intuitive module and class ­level interfaces with experience in data model designing in SQL/NOSQLs.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have knowledge of at least one of the databases like MySQL, Postgresql or Oracle and one of the NOSQLs like DynamoDB, MongoDB, Cassandra, Aerospike etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What we'll give you:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A thrill of building and managing global products that is used daily by millions world over.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Learning is not just on the job, but we have dedicated training budgets to upskill our engineers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Global Product and Tech culture. With 5 technology centers world over collaborating together, the experience and learning increased manifold.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Openness and Ownership. You build, you deploy and you manage. 360 degree view of entire product development process.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Great peers and teams. With people joining us from Amazon, Google, Snapdeal & other top start-ups in India and top companies across the globe , we have a great team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What you need to know about us:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At OLX Group we have a clear ambition – to empower millions of people across the globe by helping them connect and share their goods and services. This inspiring purpose has helped us build one of the world's leading Internet companies. This combination of business and purpose attracts a certain type of person. If you've got an entrepreneurial drive and think you can use that drive to contribute to our purpose, then we'd love to empower you to be successful.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "OLX is a part of the OLX Group, a global product and tech company with 17 brands, +40 countries, +5000",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "people and one mindset.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our mission is to make it super easy for people to buy and sell almost anything, boosting local economies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are proud to be different, and we work differently too. We combine the spirit and agility of a start-up",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "with the maturity that comes from being part of a 100-year-old company.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are curious, ambitious and allergic to corporate interference. We improvise, experiment and push",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "each other further, embracing uncertainty and driving change.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "JavaScript Developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Job ID: 96647",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Who are we?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "If you’re a smartphone user then you are part of an ever more connected and digital world. At Amdocs, we are leading the digital revolution into the future. From virtualized telecommunications networks, Big Data and Internet of Things to mobile financial services, billing and operational support systems, we are continually evolving our business to help you become more connected. We make sure that when you watch a video on YouTube, message friends on Snapchat or send your images on Instagram, you get great service anytime, anywhere, and on any device. We are at the heart of the telecommunications industry working with giants such as AT&T, Vodafone, Telstra and Telefonica, helping them create an amazing new world for you where technology is being used in amazing new ways every single day.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In one sentence",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsible for design, development, modification, debug and/or maintenance of software systems",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "All you need is...",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelors Degree in Computer Science or equivalent.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Total Experience: 2 to 5 yrs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Expert knowledge of JavaScript ES6, React/Redux,TypeScripting, HTML5, WCMS, AEM, Webpack etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "JavaScript based Mobile UI framework knowledge e.g. jQuery Mobile",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge in CSS extension frameworks, e.g. SASS, LESS, COMPASS",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good knowledge in Object Oriented Design and development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Solid web apps design, coding, testing and debugging skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What will your job look like?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• You will design, develop, modify, debug and/or maintain software code according to functional, non-functional and technical design specifications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• You will follow Amdocs software engineering standards, applicable software development methodology and release processes, to ensure code is maintainable, scalable, and supportable, and demo the software products to stakeholders.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• You will investigate issues by reviewing/debugging code, provide fixes and workarounds, and review changes for operability to maintain existing software solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• You will work within a team, collaborate and add value through participation in peer code reviews, provide comments and suggestions, and work with cross functional teams to achieve goals.",
            "intent": "job_description"
