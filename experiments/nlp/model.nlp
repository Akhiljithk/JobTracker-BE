            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop tools and utilities using C# and MS-SQL.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Test and peer review code for technical accuracy, standards, and functional compliance to the design.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrate excellent written and verbal communication skills, good visual design sense, an understanding of usability principles, and the willingness to learn and understand user experience and workflow.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Display great attitude and ability to thrive in a fast-paced, high pressure, agile environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work independently and in tandem with other development team members with various skills and backgrounds.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage multiple priorities and projects, taking initiative and solving problems creatively and positively.",
