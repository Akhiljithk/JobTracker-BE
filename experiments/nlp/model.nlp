          },
          {
            "domain": "default",
            "utterance": "To ensure success as an iOS Developer, you should have a strong working knowledge of iOS Frameworks, be proficient in Swift, and be able to work as part of a team. Ultimately, an outstanding iOS Developer should be able to create functional, attractive applications that perfectly meet the needs of the user.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
