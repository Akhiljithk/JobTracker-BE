            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "4. Familiarity with RESTful APIs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "5. Knowledge of modern authorization mechanisms, such as JSON Web Token 6. Familiarity with modern front-end build pipelines and tools",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "7. Experience with common front-end development tools such as Babel, Webpack, NPM, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
