          },
          {
            "domain": "default",
            "utterance": "Software Engineer – SI Search and Lookup",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Location: Hyderabad",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Department: Systems Infrastructure",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The SI - Search and Lookup Group is seeking a motivated engineer to work on the search and lookup systems within Factset. This position provides the opportunity to work and develop the typeahead, search and lookup capabilities for the new workstation and the web.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The responsibilities involve working with Application and Content Product Developers as well as other engineering teams to ensure that searching within Factset products is simple, fast and intuitive.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You would have the opportunity to work on improving the search algorithm by improving relevancy, scoring, learning, prediction and analysis processes within the Factsearch, Formula search and typeahead systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The team also owns the Identifier Lookup 4 and Series Lookup backends, which allows you to filter results based on your requirements.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In addition, by being part of systems that are embedded in various other applications, there will be a broad exposure to FactSet business practices and products. This provides more opportunities to develop individual financial asset knowledge and technical engineering skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "50% Learning & Training: Participate in training, execute on labs effectively and learn the processes and technologies used in house Proficiency with the tools, libraries and languages used in development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "40% Develop, test and deploy software Additional features and/or content is released to solution end users",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "10% Communicate and collaborate with product developers, direct manager and engineering peers to develop the correct solutions Effective project planning and development of expected solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required Skills:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Has an undergraduate degree in Computer Science or equivalent training",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to develop software in the required languages and using required 3rd party tools, applications and libraries where needed.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to learn and apply internal systems and processes for developing and deploying software",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to communicate effectively with peers within the organization",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Nice to Haves:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in programming with Perl and Python.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in working with web services.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Some experience with programming in C++.",
            "intent": "job_description"
          },
