        "Requirements"
      ],
      [
        "en",
        "At least 3 years of experience in a similar role."
      ],
      [
        "en",
        "Design, operation, and maintenance of robust, large-scale distributed systems"
      ],
      [
        "en",
        "Experience in Linux Environment."
      ],
      [
        "en",
        "Good understanding and practical experience with configuration management (e.g."
      ],
      [
        "en",
        "Ansible, Chef, and Puppet) and Infrastructure as Code such as Terraform."
      ],
      [
