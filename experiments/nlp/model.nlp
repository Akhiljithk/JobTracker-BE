            "domain": "default",
            "utterance": "Java Developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Infosys is seeking Lead Java Full stack Developer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "This position’s primary responsibility will be to anchor for different phases of the engagement including business process consulting, problem definition, discovery, solution generation, design, development, deployment and validation; guide teams on project processes and deliverables; contribute to effort estimation, client training. The chosen candidate will play an important role in the development, configuration and deployment of the overall solution with an opportunity to shape value-adding consulting solutions that enable our clients to meet the changing needs of the global landscape.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Bachelor’s degree or foreign equivalent required from an accredited institution. Will also consider three years of progressive experience in the specialty in lieu of every year of education.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• At least 4 years of experience with Information Technologies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Candidate must be located within commuting distance of Phoenix, AZ or be willing to relocate to the area. This position may require travel to project locations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• U.S. citizens and those authorized to work in the U.S. are encouraged to apply. We are unable to sponsor at this time.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience in J2EE technologies with Springboot and Micro services",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Preferred Skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• At least 5 years of relevant experience in development in following technologies:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Java 1.8+, Spring Framework, Spring Batch, Spring Boot or DropWizard, Restful Services (JAX-RS), REST and SOAP API, Java Testing Frameworks(JUnit, Mockito, PowerMockito), Relational DB (preferably Oracle), Microservices, Git, Jenkins, Understanding of Cloud infrastructure, JPA/JDBI or Mybatis, ReactJS/AngularJS, Openshift, ORM Framework, Schedulers, Devops, Splunk, Appdynamics/Grafana.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Additionally knowledge of following technologies would be an advantage:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Docker Framework, Document Based DBs – Cassandra, Couchbase or Mongo, Redis DB, SonarQube, Kafka, Loadrunner, Jira, Confluence, Cucumber, Kubernetes (or similar technology), ELK Integration (Elasticsearch, Logstash & Kibana)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• At least 4 years on MVC framework, Spring 4.x/5.x & Design Patterns.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Good knowledge about continuous integration tools e.g. GIT, Jenkins, XLR etc",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Working knowledge on Automation Tools e.g. Selenium, Cucumber etc",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Non-relational database experience e.g. Couchbase or MongoDB",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Relational database experience in db2",
            "intent": "job_description"
          },
