          {
            "domain": "default",
            "utterance": "Software Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Infoblox is seeking a Software Engineer I to join our team in Bangalore. You will be part of our highly successful product portfolio for Telecom Service Providers and ISPs. You will report to the Manager, Software Engineering based in Bangalore.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In this role, you will have an opportunity to work on NFVs, cloud technologies, customer requirements, and feature development of existing products. You will develop firmware as well as drivers for the Infoblox DNS platforms.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop software for DDI, security products, and NFV implementations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Execute fast-path packet processing development at the embedded level",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Carry out firmware and driver development for the DNS and security platforms",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop hardware abstraction layers and APIs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Execute kernel and platform related implementation",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure performance optimizations and bug fixes",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design, document, implement, and unit-test firmware and drivers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with QA and manufacturing team to help ensure a high-quality product",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Support the sustaining engineering team for any customer escalations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3+ years of hands-on experience in software development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Minimum of 2 years experience in embedded firmware development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong C/C++ programming skills in Linux or UNIX multi-core environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong networking background and hands-on experience in networking software development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In-depth, hands-on network packet processing knowledge and experience with Ethernet, IP, UDP, TCP protocols",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with designing, documenting, and implementing software features in embedded networking products",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with processors such as ARM, Cavium, and PowerPC",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to work in a fast-paced environment and willingness to figure out solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work completely and accurately under time constraints and deadlines",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A four-year degree in CS, CE, EE, or equivalent is required",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Master’s in CS, CE, or EE is preferred",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "It’s an exciting time to be at Infoblox. We are the market leader in technology for network control. Our success depends on bright, energetic, talented people who share a passion for excellence in building the next generation of networking technologies—and having fun along the way. Infoblox offers a fast-paced, action-oriented environment. We promote a culture that embraces innovation, change, teamwork, and strong partnerships. Join the winning Infoblox team—our future looks bright, and so will yours. To check out what it’s like to be a Bloxer, click here.",
            "intent": "job_description"
          },
          {
