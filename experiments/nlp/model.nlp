          {
            "domain": "default",
            "utterance": "iOS Developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Why AirAsia?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Are you ready to take off and be part of the Allstar employee? Whether you’re applying for a developer, customer happiness or crew, at AirAsia we act as One AirAsia.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "AirAsia Software Engineering Team (AASET) is a technology centre that design and create custom-built solutions for the group's airline and digital businesses. It is a global initiative to drive its digital transformation.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The technology centre comprises of a team of software engineering and technology experts based in RedQ and Bangalore, who would work to streamline the airlines digital assets such as its website and mobile app along with creating and implementing new products and enhancements such as the new artificial intelligence (AI)-powered chatbot, among others, for a seamless journey.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "If you are hungry to make a difference with one of the most well known low cost airlines and to work in the dynamic technology hub, this is the job for you.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What You'll Do",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Take care of AirAsia iOS App on a day to day basis",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Help build new customer engagement features which helps other businesses to grow and find prospective customers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Help build ‘write once and use everywhere’ experience for all of the line of businesses under AirAsia",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Help build revamping the existing architecture & implementation",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Mentor and course-correct junior engineers in the team in terms of tech and product roadmap",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Who You Are",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor's degree in CS/CSE. If you have the rest of the points below checked and you got the right attitude - we can consider even if you are coming from different major.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "5+ years of development experience in iOS development and knowledge of building enterprise apps, components and frameworks.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient in Swift, XCode, Experience with Reactive programming is an added advantage",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Published handful of popular apps through App Store, including BETA testing and staged rollouts.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with RESTful JSON APIs, cloud services (Google or AWS), GitHub and you are proficient in TDD.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good if you have prior experience of docker, CI/CD, logging and monitoring",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Team player, looking to be part of a growing team working on the digital transformation of a mid-size and dynamic organisation with a proven leadership team and a mobile-centric user acquisition strategy.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Passionate about building apps that users love.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You are always exploring new technologies and believe in keeping you up to date in terms of latest technology developments.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient in algorithms and problem solving.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understand the challenges faced in building scalable, high performance apps and how to address those issues in the development / deployment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You have a deep respect for the challenges associated with operating a large-scale system in production, and your designs and implementations reflect that understanding.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You have a great attitude and can adapt to change. You stay calm, poised and maintain your great sense of humour even in the face of big challenges.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in ReactNative(if you are willing to learn it once you join, that will also work)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of State management in React apps: Redux, React Hooks",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficiency in any of these frontend frameworks: React, Angular",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Prior start-up experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficiency in any of these technology domains: Travel, Fintech, Security",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What You Care About",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong product focus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong mentorship and learning attitude",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent communication skills in English (written and verbal)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excited to work on a multicultural team spread across global offices",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsible, reliable delivery and follow-through",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What makes you an Allstar employee?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You allow yourself to ‘Dare to Dream’ big dreams and seize the day. You ‘Make things Happen’, you like taking efforts and achieve it. Without any effort, no dream will get fulfilled.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our companies include AirAsia.com, BigPay, Teleport, BigLife, RedBeat Ventures, AirAsia Foundation, Tune Group of Hotels, TuneProtect, OURSHOP, FORM.AT, Airasia Ads",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "AirAsia is committed to creating an inclusive work environment with a diverse workforce. All qualified applicants will receive consideration for employment without regard to race, religion, gender, sexual orientation, national origin, disability or age.",
            "intent": "job_description"
          },
          {
