          },
          {
            "domain": "default",
            "utterance": "Internet Testing Systems (ITS) is seeking for DevOps Engineers to join our team*",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "ITS is a rapidly growing technology company providing cutting edge technology and quality service to the computer-based testing industry. We believe in strong team dynamics, job satisfaction, and making each team member successful. Because of our unique and leading-edge software environment, our employees typically experience a dramatic increase in their skills and knowledge as they work at ITS. We believe that work should be fun, and that a successful company needs to nurture their employees, not burn them out.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Position Summary*",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are seeking candidates who wish to join our team in a challenging and rewarding work environment. You will be a part of a team that encourages growth, focuses on short- and long-term goals and encourages sharing and cross team development. You will be expected to accomplish the following technical tasks:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design, implement and maintain logging and monitoring solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design, implement and maintain alerts and failure detection and prediction solutions (health check)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Building strategies around security and compliance to enforce set governance",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Configuring, integration and maintaining source code repositories",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Maintaining communication with stakeholders, DevOps process documentation",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Define, implement and maintaining continuous delivery and release management (developing deployment scripts, templates, orchestration of automation solution and deployment of per environment decisions etc.,)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Designing and maintaining build automation and related strategies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The DevOps Engineer is responsible for Designing DevOps strategy, development process, implementing continuous integration, implementing continuous delivery and others related to DevOps.",
            "intent": "job_description"
          },
