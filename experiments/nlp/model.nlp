            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Integrate data storage solutions, which may include databases, key-value stores, BLOB stores, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage user authentication and authorization between multiple systems, servers, and environments.",
