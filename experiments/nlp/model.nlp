          },
          {
            "domain": "default",
            "utterance": "Lead projects with minimal supervision",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Produce working proof of concepts to jump-start development",
            "intent": "job_description"
          },
