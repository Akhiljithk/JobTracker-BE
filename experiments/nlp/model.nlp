            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong knowledge of Git version control.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience deploying Python applications into production.",
            "intent": "job_description"
          },
          {
