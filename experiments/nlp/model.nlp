            "utterance": "Independently design and implement framework components in NSX Manager UI.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Act as feature/module owner for features in the NSX Manager UI and deliver high quality of work.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Interact and work with cross functional teams like Product management, API teams, Usability, QA, Documentation and Release Engineering",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborate with other teams during both design and development phases to ensure adherence to UI architectural standards and best practices",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Partner with other architects to continue to drive the development of a modern user interface layer",
