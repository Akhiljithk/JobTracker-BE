          },
          {
            "domain": "default",
            "utterance": "We have offices around the Globe that are open 24/7. Please visit us at www.bbcglobalservices.com",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Summary: *",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Looking for a highly skilled PHP developer to join our team. Minimum 5 years of experience.",
