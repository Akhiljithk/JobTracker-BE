          {
            "domain": "default",
            "utterance": "GSK is one of the worlds foremost pharmaceutical and healthcare companies and we are proud to be leading a healthcare revolution.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "By disrupting our approaches to R&D and commercial business processes, D&A is allowing us to integrate, simplify and unlock all our data to drive innovation, decision making and enable our transformation in servicing our patients, healthcare professionals and consumers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "YOU would be responsible for the following:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrate specialization in AI/ML and Cognitive technology, process automation and process mining.",
