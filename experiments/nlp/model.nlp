            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• U.S. citizens and those authorized to work in the U.S. are encouraged to apply, we are unable to sponsor at this time.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Preferred Full stack Developer Qualifications:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• At least 2 years of experience with React.js, Redux, Node.js, HTML5/CSS3, JavaScript, JQuery, Node.js, AJAX, REST based APIs, git, github, SOAP, SQL/NoSQL, etc.",
