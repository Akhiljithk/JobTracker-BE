          },
          {
            "domain": "default",
            "utterance": "WordPress Support Engineer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Acquia is the open digital experience company. We provide the world's most ambitious brands with products built around Drupal to allow them to embrace innovation and create customer moments that matter. At Acquia, we believe in the power of community and collaboration — giving our customers and partners the freedom to build tomorrow on their terms.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Headquartered in the U.S., we have been named one of North America's fastest growing software companies by Deloitte and Inc. Magazine, rated a leader by the analyst community, named one of the Best Places to Work in India by Great Place to Work. We are Acquia. We are building for the future and we want you to be a part of it!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You get to guide and drive technical application design for one of Acquia's most tenured clients. This client has a sophisticated Wordpress footprint and requires a support engineer to assist in their continued success.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Requirements:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In this role your expertise and craftsmanship will shape the next generation of leveraged site management and managed hosting of a Wordpress application. If you are interested in microservices architecture and are compelled to evolve to the next level on a product that is critical to Acquia's success, this is your opportunity!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Basic Qualifications:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Detailed knowledge of WordPress, PHP and MySQL (this is not an entry-level position)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong JavaScript, HTML and CSS skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experienced in troubleshooting and supporting sophisticated WordPress sites",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of hosting environments, domains and DNS",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Comfortable with working in a fast-paced, technical support environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have a positive demeanor and are comfortable working independently and as a member of a hardworking team",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have outstanding written and verbal communication skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Passion for the web, open source development, and overall client success",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong problem-solving abilities, initiative, and are comfortable performing under pressure",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good knowledge of WordPress security features, plug-ins and know-how to secure WordPress Enterprise sites.",
            "intent": "job_description"
