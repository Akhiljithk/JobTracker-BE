            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Note: Submit your resume in PDF format only.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are excited about making new innovation and breakthrough in the payment industry. In Asia, we are among the very few mobile POS recognised by global payment networks and bank. In the B2B payment space, we are the first to deliver enhanced data across Asia-Pacific.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "With our accelerated growth and continual streams of opportunities, there is no shortage of challenges and problems to solve. We leverage the best of breed technologies to achieve security, scalability, availability and maintainability. We are agile, lean, pragmatic, and resourceful.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Present in Singapore, Malaysia, Thailand and Indonesia, we expect more offices in more countries to come. Join us in this exciting time to shape payment in Asia Pacific.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Short version:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a DevOps Engineer, you have to be a jack of all trade!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Long version:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a DevOps Engineer, you will work with our development team, operation team and support team to continuously innovate and improve our systems. You will ensure that systems are delivered and operated continuously.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You are expected to",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with teams across different locations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Participate in team tasks covering development and operations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provide input to design and architecture solution",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Follow and improve development and operational processes and standards",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure security, delivery, quality and uptime",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Learn continuously",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Innovate ceaselessly",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Fresh graduates welcome to apply. We select based on merit.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "But most important qualification is willingness to learn.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Technical Skills and knowledge:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of Java or C# .NET, PHP technology stack, deployment or willing to learn them quickly",
            "intent": "job_description"
          },
