          {
            "domain": "default",
            "utterance": "JavaScript Developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Job Title: Javascript Developer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Location: Vikhroli west, Mumbai",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Company: Azul Arc India Interactive Pvt Ltd",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Type of Position: Full Time",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Position Summary:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Are you looking for a fast-paced, engaging new challenge? Do you have good communication skills with a pleasant personality and a passion for web technologies? Perfect – we need you! We currently have an opportunity for Open Source Platform Javascript developer preferably in ReactJS and nodeJS with at least 2+ years of experience. This is a great position for a self-motivated driven individual, seeking a high responsibility role with room for growth.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Desired skills and experience:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a ReactJS / Angular Developer, a candidate MUST have knowledge of :",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good Understanding of JS Fundamentals (Inheritance, Object-oriented design, ECMAScript features, promises, callbacks, event handling, etc.)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must be familiar with React/Angular/Vue Js fundamentals",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must have strong Database/SQL fundamentals",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good to have Redux knowledge",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good to have familiarity with SQL/NoSQL databases and their declarative query languages",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Solve complex performance problems and architectural challenges",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient understanding of code versioning tools, such as Git",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2 – 3 yrs of relevant experience is preferred.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good to have working knowledge in Agile Methodology.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop, record and maintain cutting edge web-based PHP applications on portal",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build innovative, state-of-the-art applications and collaborate with the User Experience (UX) team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding business requirements and creating customer workflows.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure HTML, CSS, and shared JavaScript is valid and consistent across applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Prepare and maintain all applications utilizing standard development tools",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Utilize backend data services and contribute to increase existing data services API",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Lead the entire web application development life cycle right from concept stage to delivery and post-launch support",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Refactor, optimize and improve the existing codebase for maintenance and scale",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Use test-driven development and acceptance tests to ensure feature quality",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Interface with customer and internal teams to gather requirements and develop software solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Convey effectively with all task progress, evaluations, suggestions, schedules along with technical and process issues",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Document the development process, architecture, and standard components",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Coordinate with co-developers and keeps project manager well informed of the status of development effort and serves as a liaison between development staff and project manager",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Keep abreast of new trends and best practices in web development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required Documents:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Now a little about us:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Azul Arc is an award-winning digital design and development company with a soft spot for good food and good people. We’ve been in the business of generating excellent products and repeat clients since 2005. We build technologies that build a business!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our team combines creative, UI and strategy expertise in Atlanta with programming development in Mumbai to give you the perfect technology solution. Over the past decade, we’ve expanded our small team of developers to a group of over 50 multidisciplinary experts.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our specialty? Customer-facing applications. Whether it’s a custom web application, mobile app or a website, we’re passionate about using technology to simplify the connection between you and your most important stakeholders.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our philosophy? If it’s not easy to use or implement, we’re not doing it right. Watching our clients succeed is why we do this every day.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our culture? We are one team. We’re proud of our diversity and believe that we deliver a better product because of it. We’ve adopted a growth mindset approach that’s about learning by doing!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "For information about our company go to www.azularc.com and check out our social pages by searching for Azul Arc (you’ll see more team pictures and what our cool new office looks like).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Oh! One more thing- check out our exciting new business collaboration digital platform that is changing the way companies communicate – www.insite-app.com",
            "intent": "job_description"
          },
          {
