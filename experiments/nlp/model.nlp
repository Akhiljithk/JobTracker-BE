            "utterance": "This is a full-time position. Days and hours of work are Monday through Friday, 8:30 a.m. to 5 p.m. Remote work from home.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Travel is primarily local during the business day, although some out-of-area and overnight travel may be expected.",
            "intent": "job_description"
