            "utterance": "Develop scripts and assist with code changes along with operational tasks/activities.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work closely with Application Development to ensure that the support team has excellent knowledge of the application set own and maintain support knowledgebase and documents",
            "intent": "job_description"
