          {
            "domain": "default",
            "utterance": "Amazon's looking for Data Scientist to optimize one of the most complex logistics systems in the world. Academic and/or practical background in Computer Science, Engineering, Operations Research, or Process Control are particularly relevant for this position. Experience in the integration of model-based engineering tools and/or multidisciplinary analysis & optimization is also a plus.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Major Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Use data analyses and statistical techniques to develop solutions to improve customer experience and to guide business decision making",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Identify predictors and causes of business related problems and implement novel approaches related to forecasting and prediction",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Identify, develop, manage, and execute analyses to uncover areas of opportunity and present written business recommendations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Collaborate with multiple teams as a leader of quantitative analysis and where you develop solutions that utilize the highest standards of analytical rigor and data integrity",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Analyze and solve business problems at their root",
            "intent": "job_description"
          },
