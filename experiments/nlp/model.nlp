            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Information Technology experience working with LAN/WAN routing and switching, load balancing, and network support",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with VPN connectivity for an enterprise organization (site-to-site and remote client access)",
