          },
          {
            "domain": "default",
            "utterance": "Machine Learning",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "At Aera, we deliver the cognitive technology that enables the Self-Driving Enterprise™: a Cognitive Operating System™ that connects you with your business and autonomously orchestrates your operations. Aera's Cognitive OS leverages the best of artificial intelligence, machine learning, natural language processing, big data, and enterprise domain expertise to deliver Cognitive Automation at scale for some of the world's largest companies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Aera Technology is looking for a Machine Learning Engineer to work from our Pune office.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will be responsible for designing, implementing, monitoring and maintaining our machine learning systems that power the Aera platform",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will be working on new and challenging Engineering Problems to operationalize Data Science",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will be working in a highly collaborative environment with other experts in Data Science, Engineering and DevOps teams",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and implement state of the art Machine Learning approaches",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Building core machine learning infrastructure, which includes distributed systems, abstractions, development tools, model hosting /serving/ inference pipelines",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "B.E./B.Tech in Computer Science/Computer Engineering",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3-8 years of experience in software engineering & architecture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At least 2 years of experience in designing and deploying Machine Learning Systems",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong skills with Python",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in working with large data sets and pipelines, distributed systems for machine learning using frameworks such as Apache Spark",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in building Machine Learning models and experience using libraries such as scikit-learn, pandas, tensorflow, keras, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in technologies like Spark, Hadoop, Kafka",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Take end-to-end ownership of Machine Learning systems - from data pipelines and training to the realtime prediction engine",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in setting up Data and ML Pipelines and ML engineering tools like MLFlow, Data Version Control",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in building containerized applications/microservices using Docker and Kubernetes",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in Agile Methodology, CI/CD, Jenkins, GIT & Jira",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Should possess strong problem-solving skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent verbal and written communication skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You take complete ownership of your work and are self-driven",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our Environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "AWS hosted infrastructure",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At Aera, we're on a mission to solve the biggest, most intractable challenges in the world of enterprise software. We envision the rise of the Self-Driving Enterprise: a more autonomously functioning business with a central operating system that connects and orchestrates business operations. Our Cognitive Operating System is increasingly used by the world's largest companies to fundamentally transform their organizations and how work is done.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "If you share our passion for building the next generation of enterprise software, and deploying it for the most sophisticated customers in the world, you’ve met your match. Headquartered in Mountain View, California, we're growing fast, with teams in Mountain View and San Francisco (California), Bucharest and Cluj-Napoca (Romania), Paris (France), Munich (Germany), London (UK), Pune and Bangalore (India), Sydney (Australia) and Singapore. So join us, and let’s build the future of work together!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Software Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Position Title: Software Engineer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The Area: Morningstar® Data for equities provides comprehensive coverage of global stock markets from as early as 1975. We are continuously broadening our coverage and creating new products to help clients prepare for regulatory changes and other industry shifts. Our data features proprietary statistics and is developed using stringent quality screens to ensure accuracy. From APIs to data feeds, our solutions are delivered quickly to help institutions meet a broad range of functions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The Role: In this role, you will collaborate with team leader, scrum Master, data analysts, and developers to build technology solutions for Morningstar`s Equity applications. You should have strong understanding of Core Java, JSP, Spring, SQL, Informatica ETLs, Component based architectures and create scalable, flexible technical solutions. You would support existing systems, study their enterprise complexities and develop/implement better systems with modern software development practices. Developing good understanding of existing systems on other platforms and its database is a beginning step.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design & develop web and enterprise solutions to be flexible, scalable & extensible.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Improve complex data flow, data structures and db design to move to next platform.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Enforce good agile practices like test driven development, Continuous Integration.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Hands-on development will be an integral part of the responsibilities.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop areas of continuous and automated deployment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Introduce and follow good development practices, innovative frameworks and technology solutions that help business move faster.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Follow best practices like estimation, planning, reporting and improvement brought to processes in every day work.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements: These are the most important skills, qualities, etc. that we’d like for this role.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2-4 Years of experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
