          {
            "domain": "default",
            "utterance": "JavaScript Developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Who We Are:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ocrolus is a fintech infrastructure company that transforms documents into actionable data. Powered by Artificial Intelligence and a unique human-in-the-loop data validation process, Ocrolus plugs directly into customer workflows via API, eliminating the need for manual data work. The solution includes built-in fraud detection and analytics, enabling customers to make smarter and faster business decisions with unprecedented precision.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Use-cases include loan underwriting, account openings, invoice processing, and other document-intensive processes. Ocrolus has raised over $30 million in venture capital, backed by Oak HC/FT, FinTech Collective, Bullpen Capital, and QED Investors, among others.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for an exceptionally skilled Lead Front-End Web Engineer with a solid technical background and leadership skills, able work in a fast-paced environment primarily using the latest front-end development practices.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Front-End Developers play a significant role on our engineering team, developing the user facing applications for our company’s products, functional and mobile web applications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Front-End Developers collaborate openly in an Agile Software Development environment with other members of engineering and User Experience disciplines, including Full-Stack Engineers, QA, Interaction Designers and Creative Designers, as well as Program Managers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "They participate in our UI development processes by establishing and documenting development standards and common components for common usage across all of our web applications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "If you are enthusiastic about constantly evolving the world of front-end web and mobile technologies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "If you have expert skill in HTML, CSS, and JavaScript writing standards-compliant code from scratch as well as MVC concepts. If you understand how to support the range of browsers and devices that people may be using.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient in JavaScript",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient in HTML5 / CSS3",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient with Component based development in JavaScript frameworks (React.JS is ideal). Hands-on with TypeScript or Material-UI would be a huge plus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient working in an Agile Software Development environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Familiar with languages such as Java/C#, Python, and Ruby",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor’s Degree in Computer Science or a related field, or 7+ years Front end development and 3+ years team lead level.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent communication skills, ability to work well in a team, project management, and technical leadership experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong customer focus, ownership, urgency and drive",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong portfolio of work showing experience developing standards-compliant front-end code for product and/or marketing websites, web applications, and/or mobile experiences",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient in testing the front-end code for supported browsers and devices",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient demonstrated experience in incorporating reliable unit and end-to-end testing to UI frameworks",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We’re a young and rapidly growing FinTech company - if you have ever wanted to jump on a rocket ship as it’s taking off, now is your chance!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Machine Learning",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a Machine Learning (ML) Engineer to help us create & deploy machine learning solutions. To do this job successfully, you need exceptional skills in programming with a good enough understanding about data science. Your goal will be to build efficient machine-learning pipeline.",
            "intent": "job_description"
