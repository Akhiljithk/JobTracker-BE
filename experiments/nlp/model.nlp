          },
          {
            "domain": "default",
            "utterance": "Who we are: Fueled by a fundamental belief that having access to financial services creates opportunity, PayPal (NASDAQ: PYPL) is committed to democratizing financial services and empowering people and businesses to join and thrive in the global economy. Our open digital payments platform gives PayPal’s 286 million active account holders the confidence to connect and transact in new and powerful ways, whether they are online, on a mobile device, in an app, or in person. Through a combination of technological innovation and strategic partnerships, PayPal creates better ways to manage and move money, and offers choice and flexibility when sending payments, paying or getting paid. Available in more than 200 markets around the world, the PayPal platform, including Braintree, Venmo and Xoom enables consumers and merchants to receive money in more than 100 currencies, withdraw funds in 56 currencies and hold balances in their PayPal accounts in 25 currencies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description Summary: PayPal WorldReady team is looking for a highly talented, self-driven staff full stack web engineer to take on the challenges of WorldReady engineering team. We want people who demonstrates thought leadership, great execution skills and a passion for delivering superior user experiences. As a member of the team, you will directly work with the product owners and designers to create outstanding solutions and deliver incredible products. We are looking for the best Full Stack Web Application engineers in the world, who have a passion for developing massively scalable, distributed software systems that require high availability to support mission-critical business tasks. Quality is at the forefront of everything we do, and we are looking for true craftsmen that are passionate about writing robust, re-usable, scalable, well-tested code.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient in client & server-side JavaScript, HTML5, CSS3, React.js, Redux and webpack",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Competent in developing Node.js applications and building single page web applications using React.js & Redux",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with cross-browser, cross-platform and design constraints on the web",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in developing automated unit and functional tests",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with SEO, page optimizations, CDN, Content Management and the related tools",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in building and using RESTful APIs; exposure to GraphQL is a plus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Well versed with code versioning tools such as Git and CI/CD",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in agile development process",
            "intent": "job_description"
