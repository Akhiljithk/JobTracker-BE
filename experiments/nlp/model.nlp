            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "iBUX is looking for a PHP developer who would be responsible for writing server-side web application logic. The ideal candidate must develop back-end components, connect the application with the other web services, and support the front-end developers by integrating their work with the application.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2+ years of solid experience as a PHP developer.",
            "intent": "job_description"
          },
