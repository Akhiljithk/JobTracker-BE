            "utterance": "Software Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Job Title: Software Engineer- Java",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Location: Whitefield, Bangalore",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "About Company:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Thermo Fisher Scientific Inc. is the world leader in serving science, with revenues of more than $25 billion and approximately 75,000 employees globally. We help our customers accelerate life sciences research, solve complex analytical challenges, improve patient diagnostics, deliver medicines to market and increase laboratory productivity.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Through our premier brands - Thermo Scientific, Applied Biosystems, Invitrogen, Fisher Scientific and Unity Lab Services - we offer an unmatched combination of innovative technologies, purchasing convenience and comprehensive services.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "About Team:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are Digital Engineering Team - the software center of excellence for Thermo Fisher Scientific. We are responsible for developing and delivering SaaS based applications and digital lab (Cloud-based) tools, to help scientists do their work more efficiently and with precision, enabling them to make our world healthier, cleaner and safer. Our world class software products and solutions accelerate scientific discovery and lab productivity. These solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "provide rich content, selection tools, collaboration tools and scientific apps that allow our customers to focus on innovation and the complexities of their science.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "create a connected world for our customers where discoveries happen the smart way - where every device/product is connected, self-aware, and self-healing-thereby enabling efficient workflows and collaborative science.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "enable our customers to efficiently manage their lab by providing them insight to workflow processes, asset uptime and product availability.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We give them the flexibility to access what they need when they need it, allowing them to select and receive products and services across multiple channels. We apply industry best practices to the design, development, and deployment of world-class software products built to leverage the power and scalability of the cloud.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Roles & Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a backend web developer to join our new and growing engineering team in eCommerce. The ideal candidate is an energetic self-starter with strong work experience. This person will play a central role in the delivery of applications and services that empower users to improve their health.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a senior software engineer, you will be responsible for: Designing, developing, testing, and deploying applications, participating in architecture and code reviews, helping to prioritize features and bug fixes, working collaboratively with cross-functional teams at Thermofisher, leading in the pursuit and delivery of the best possible product.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Functions:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Define and develop verifiable requirements and software designs.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop technical documentation for software architecture, design, and verification plans.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Define and develop software requirements, architectures and designs suited or fault-tolerant systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Participate in all aspects of software development, systems integration, test execution, issue resolution, and reviews.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborate and communicate effectively with software, hardware, and test engineers across the team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Candidate Requirement:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Education & Experience levels:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelors in Engineering/Computer Science or Master degree or equivalent Industry Experience of around 6+ years",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Skills, Knowledge and Experience:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Hands on experience designing web-based applications in Java technologies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Hands on experience in Java latest version (java 8), springboot, and microservices Architecture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience designing and building browser-based software, cloud or AWS experience",
            "intent": "job_description"
