          {
            "domain": "default",
            "utterance": "About Cognizant",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Cognizant (Nasdaq-100: CTSH) is one of the world's leading professional services companies, transforming clients' business, operating and technology models for the digital era. Our unique industry-based, consultative approach helps clients envision, build and run more innovative and efficient businesses. Headquartered in the U.S., Cognizant is ranked 194 on the Fortune 500 and is consistently listed among the most admired companies in the world.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Java Developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "\"• Strong Experience in Java8 • Rich Expertise in Java frameworks like Spring MVC, Springboot, Hibernate, RestAPI and Microservices • Knowledge in JavaScript, CSS and HTML5 etc. added advantage • Knowledge in database and SQL skills • Exposure to CI & CD tools • Experience in working with global teams in Agile/Scrum methodology Responsibilities: • To Design, Develop, Test and Deploy applications and maintain existing systems. • Ability to work in Scrum/Agile environment. • Communicating with client/product owner for requirement gathering. • Revise, update, re-factor and debug code. • Strong analytical, logical skills\"",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Informatica empowers the world's most progressive companies to realize data-driven digital transformations that are changing the. To do this, we live by our We \"DATA\" values. We Do Good, Act As One Team, Think Customer First, and Aspire For The Future. Together, we are conquering the impossible with data and changing what was once unimaginable into whats now commonmaking lives richer, businesses stronger, and our world better.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Unleash Your Potential",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A career with Informatica gives you all the opportunities and benefits that can only come from working for the trusted industry leader. By joining our team, you'll be able to solve real-life problems, make a difference, have a global impact, and join a supportive group of globally diverse teammates. We encourage you to be yourself, grow with us and unleash your potential.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Informatica is currently looking for a Senior DevOps Engineer with experience in Elastic Stack, Kubernetes to join our team in Bangalore, India.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Summary",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Senior DevOps Engineer in Cloud Trust Team to support Centralized Elastic Stack for Observability and Security",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a Senior DevOps Engineer, you will be responsible for supporting Centralized Elastic Stack for Informatica R&D Engineers. In the role of Senior DevOps Engineer, you must be able to work and adapt in a fluid, fast-paced environment. Working as the Senior DevOps Engineer you must have strong technical, communication, collaboration, and leadership skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Technology Youll Use: (Only for R & D Jobs)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Elastic Stack (ECK), Kubernetes, GitOps, Java/Go Lang, Python, AWS, Azure, GCP, Docker, Kafka, Kinesis, SQS, Grafana, Prometheus, Jaeger/Zipkin, Ansible/Chef",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What Youll Do",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build and Operate large scale ELK clusters deployed in multiple Cloud Providers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Driving initiatives to evolve our current platform to increase efficiency and keep it in line with current standards and best practices.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage and Onboard users to Elastic APM, Open Telemetry and Open Tracing",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Rollout GitOps to manage many Elasticsearch Clusters to ensure zero downtime, highly available during upgrades and maintenance activities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Perform incident/alert troubleshooting, problem analysis and provide high quality solutions to technical issues",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "On-call support in cases of issues on production environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with geographically dispersed team",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Key Essentials",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have experience with logging and telemetry services, specifically ELK, Jaeger, Zipkin, Grafana, Prometheus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have experience in either of Cloud Providers AWS, Azure, GCP",
            "intent": "job_description"
