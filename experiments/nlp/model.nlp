          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Allstate Identity Protection provides industry-leading employee identity protection and advanced threat intelligence that enable its clients to combat an ever-changing cyber threat landscape. Our headquarters is in Scottsdale, Arizona. We are passionate about our culture and offer team members rewarding opportunities in a fast-growing, dynamic environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Summary/Objective",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Allstate Identity Protection is one of the leading providers of cyber threat intelligence solutions. Our priority is to maintain the security of our participants. We are looking for full-stack Javascript developers who can help develop a new line of web-based products related to participant privacy. The best candidates will have experience building React UI components using modern best practices in design, implementation, and testing considerations as well as integration with Python and JS-based back ends.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Essential Functions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Work with a small team of engineers, to ensure product delivery and best engineering practices.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Develop solutions to deliver privacy features via internal and externally-exposed APIs.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Enhance existing privacy-related data administration portal.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Setup continuous delivery process to enable continuous iteration on solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Work in an agile, highly collaborative and agile environment with a lean team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Customize and adapt to engineering best practices tools and applications like JIRA, Confluence, Postman, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Help support team in resolving the customer issues related to the product.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Review code, lead refactoring activities, provide guidance from technical perspective for all members of a project.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Train and mentor new team members.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Reasonable accommodations may be made to enable individuals with disabilities to perform the essential functions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Competencies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Business Acumen",
            "intent": "job_description"
          },
