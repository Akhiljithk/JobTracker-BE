            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must have experience with *Java Full Stack Development.*",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Prior experience with JavaScript or object-oriented programming, SQL, and relational database knowledge is a plus.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "If you feel that you would be not just a good fit, but a great one, please submit your application. Blue Rose is an equal opportunity employer with comprehensive benefits packages. Join us and discover the unique opportunities that come with being a Blue Rose professional.",
