          {
            "domain": "default",
            "utterance": "Position Overview",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "CyberGrants is an ambitious, fast-growing and innovative company that helps our clients achieve Agile Social Impact. We are proud to have hundreds of clients, including over half of the Fortune 100. In the last twelve months alone, we’ve processed over $6.5 billion and more than 50 million volunteer hours. Nearly one-third of all corporate charitable giving is donated via CyberGrants software.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As part of our Technical Services team, you will be working in a highly collaborative environment in an exciting and comfortable atmosphere. You will be responsible for translating client requirements into the design and development of customized systems. You will be immersed in multi-tiered technical solutions integrating front-end, server-side, and database code.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "By joining CyberGrants, take your technical potential together with your passion for good and go home every night knowing the work you’ve done has positively impacted millions of people around the world!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Apprenticeships or part-time may be considered.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Key Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Support technical development of new client implementations and enhancements to existing client programs integrating front-end, server-side, and database code",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Resolve technical issues related to custom and standard CyberGrants software offering",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and develop internal support software to improve productivity, quality and speed of delivery",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrate a strong ability to learn quickly and research new technology or skills as needed",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Participate openly and constructively in code peer review and other quality control activities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Interpret business requirements and formulate developer and test strategies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrate a strong ability to be flexible and think out-of-the-box",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work effectively individually and as part of a multi-discipline team",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements",
            "intent": "job_description"
          },
          {
