            "domain": "default",
            "utterance": "Network Administrator",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Job Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Agnik is a global connected car technology company (www.agnik.com) operating in 200+ countries headquartered in the USA with major consumer brands like Vyncs (www.vyncs.com) and several B2B products. Agnik is looking for a computer Security & Systems Administrator to join its Team at its New Town, Kolkata office. If you want to join a top-notch connected car applications development team and have at least three years of hands-on experience in systems administration, then apply with the resume and with the subject line “Computer Security & Systems Administrator”.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As an employee of Agnik, the primary focus of the Computer Security & Systems Administrator will be to maintain, secure, and improve the company computing environments. The primary focus is on the server, cloud, and desktop administration and support.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Systems Administrator duties include:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Installation, maintenance, and upgrades on computer hardware and software systems including operating systems, web services, and databases.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Monitoring Linux and Windows servers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Monitoring performance of cloud-based distributed computing system and optimizing system behavior.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Computer threat management and system security protocol design and enforcement using firewalls, intrusion detection systems, malware control, and other related technologies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Taking system backup in a data-intensive cloud-based data management system.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Managing user access and passwords.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Proposing and implementing systems enhancements that improve the reliability and performance of the system.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Monitoring usage and performance of the network.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Training personnel on system usage.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Troubleshooting server, software, and hardware issues.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Assisting with recommending, scheduling, and implementing system hardware and software upgrades or repairs.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Researching, evaluating, and recommending software and hardware products.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Providing new hardware specifications to users based on application needs and anticipated growth.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Performing other related duties as assigned.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The Systems Administrator position requires:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· At least a B.Tech/BS degree from a reputed University in Computer Science (or other engineering/Science major) with relevant experience.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· 2 or more years of experience in systems administration.",
            "intent": "job_description"
