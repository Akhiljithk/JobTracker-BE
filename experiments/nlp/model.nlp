            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Factors emerging technologies and product supportability into design and implementation",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provides input to staff involved in writing and updating technical documentation such as user manuals, system documentation, and training materials",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Advises hardware engineers on machine characteristics that affect software systems, such as storage capacity, processing speed, and input/output requirements",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Prepares reports on analyses, findings, and project progress, and presents results to management and/or customer personnel",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Serves as a customer interface to resolve problems and ensure requirements are met on a timely basis",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provides guidance and work leadership to less-experienced software developers and may have supervisory responsibilities",
