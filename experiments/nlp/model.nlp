          {
            "domain": "default",
            "utterance": "Since 1992, Ciena has been driven by a relentless pursuit of network innovation. We believe in a network that grows smarter, more agile, and more responsive every day. This means that when you digitally interact in your world - picking up the phone, streaming video, texting a friend or loved one your interactions are being enabled by Ciena technologies. Ciena makes your social / entertainment / business existence REAL.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What will you do at Ciena?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for highly motivated and talented software engineers to join Blue Planet platform team, responsible for building performant, reliable, and maintainable platform services and tools in a large, polyglot, distributed environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop micro-services and tools that provide common support for scalable and highly available software system",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work closely with design teams to support their use of the platform to deliver complete solutions to customers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Participate in all phases of an agile development cycle plan, design, implement, review, test, deploy, document, and training",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Troubleshoot and resolve customer issues",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strive to make continuous improvement",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaboration with stakeholders",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Working collaboratively with Product Owner, Product Line Management (PLM), Product Verification, development teams, customer support teams, documentation team, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Areas of impact",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Blue Planet is based on a modern software architecture that leverages open-source technologies, model-driven templates and container-based micro-services. Blue Planet facilitates the evolution toward more efficient, modernized network operations and software-defined programmability to accelerate the delivery of on-demand services, reduce costs, and enable a path to increased network autonomy. As a member of platform team, you will provide services, tools and manage system complexity to help Blue Planet solution teams to deliver value more easily and in a maintainable way.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelors/Masters Degree in Computer Science with 6-8 years of experience.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong understanding of Computer Science fundamentals, algorithms and design patterns",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient in languages such as Python",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have good knowledge of Django framework.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with distributed, highly-available, horizontally scalable systems running at large scale",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Interest and ability to quickly learn and ramp-up on new languages and technologies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good communication and interpersonal skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Desirable knowledge or experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good knowledge of OS and software security",
            "intent": "job_description"
          },
