          },
          {
            "domain": "default",
            "utterance": "Providence St. Joseph Health is calling a Software Developer 3 to our location in Beaverton, OR.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are seeking a Software Developer 3 to be a member of an Agile software development team (Scrum or Kanban) in the PHP Information Services (IS) Department. As senior software developer they will be expected to work well within their agile team, foster collaboration, mentor teammates and other members of the IS Department, and provide opinion and expertise on technical issues all while embracing Agile Principles and Values.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The Software Developer 3 performs a variety of technical administration, development, and support functions for Information Services. Works with customers, vendors, consultants and other Information Services staff in performing their duties. On-call support is a requirement for any Developer position. Developers are required to provide 24/7 on-call support on a rotational basis.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In this position you will have the following responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Working as an effective team member in an Agile Scrum or Kanban team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Providing technical expertise and mentoring to their fellow Agile team members and members of other teams.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Gather and analyze complex business requirements.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Specify and implement technical plans for complex solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Combine business and technical knowledge to gain agreement and implement solutions within cross-functional teams.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Verify correctness of software using manual and automated testing strategies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Verify performance of software using load testing and other strategies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required qualifications for this position include:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Associate Degree plus 6 years of demonstrated software development experience in an enterprise environment OR;",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor's Degree plus 4 years of demonstrated software development experience in an enterprise environment OR 6 year degree plus 2 years of demonstrated software development experience in an enterprise environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "8 years demonstrated software development experience in an enterprise environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Preferred qualifications for this position include:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Microsoft SharePoint: Experience with 2010 and 2013.",
            "intent": "job_description"
