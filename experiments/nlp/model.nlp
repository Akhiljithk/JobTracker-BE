          {
            "domain": "default",
            "utterance": "Corporate Title Assistant Vice President",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As DevOps Lead in RFT, you will be working as a part of DevOps transformation team that work to implement DevOps strategy and drive the DevOps transformation across RFT domain. In this role, you will work in partnership with the Agile, Testing and Release Management functions to proactively engage test teams to make sure that deliveries are aligned with overall transformation objectives. You will be required to help the subdomains identify, assess, manage the DevOps health needs including any bespoke solution to improve the KPIs.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What we’ll offer you",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A healthy, engaged and well-supported workforce are better equipped to do their best work and, more importantly, enjoy their lives inside and outside the workplace. That’s why we are committed to providing an environment with your development and wellbeing at its center.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You can expect:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Competitive salary and non-contributory pension",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "30 days’ holiday plus bank holidays, with the option to purchase additional days",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Life Assurance and Private Healthcare for you and your family",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The opportunity to support a wide ranging CSR (Corporate service responsibility) programme.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Your key responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Working with other engineers to support our adoption of continuous delivery, automating the building, packaging, testing and deployment of applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Creating the tools required to deploy and manage applications effectively in Test Environments, with minimal manual effort",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Helping teams to adopt modern delivery practices, such as extensive use of automated testing, continuous integration and more frequent releases.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Configuring and managing code repositories, continuous builds, artefact repositories, cloud platforms and other tools",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Contributing towards a culture of learning and continuous improvement within your team and beyond",
