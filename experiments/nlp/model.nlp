          },
          {
            "domain": "default",
            "utterance": "· Ensure network security and connectivity.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Monitor network performance (availability, utilization, throughput, good put, and latency)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "and test for weaknesses.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Set up user accounts, permissions and passwords.",
