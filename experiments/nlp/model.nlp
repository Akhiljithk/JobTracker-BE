            "utterance": "Software Engineer (UI Developer)(JavaScript,React)(1.5 to 3 years)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Software Engineer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Who are we?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Every day, billions of transactions, calls and messages that hold the world’s communications fabric together run on systems that Amdocs has helped to create.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Because we work with some of the largest and most innovative companies on the planet, our work makes an impact. Over the past four decades, we have continually reinvented ourselves, and as we keep moving into exciting new areas such as media, gaming, IoT, 5G, cloud services and more, there are always opportunities for us to grow and develop. We will nurture your entrepreneurial instincts with open doors and promote your ability to seize the day. Our company is built of amazing people, a supportive atmosphere and a culture built on mutual support, respect and a “feel good factor” that can only happen in a workplace built by the kind of people that Amdocs employs.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Make your career journey with us.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In one sentence",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsible for design, develop, modify, debug and/or maintain software systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsible for one or more specific modules within a large software system scope",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What will your job look like?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will design, develop, modify, debug and/or maintain software code according to functional, non-functional and technical design specifications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will follow Amdocs software engineering standards, applicable software development methodology and release processes, to ensure code is maintainable, scalable , supportable and demo the software products to stakeholders",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will investigate issues by reviewing/debugging code, provides fixes and workarounds, and reviews changes for operability to maintain existing software solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will work within a team, collaborate and add value through participation in peer code reviews, provide comments and suggestions, work with cross functional teams to achieve goals.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will assume technical accountability for your specific work products within an application and provide technical support during solution design for new requirements.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will be encourage to actively look for innovation and continuous improvement, efficiency in all assigned tasks.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "All you need is...",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor's degree in Science/IT/Computer Science or equivalent",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "1.5 to 3 years demonstrable experience with the HTML5, CSS, Java Script, React/Redux, nodejs Advance JavaScript, Typescript, Angular 2 .",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience of unit/integration/e2e testing with frontend projects.",
            "intent": "job_description"
          },
