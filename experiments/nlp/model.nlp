          {
            "domain": "default",
            "utterance": "The Data Scientist is responsible for collecting data and developing insights related to innovative new business initiatives at BrickRed Systems focused on the digital enablement of industrial, and Manufacturing markets. Responsibilities of the Data Scientist include, but not limited to:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Leverage big data to discover patterns and solve strategic & tactical business problems using massive structured and unstructured data sets across multiple environments",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Develop analytic capabilities (e.g. models and processes) that drive better outcomes for both customers and the company",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Drive the collection, cleansing, processing and analysis of new and existing data sources.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Build, test, and deploy predictive models and/or machine learning algorithms on large static and/or streaming data sets",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Report findings by creating useful and appropriate data outputs and visualizations tailored for the intended audiences",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Learn & stay current on Machine learning and Internet of Things developments, news, opportunities, and challenges",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Generate innovative ideas, establish new research directions, shape and execute the information strategy in support of technical projects and new product developments",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with and support other team members, management, and partners",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "University degree in a relevant field such as Statistics, Physics, Mathematics, Machine Learning or Data Science",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Mandatory experience in industrial/Manufacturing related projects.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· 5+ years experience in related data science, analytics, and model building roles or 10+ years experience in directly related roles",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Extensive experience working with large complex data sets, real time/near real time analytics, and distributed big data platforms (Hadoop & MapReduce and/or Cassandra/Spark)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Strong practical knowledge of analytical techniques and methodologies such as machine learning/supervised and unsupervised techniques, segmentation, mix and time series modelling, response modelling, lift modelling, experimental design, neural networks, data mining and optimization techniques",
