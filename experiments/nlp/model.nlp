          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "About the Position:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are building Cloud Services based on micro services. As we take our next big step forward in our company, in the implementation of scalable, reusable platform services that will form the core of our technology and software solutions as we move into the future. This position needs the you to lead, develop, coach teams in building end to end automation and monitoring of cloud scale systems. In this role, you will lead teams by example to create self-service, fully automated deployment systems that helps in deployment of our solution. You will ensure that our solution can be continuously released with high levels of confidence while also improving the scalability, reliability, quality and performance of the Continuous Delivery/DevOps systems",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Define and drive end-to-end agile DevOps based software development life cycle with end to end automation in mind (Tools & Processes)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Establish software architecture patterns with High Availability, scale, security, monitoring, and configuration of cloud platform services.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provide software architecture guidance and design patterns for PaaS and distributed system services development.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Planning, installing and deploying highly available solutions on public cloud",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Designing, implementing, and managing DevOps capabilities in cloud offerings using CI/CD toolsets and automation",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with development teams across multiple organizations to drive automation, establish software standards, service modularity, code reuse, testing, and deployment/management of micro services.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with engineering, product management, and operations teams to establish standards and repeatable processes for managing change, and brownfield upgrades across different environments.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Communicate effectively at various levels, translate needs and synthesize high-level designs/processes, guide agile iteration sequencing, and drive overall outcome with scrum teams.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Mentors and coaches team members.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Minimum Qualifications: Bachelors engineering degree",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Preferred Qualifications:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "5-7 years of Designing and implementing end to end automation",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "4+ years configuration management/automation tools such as Puppet, Chef, Ansible ,Terraform or SaltStack,",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in Python.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Significant experience with tools used for automated deployment, scaling, and operations of application containers such as Kubernetes/Mesos",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good technical understanding of distributed systems, large-scale server and cloud infrastructures",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with public clouds such as AWS, Azure, GCP",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in deploying & managing clustered applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Working knowledge of Jenkins and Git",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Keen understanding of package management system",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Network automation such as switch configurations, routing, & load balancers",
            "intent": "job_description"
          },
          {
