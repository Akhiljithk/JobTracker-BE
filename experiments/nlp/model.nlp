          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Company Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Stockbit is the leading social platform that redesigned information sharing for stock investors and traders in Indonesia. Engineered and designed by traders for traders. Our vision is to make stock investment simple for individual investors. We house a bunch of world-class talent that passionately developed innovative analytical tools that simplify investment decisions. We are continuously building our team and working towards making investment in Indonesia exciting for the people.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for an awesome team player who has mastery in AWS Cloud and passionate about building a smooth, effective & efficient development workflow within a startup company. In this role, you will collaborate closely with the Developers and QA to improve the speed & quality of deployments on both frontend and backend as well as ensuring that the underlying infrastuctures are scalable, secure and resilient.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provision resources required by Engineering Team",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Implement CI/CD pipelines to streamline deployments and pre-deployment checks/testings",
