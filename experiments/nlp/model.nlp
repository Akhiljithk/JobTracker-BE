          {
            "domain": "default",
            "utterance": "We are looking for an outstanding IOS Developer to be responsible for the coding, innovative design and layout 2 Years to 5 years relevant experience (Others please do not apply)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our company:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The idea of Weavers Web Solutions Private Limited took shape in the year 2010. With more than 6 years of dedicated work and know how, we have come a long way in the field of information technology services. Once started with a small clientele, Weavers Web today boasts of an esteemed clients list.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Weavers Web offers state-of-the-art solution in the field of website design, web application development, online marketing, digital branding, e commerce web development and others. Our innovative infrastructure coupled with our team of 55+ professionals enables us to provide our 400+ clients with outstanding solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "(750 completed projects). We are always trying to come up with lot of innovative ideas to solve things faster and error free.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for an iOS developer who possesses a passion for pushing mobile technologies to the limits and will work with our team of talented engineers to design and build the next generation of our mobile applications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and build advanced applications for the iOS platform",
            "intent": "job_description"
          },
          {
