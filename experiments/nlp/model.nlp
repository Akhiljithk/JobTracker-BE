          },
          {
            "domain": "default",
            "utterance": "Blue Rose Consulting Group, Inc. is seeking candidates to support a Department of Education (DoED) opportunity. This position will support a major department-wide effort to modernize communications/interactions with the public. *This particular role is open only to US Citizens.*",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "This role will support our Adobe Campaign platform development work, although prior experience with Adobe Campaign is not required. In addition to supporting our more senior developers, this role will help with product testing and managing/resolving defects prior to client user acceptance test.",
            "intent": "job_description"
          },
          {
            "domain": "default",
