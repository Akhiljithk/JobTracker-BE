          {
            "domain": "default",
            "utterance": "We are GDIT. The people supporting and securing some of the most complex government, defense, and intelligence projects across the country. We ensure today is safe and tomorrow is smarter. Our work has meaning and impact on the world around us, but also on us, and that’s important.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "GDIT is your place. You make it your own by embracing autonomy, seizing opportunity, and being trusted to deliver your best every day.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We think. We act. We deliver. There is no challenge we can’t turn into opportunity. And our work depends on a TS/SCI level cleared Software Developer joining our team to support our Intelligence customer in Reston, VA.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In support of a DoD customer, the software developer shall develop software programs and databases to collect, store, forward and disseminate sensor datasets to include:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Support data storage, data discovery, exploitation and analysis that are compatible with existing SCS, ATI, and mission partner tools (i.e. Database designs, use Database Design Document)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop scripts and software tools to manipulate data and move it automatically between networks and folders.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Sanitize correlation data",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop scripts to evaluate user dataset development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop API/GUI and data sources",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The software developer shall use an iterative, incremental, or other agreed upon system engineering processes to design, develop, deploy, document, and certify and accredit TPED IT systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The software developer shall define and document a general Software Development Plan (SDP) delineating the software development approach for the computer software efforts to be performed IAW (IEEE/EIA) Std. 12207.0, to include:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Defining the proposed or established life cycle model and the processes and Plans and Procedures Table 1 used as part of that model IAW (IEEE/EIA) Std. 12207.0:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Identify the specific standards, methods, tools, actions, strategies, and responsibilities associated with software development and qualification",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Document all processes applicable to the system to be acquired, including the Primary, Supporting, and Organizational life cycle processes, at a minimum, CMMI Level 2 processes.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure consistency with the processes proposed by the developers; adhere to characteristics, organizational processes etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Will contain a level of information sufficient to be utilized as full guidance for the developers. (i.e. specific standards, methods, tools, actions, reuse strategy, and responsibility associated with the development and qualification of all requirements, including safety and security).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Operate in customer environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Prepare as required, all source code and associated concept papers associated with software, test related software, and applications developed under this order",
            "intent": "job_description"
