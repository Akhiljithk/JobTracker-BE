            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "defining features and implementation specifications based on business requirements",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "developing high-quality software for complex back-end systems and APIs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "developing front-end software solutions to deliver intuitive, fast, and fun web experiences",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "identifying enhancements and modifications that improve product quality",
            "intent": "job_description"
          },
          {
