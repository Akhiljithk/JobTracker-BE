          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Title: DevOps Engineer, Service Cloud Digital Engagement",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a DevOps Engineer in Service Cloud, not only will you be responsible for keeping our Digital Engagement product suites up and running, you will also have the ability to shape the tools to smoothly run our development lifecycle and automate all aspects of our environment. As we transform continuous integration and delivery into the public cloud platforms, you will have first-hand opportunity to participate in the implementation and rollout. You will be working closely with the Product Engineering and Production SysEng teams to support our customers across the globe. While personality and ability to learn are keys to success on our team, you should already have the technical skills described below to hit the ground running. Please come and join us in the fast-growing Salesforce.com Service Cloud organization.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work collaboratively with product engineering to manage and operate our test and performance systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Troubleshoot and resolve issues in our development, test, and production environments.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Automate and streamline our operations and processes, to achieve high-available service.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build and maintain tools for deployment, monitoring, and operations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage the CI/CD pipelines to public cloud platforms, utilizing push-button deployment at scale with zero downtime.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Using new technologies that improve our tools and performance across our whole software stack and infrastructure.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Hands-on in scripting languages (e.g. Perl, Python, Shell) and Java skills",
            "intent": "job_description"
          },
