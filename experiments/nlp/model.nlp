          },
          {
            "domain": "default",
            "utterance": "You will have ownership of developing and maintaining some of our backend services including reports, payments and operations tools that manage our product and logistics worldwide.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will work on everything from customer-facing web and mobile applications using cutting-edge open source frameworks to highly-available RESTful services and back-end systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "JSON Mobile App Development REST API Ruby Web Development Software Development AWS Google Cloud Communication Skills PostgreSQL Go Robust Backend Java",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities and Duties",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will fit well in the Toggl backend team if you are passionate about technology and have experience programming in Go. Knowledge of technologies like Ruby, PostgreSQL, REST, JSON and Google Cloud Infrastructure will help you get going from day one. You will be a perfect match with our team if you love collaborating with people from all disciplines to solve complex problems, always want to learn new skills and take ownership of your work.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "About the team",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Toggl is a distributed team of 75+ people working remotely from 30 countries. We take pride in our professional, learning-oriented and friendly working environment that values work-life balance and constantly doing our best in every aspect of our work. You can work from anywhere in the world, because we know great people do awesome work wherever they are. Every few months we travel to meet up somewhere in the world and spend some quality time together. Our business is profitable with a healthy margin and we are built with no outside investments, so you can count on a stable working environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Some benefits",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Freedom to choose when and where you work from.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "24 days of paid time off a year, plus your local holidays.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2 company retreats and 2 team meetups a year (expenses covered) for team-building.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Laptop and a €2,000 budget to set up your home office.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Reimbursement for co-working space rent or internet service at home.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Opportunities to attend trainings, workshops or conferences.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Monthly reimbursement for gym membership, massage and other things to improve your health.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Support for buying a phone, eyeglasses or tools you need for doing your best work.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required Experience and Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience: 1 - 5 years in Programming in Go( Required )",
