          {
            "domain": "default",
            "utterance": "Experience in leading cross-functional, highly complex Data Science projects",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Data Mining experience in Python, R, H2O and/or SAS. Familiar with various Machine Learning algorithms and Statistical methods",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have a passion for working on big data and professional experience in data mining, statistical analysis, predictive modeling and data manipulation.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to deal with large amount of data and fluency with SQL or SQL-like tools.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Financial services or eCommerce experience a big plus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We're a purpose-driven company whose beliefs are the foundation for how we conduct business every day. We hold ourselves to our One Team Behaviors which demand that we hold the highest ethical standards, to empower an open and diverse workplace, and strive to treat everyone who is touched by our business with dignity and respect. Our employees challenge the status quo, ask questions, and find solutions. We want to break down barriers to financial empowerment. Join us as we change the way the world defines financial freedom.",
            "intent": "job_description"
          },
          {
            "domain": "default",
