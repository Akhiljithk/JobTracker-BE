          },
          {
            "domain": "default",
            "utterance": "The Senior OKTA Administrator will provide subject matter expertise in IAM domain and Okta IdaaS solution Platform and support Project and Program teams to enable successful integration with Okta for enabling Single Sign-On and Identity Life cycle management integration for on-premise and SaaS applications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Key accountabilities of role:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop, Support and extend the deployment of existing Identity and Access management solution deployed using Okta IdaaS SaaS solution",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Integration of applications with Okta for enabling Single Sign-on using standard integration protocols and patterns including SAML, OpenID Connect Microsoft WS-Fed , Integrated Windows Authentication and other authentication patterns",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ongoing governance and reporting of Okta IdaaS solution and ensuring compliance to Information security policies",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provide Okta API based development solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong Issue resolution and Problem Management with focus on Root Cause Analysis and Root Cause Corrective Action .",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage regular reviews with other domain SME’s for complex enterprise wide IT Implementations across multiple towers including applications, Middleware and other solution offerings",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Continuous improvement and Industry best practices to ensure operational stability, drive Service improvement projects across the enterprise with internal stakeholders and external partner service delivery teams.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in providing L3 support for Okta IdaaS solution in large complex enterprise environments",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrable experience and industry best practice implementation of identity and access management solutions and related offerings (viz. SSO- SAML, OIDC, OAuth, WS-Fed, Kerberos, Provisioning, Recertification, SCIM etc).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications / Experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The Senior OKTA Administrator would need to have at min 3 years of experience with deployment and support of Okta IdaaS solution offerings in Project and support role(s) and minimum 5+ years with L3 support experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrable experience working on large complex IdaaS project implementation and support , Designing and implementing Identity and Access Management solutions to support critical systems and business programs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Prior experience with other IAM solutions in the market place both on premise and Cloud based IdaaS solutions – e.g. Onelogin, Forgerock, Ping Identity, Oracle , IBM , CA etc will be an advantage",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Extensive demonstrable experience with technologies and protocols to support identity federation and robust access control models (e.g., SAML 2.0, WS-Federation, OAuth, OpenID Connect, SCIM etc)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Working knowledge of enterprise web technologies, Information and Network security solutions, IaaS and PaaS services",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrable experience with Enterprise identity life cycle management processes and standards.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Microsoft Active Directory / Azure Active Directory and LDAP experience is mandatory",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Previous experience working on Enterprise Identity life cycle management projects – both on premise deployments and SaaS deployments e.g. Salesforce, Box, Office 365, Workday HR as master for identities",
            "intent": "job_description"
          },
          {
