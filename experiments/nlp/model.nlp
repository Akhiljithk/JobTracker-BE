            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Be aware of activity in the open source world. Contributing back to open source is a big plus.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Participation in full life-cycle system development with teams of developers, analysts, and testers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Completed Bachelor’s degree in Engineering",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with modern development practices in areas of Product design, Requirement Analysis, Test Driven Development, Automation & Unit Testing, in a product development environment.",
            "intent": "job_description"
          },
