          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Minkasu, Inc. an innovative mobile payments company based in Silicon Valley, California, USA, is looking for a DevOps Engineer to join our engineering team in India. You will have the opportunity to play a key role to create automatable and repeatable deployments of networks and systems in AWS Cloud. You will be working with other engineers responsible for different components of the solution. Therefore, a commitment to collaborative problem solving, sophisticated design, and the creation of quality products is essential. You must possess a strong customer focus, and be capable of technical deep-dives into operating systems, application performance, databases, load balancers, networks, and storage systems. You will have a chance to join a brilliant engineering team and contribute in a significant way at an early-stage startup. Do you have what it takes to work in one of the hottest areas of tech today?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Location: Coimbatore",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and implement infrastructure in AWS Cloud that supports development of mobile SDK for iOS & Android, backend services and web applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage the establishment and configuration of infrastructure in an agile way by storing infrastructure as code using AWS CloudFormation and provision environments at any point in time.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Automatically and continuously deploy code without any downtime using GitHub for source code repository, Jenkins to build, AWS CodeDeploy to deploy and AWS CodePipeline to build the Continuous Integration and Continuous Delivery pipeline.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Consistently and automatically deploy relational database schema changes for AWS Aurora using tools like Sqitch.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Leverage Automated Testing in different stages of a CI/CD pipeline.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Fine tune the mobile SDK, backend services and web applications for high performance and use the right tools to monitor application and environment for potential issues including fault detection, alerting, triage, and recovery (automated and manual).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Configure a set of Amazon EC2 instances that launch behind a load balancer like NGINX with the system scaling up and down in response to demand.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage User Identity, AWS permissions, and Security in the cloud",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop and implement instrumentation for monitoring the health and availability of services.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Monitor service consumption and drive operational cost reductions through service optimizations and demand based auto scaling.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Be accountable for proper backup and disaster recovery procedures.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Stay up-to-date on relevant technologies, plug into user groups, understand trends and opportunities to ensure we are using the best possible techniques and tools",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Perform manual QA as and when required before product releases",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Desired Skills/Experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor of Engineering in Computer Science or relevant field",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong experience building and maintaining production systems on AWS using EC2, RDS, S3, ELB, Cloud Formation, etc. and familiarity interacting with the AWS APIs like Amazon Gateway, AWS Lambda & AWS Cognito",
            "intent": "job_description"
          },
          {
