            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Hitachi Vantara combines technology, intellectual property and industry knowledge to deliver data-managing solutions that help enterprises improve their customers’ experiences, develop new revenue streams, and lower the costs of business. Hitachi Vantara elevates your innovation advantage by combining IT, operational technology (OT) and domain expertise. Come join our team and our employee-focused culture, and help drive our customers’ data to meaningful customer outcomes.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Setup, monitor and maintain DevOps cloud-based SAAS products and solutions involving IoT, big data, microservices, Cloud, containers and machine learning",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Maintain security and data privacy, ensure compliance and perform required security, compliance and performance tests",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Work with architects on deployment architecture, security and CI/CD and then implement these on the cloud",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• 2 to 5 years’ experience in a DevOps role in projects involving Java, NodeJS, J2EE, messaging, Microservices and Containers for complex, scalable, SAAS or enterprise grade products",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience in Big data technologies such as Spark, Cassandra, HDFS, Kafka, Druid, Hive, HBase, ELK stack in a complex Big Data product/project",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience with agile and Scrum",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience in implementing CI/CD using Jenkins/Bamboo and Chef/Ansible/Puppet/Terraform",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Infrastructure and APM monitoring using tools such as Zabbix, Nagios, Splunk, PagerDuty, Glowroot, AppDynamics etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience with Docker and container orchestration using Kubernetes, Mesos or DC/OS",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience with AWS (preferable) or other popular CSP",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience with Big data operations and tuning",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Ability to work with distributed teams in a collaborative and productive manner",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Strong problem solving, analytical, design, architecture, decision-making and communication skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Self-driven and motivated with the desire to work in a fast-paced, results-driven agile environment with varied responsibilities.",
            "intent": "job_description"
