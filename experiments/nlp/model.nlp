          },
          {
            "domain": "default",
            "utterance": "Are you ready to explore a world of possibilities?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Join our DTCC family, and you’ll groow your expertise and become the best version of you. As you embark on a new journey, you’ll tackle challenges with flexibility and grace, learning new skills and advancing your career while having the time of your life.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Why You'll Love This Job:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The Information Technology group delivers secure, reliable technology solutions that enable DTCC to be the trusted infrastructure of the global capital markets.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Department: Governance and Assurance",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The IT Governance and Assurance Department will focus on advancing organizational goals through the effective and efficient use of IT, by ensuring IT has the necessary capabilities and controls to enhance the stability of DTCC products. The department is responsible for maturing core IT business management and governance capabilities.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Software Application Engineer role will be responsible for providing technical support leadership of all the application suites within DTCC, including Global Trade Repository (GTR) application suite and all Omgeo applications. The role will be executing all aspects of the operating procedures/runbooks within a predefined shift pattern. This role is expected to work closely with the required development teams, our Enterprise Infrastructure partners and our internal business clients to resolve and escalate technical support incidents where necessary. The ideal candidate should be a self-starter who works well with a team of peers and as a directly responsible individual..",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Your Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
