            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor’s degree or foreign equivalent required from an accredited institution. Will also consider three years of progressive experience in the specialty in lieu of every year of education.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "U.S. citizens and those authorized to work in the U.S. are encouraged to apply. We are unable to sponsor at this time.",
            "intent": "job_description"
          },
