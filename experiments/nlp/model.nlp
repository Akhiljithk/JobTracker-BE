            "domain": "default",
            "utterance": "Job Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Are you looking for a new and exciting career opportunity?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Join our award-winning organization and work with some of the most talented minds within our Enterprise Technology and Innovation teams. As a Salient CRGT employee, you get to be part of a best performing team supporting our nation’s most critical missions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Why Salient CRGT?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We’re passionate about the inspirational missions of our customers and we entrust our employees and teams to deliver exceptional performance to enable the safety, security, health and well-being of our nation. We provide the tools and resources to help you be successful, and our culture fosters an environment in which idea sharing and collaboration is essential. Are you ready to make a difference?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The ideal candidate will be responsible for:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provide expert programming support to numerous custom developed and COTS software applications employing industry J2EE development standards",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Follow the agile development framework and provide continual transparency of development activities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop efficient integrations and exchange of data between the agency’s applications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Enhance the user interface and its underlining infrastructure.",
            "intent": "job_description"
          },
