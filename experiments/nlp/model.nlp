            "utterance": "Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for an iOS developer responsible for the development and maintenance of applications aimed at a range of iOS devices including iPhone and iPad. Your primary focus will be development of iOS applications and their integration with back-end services. You will be working alongside with other engineers and developers working on different layers of the infrastructure. Therefore, a commitment to collaborative problem solving, sophisticated design, and the creation of quality products is essential.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and build applications for the iOS platform.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure the performance, quality, and responsiveness of applications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborate with a team to define, design, and ship new features.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Identify and correct bottlenecks and fix bugs.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Help maintain code quality, organization, and automatization.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient with Objective-C and Cocoa Touch.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with iOS frameworks such as Core Data, Core Animation, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with offline storage, threading, and performance tuning.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Familiarity with REST-full APIs to connect iOS applications to back-end services.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of other web technologies and UI/UX standards.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding of Apple’s design principles and interface guidelines.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of low-level C-based libraries is preferred.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with performance and memory tuning with tools such as Instruments.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Familiarity with cloud message APIs and push notifications.",
            "intent": "job_description"
          },
          {
