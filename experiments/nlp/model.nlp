            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage overall capacity utilization of server/hardware environment ensuring it is optimized",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage the IT infrastructure, Communication (LAN, WAN, email, etc.), database, backup recovery, regulatory compliance",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Optimizing the server build and code deploy process",
            "intent": "job_description"
          },
          {
            "domain": "default",
