          },
          {
            "domain": "default",
            "utterance": "*Job Summary*",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The Network Engineer (Test Lab) position in our environment is looking for MPLS or MPLS-TE Engineers with some skills in coding to move into an exciting role to gain additional skills in automation and testing across various platforms. This is new role and is an opportunity to be part of a highly dynamic, cutting-edge and challenging environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "*Responsibilities and Duties*",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "*Responsibilities and Duties*",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "*Your main duties and responsibilities: *",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "* Develop and execute automated Network OS compliance tests for network vendor (juniper, aruba, arista.. etc) hardware used in corporate network environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "* Develop software components to support test automation on new platforms",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "* Execute ongoing code-validation projects and approve vendor OSes for corp-network readiness prior to deploying in enterprise",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "* Work with Design engineers and maintain the test repository up-to-date with latest tests",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "* Develop scripts to automate repetitive management tasks in Test Infrastructure",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "* Manage, Operate, Troubleshoot & Fix problems with Test Infrastructure Documentation where applicable",
            "intent": "job_description"
          },
          {
