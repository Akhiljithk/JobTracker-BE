            "utterance": "A small but fast-growing team with a lot of ambition",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A good environment to learn (a lot) and keep improving yourself and the way we work",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ping pong, Mario Kart, Super Smash, quarterly outings with beer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A full time job with a competitive salary: €4.000 to €5.000 a month",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements",
            "intent": "job_description"
          },
          {
