          },
          {
            "domain": "default",
            "utterance": "PipeCandy is a 'one of its kind', 'data science' driven market intelligence platform that tracks the global eCommerce landscape. Our insights are used by well known global brands and startups. We are venture funded by India, the US, and Singapore based investors.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "About the Role:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are building a complex data product that aims to revolutionize industry intelligence by applying sophisticated machine learning & AI algorithms on millions of data points.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a Data Scientist to ensure that the quality of this product always stays top-notch and world-class. If you love working with data, have an eye for detail and a strong adherence to quality then we’d love to hear from you.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "This is a senior position where the analyst will work under the general direction of the Chief Data Scientist and senior staff in the Data Management team. The primary responsibility is to treat data as an asset and become the expert source for data standards and policy-related questions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Key Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage the creation, deployment, and maturity of data governance processes and technology including master data, metadata, and data quality initiatives",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Identify opportunities to ensure transparent, high-quality data across sources and platforms",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Review, clean and add business records and formatting rules to every taxonomy/hierarchy in the product database in support of long-term data governance.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop processes and tools for data cleansing, de-duplicating, and other data preparation, standardization, and transformation",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborate with various teams to standardize data and ensure adherence to data ingestion and governance standards",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Conduct root cause analysis and proposed improvement solutions",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Leverage subject matter expertise to ensure data products are understood by the business users",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "This position requires a proficient level of experienced analytical and programming capabilities, defining requirements, developing and/or maintaining computer applications/systems, and ability to meet business needs within deadlines.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Here’s what we’re looking for in you:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Works to develop analytical/ data mining/ machine learning models using Python, R and other tools",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Gather, evaluate and document requirements, ability to build an algorithm (statistical/ data mining/ machine learning) based on requirements and specifications provided",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Works with data and is able conceptualize and improvise analytical solutions to problems",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to deploy analytical algorithms within a larger business application",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to visualize data and results of data analysis & analytical models",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Create model documentation as per client/ regulatory standards",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications & Competencies Required:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "1+ years of total relevant experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Degree in a quantitative field (Math, Statistics, Economics, Physics, and/ or Engineering, MBA)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to work with business and technology teams to build and deploy an analytical solution as per needs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to multi-task, solve problems and think strategically",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong communication and collaboration skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Skills Required:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with statistical analysis using R and Python. Experience with Spark and ML as plus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good experience in data discovery, exploration and algorithm development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with working on large data sets and developing scalable algorithms",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Hands-on experience of machine learning and data mining algorithms such as decision trees, classifiers, text mining/ NLP, clustering, and regression",
            "intent": "job_description"
          },
          {
