            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We make a \"Whole Person\" promise to our team. You can have both meaningful work PLUS a full life at Bandwidth. We focus on accomplishing our mission as \"whole people.\" That means we take care of our people—in body, mind, and spirit.",
            "intent": "job_description"
