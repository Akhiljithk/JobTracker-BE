          },
          {
            "domain": "default",
            "utterance": "Stephen M Hrutka",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Principal Consultant",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "www.hruckus.com",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Executive Summary: HRUCKUS is looking for a Java Developer with TS/SCI to research, design, develop, and/or modify enterprise-wide systems and/or applications software.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Position Description: The team will provide Operations and Sustainment support for the Application Service Provider (ASP) components of the operational Content Services systems and applications. Operations Support is the performance of those activities that enable systems and applications to meet performance and other defined mission requirements or service in a cost-effective manner.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Position Duties:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Designs, develops, codes, tests and debugs highly complex new software products or makes significant enhancements to existing software",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develops and applies advanced methods, theories, and research techniques in the investigation and solution of complex and advanced software applications and problems",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Resolves highly complex hardware/software compatibility and interface design considerations",
