          },
          {
            "domain": "default",
            "utterance": "About BlueOptima",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "BlueOptima provides industry-leading objective metrics in software development using our proprietary Coding Effort Analytics. We enable large organisations to deliver better software, faster and at a lower cost. Founded in 2006, BlueOptima is a profitable, high-growth independent software company. Our unique technology was initially devised in seminal research carried out at Cambridge University.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our HQ is in London, UK with 5 additional global offices in India, Mexico and the US.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "BlueOptima’s technology is deployed by global enterprises to drive value from their software development activities. We work with 12 of the Fortune 50 Companies, 4 of the top 10 biggest banks by Market Capital and 6 of the S&P 50 Companies (by revenue).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our technology is pushing the limits of complex analytics on large data-sets with more than 15 billion static source code metric observations of software engineers working in an Enterprise software development environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Project Brief -",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "To identify security flaws by eyeballing in static C/C++/Javascript code and replicate them manually by morphing/editing/rewriting the code.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding of the Security space should be able to understand CWEs, CVEs, CPEs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to run Penetration Tests and Static Analysers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Advanced programming ability in multiple languages",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Needless to say, immaculate English communication skills both written and verbal",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Automation Bounty:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We strongly believe that smart engineers are lazy and thus find ways to automate manual tasks effectively. We encourage you to be creative and come up with automated/semi-automated approaches to tag vulnerabilities accurately.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The developer who reduces project time and manual effort the maximum while keeping the accuracy intact is going to be rewarded handsomely.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Note: The bounty program is subject to a minimum threshold. Overall project time and manual effort should be reduced by a minimum of 50% to be eligible for the prize.",
            "intent": "job_description"
          },
