          },
          {
            "domain": "default",
            "utterance": "Why BlueJeans is THE PLACE to be?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At BlueJeans, we’re transforming the way people meet by creating a human connection in every experience. Together, we’re bringing video to everyone, regardless of location or device, including mobile, desktop, or room systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We have a fun and collaborative work culture! For three years running, BlueJeans was voted in the Top 20 - Best Places to Work in the Bay Area. We have over 5000 customers including Facebook, Stanford University, Netflix, Ford, UC Berkeley and JP Morgan Chase. We have raised $175M from top venture capitalists: Accel, NEA, Norwest and Battery. Our team is composed of rock stars from a blend of industries: broadband networks, video, media and SaaS. BlueJeans is an equal opportunity Employer.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Learn more about us at www.bluejeans.com",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Follow us @Bluejeansnet",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Java Developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Staff Engineer (Java)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "6 to 9 years of experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "ABOUT NAGARRO:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Nagarro helps clients transform, adapt, and build new ways into the future through an entrepreneurial, agile, and caring mindset. We excel at digital product engineering and deliver on our promise of thinking breakthroughs. Today, we are 8,400+ experts across 25 countries, forming a Nation of Nagarrians, ready to help our customers succeed.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At Nagarro, you can look forward to a work culture that is dynamic and non-hierarchical. You will be given opportunities to add value to challenging and complex assignments, while collaborating with world class technologists. The versatile environment here, helps foster fresh perspectives and enables you to deliver high quality code. There will be ample opportunities provided for skill upgradation to accelerate your professional and personal development.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "WHAT MAKES YOU A GOOD FIT FOR THIS ROLE:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Relevant experience in Java 8 or higher, Spring Framework-Core/Boot/MVC, Hibernate/JPA, JMS/ AMQP/ Kafka, JavaScript and Microservices Architecture.",
            "intent": "job_description"
          },
