            "utterance": "Comfortable with modern front-end technologies such as HTML5, CSS3, SASS, ECMAScript 6, TypeScript, Webpack, NPM, Grunt, and Babel",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Familiarity with UI frameworks such as AngularJS, Angular, React, or Vue.js, and an understanding of responsive design",
