          },
          {
            "domain": "default",
            "utterance": "As the global leader in agile market research, GutCheck works as an extension of your team and blends rigor, speed, and experience to uncover valuable audience insights – helping you make more informed decisions quickly and with confidence",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "GutCheck Culture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are driven to find future GutCheckers who thrive in an agile environment, who embody our GASI Values – aka hire people who Give A S***. We're not for everyone, and that's ok! Do you have grit? Do you want to grow by challenging yourself? Do you want to be part of something greater than yourself?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At GutCheck we believe that the best ideas come from within, and everyone's voice matters. We strive together every day to make heroes out of our clients. If this type of mindset ignites the passion within you, come join us!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our Technology",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Spring Boot, ElasticSearch, Kafka, MongoDB, React, Java, Microservices, AWS, Graph Database",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will conduct some of the most complex and vital work critical to the engineering department. You will help GutCheck diversify our technology, ensuring our competitive advantage in the marketplace and thereby creating value for the company, including high impact projects such as automation, platform development, and big data integration.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a collaborative senior backend engineer to design, build and deploy solutions to complex problems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Someone who is energized by mentoring and teaching others.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Has professional experience with REST APIs, Machine Learning, Graph Database and NoSQL, MongoDB is a plus.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Comfortable developing test strategies, designing automation frameworks, can write unit/functional tests to drive up code coverage and automation metrics.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Create high-level architectural specifications, frameworks and initial proofs of concept, as well as help teams execute the design and adjust plans as necessary.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "For more information on the company and the GutCheck team, please go to www.gutcheckit.com",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "This job description is not a complete list of your qualifications or position roles.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "GutCheck is proud to be an equal opportunity employer. We are committed to equal opportunity regardless of race, color, ancestry, religion, gender, gender identity, genetic information, parental or pregnancy status, national origin, sexual orientation, age, citizenship, marital status, disability, or Veteran status.",
            "intent": "job_description"
