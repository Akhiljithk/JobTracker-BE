          },
          {
            "domain": "default",
            "utterance": "WHAT ARE YOUR RESPONSIBILITIES:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding the client’s business use cases and technical requirements and be able to convert them into technical design which elegantly meets the requirements",
