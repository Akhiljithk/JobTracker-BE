            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "We are looking for an experienced and passionate WordPress Developer to join our IT team! As a WordPress Developer at our company, you will be responsible for both back-end and front-end development, including creating WordPress themes and plugins.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Duties and Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Meeting with clients to discuss website design and function.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Designing and building the website front-end.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Creating the website architecture.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Designing and managing the website back-end including database and server integration.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Generating WordPress themes and plugins.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Conducting website performance tests.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Troubleshooting content issues.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Monitoring the performance of the live website.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required Experience, Skills and Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor’s degree in Computer Science or a similar field.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proven work experience as a WordPress Developer for 1 to 3 years.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of front-end technologies including CSS3, JavaScript, HTML5, jQuery, & PHP.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of code versioning tools including Git, Mercurial, and SVN.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience working with debugging tools such as Chrome Inspector and Firebug.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good understanding of website architecture and aesthetics.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to project manage.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good communication skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
