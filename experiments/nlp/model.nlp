            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "As an Axelerant JavaScript Developer II, you would be designing and implementing the look and feel of websites and related materials by creating sitemaps, wireframes, and visual design comps for internal and client-facing web projects. Additionally, you’ll design for multiple devices and interactions (such as desktops, touch devices like smartphones and tablets, and simpler devices like feature phones).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The JavaScript Developer II at Axelerant has a broad domain grounding and produces quality results for sizeable tasks in a project team. They are comfortable with their preferred domain and frameworks while composing outcomes medium complexity using modern methodologies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "JavaScript Developer II are confident communicators internally and with clients. They are still learning more in-depth on the domain side while gaining confidence in sharing their knowledge to help others. Upon reaching JavaScript Developer II, their project work is fully billable.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The JavaScript Developer II at Axelerant could progress to a Senior Engineer role within three years.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrate robust front-end design and development with a passion for pleasing user experiences.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with designers to translate designs and wireframes into high-quality code.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Analyze needs plus identify gaps and ambiguities in requirements.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with architects and designers to solve small-to-medium features, including analyzing requirements, technical design, development, and launch.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop unit and automated integration tests that give the team confidence to deploy to production systems on a predictable cadence.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Be proactive in communication with team members.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with scrum team members to review and understand incoming work items and estimate time appropriately, with minimum guidance from mentors as and when required.",
