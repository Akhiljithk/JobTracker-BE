          {
            "domain": "default",
            "utterance": "Job Category:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Idaptive was recently acquired by CyberArk, the global leader in privileged access management. Together, CyberArk and Idaptive will deliver the industry’s only modern identity platform with a security-first approach.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our comprehensive SaaS solution runs primarily on Amazon AWS and provides a multi-tenant, highly scalable environment, spanning multiple regions, and leveraging a wide range of Amazon’s AWS technologies (Traditional, Container based and Serverless).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Idaptive is looking for talented, motivated individuals who would like to help us design, build, support the next generation of integrated software solutions as we redefine security from a legacy static perimeter-based approach to protecting millions of scattered connections in a boundaryless hybrid enterprise!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our software runs on public clouds with 99.9% or better uptime and is mission critical for our customers. Our cloud operations team is where the rubber meets the road and needs innovative SREs. Join a professional team of smart and hard-working professionals building enterprise-class cloud-based services in the rapidly growing market of Identity and Access Management.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a DevOps Engineer, you’ll be part of the Cloud Operations team. Together with the team you’ll be responsible for maintaining, monitoring and alerting on our application uptime, and manage deployment and escalations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "RESPONSIBILITIES:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Support mission critical customer facing production environments",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Improve our CI/CD pipeline for reliability and scalability",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Improve our cloud infrastructure (AWS), monitoring and overall stability of our platform",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Work closely with release engineering to support, deploy, maintain, and troublehshoot our CI/CD pipeline",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· 50% of your time should be spent automating the deployment pipeline to self-manage and self-heal and the other 50% of your time dealing with software deploy, incidents response, on-call duty and manual intervention",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Participate in on-call rotation for 24x7 support",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "REQUIREMENTS:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· B.S. or higher degree in Computer Science or other technical discipline, or related practical experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· 3+ years professional SRE/DevOps experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· 2+ years experience in public clouds (AWS highly preferred)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· 2+ years experience with CI/CD pipeline automation preferable in AWS",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Strong experience with CI/CD and Infrastructure-As-Code tools such as Salt, Puppet, Chef, Jenkins, BitBucket, TerraForm, Consul, Vault.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Strong understanding of containerization technologies like Docker, Kubernetes, ECS, EKS.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Strong understanding and knowledge of modern monitoring and logging tools such as ELK stack, Nagios, Prometheus, Grafana, AWS CloudWatch.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Proficient in managing Windows and Linux servers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Familiar with AWS ecosystem including ES, RDS, S3, ELB, ElastiCache/Redis, CloudTrail, GuardDuty, Inspector",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Scripting skills (Python, PowerShell, Bash)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Experience with database and caching (RDS Postgres, ElastiCache/Redis)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Excellent communication and documentation skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Attention to detail, ability to multi-task, and strong interpersonal skills required.",
            "intent": "job_description"
          },
          {
