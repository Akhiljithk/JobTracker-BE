        "en",
        "Minimum 2 years of relevant technical lead experience"
      ],
      [
        "en",
        "5+ years of relevant experience in at least one object oriented language (Java, Python or Scala preferred)"
      ],
      [
        "en",
        "5+ years of relevant experience in SQL and comfortable working with large datasets to identify insights"
      ],
      [
        "en",
        "Good knowledge of Data Science, Machine Learning"
      ],
      [
        "en",
        "Experience with open source big data technologies (MapReduce, Spark, Flink)"
      ],
