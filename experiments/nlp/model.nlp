            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "6-8 years of experience on advanced C#, .NET, .NET Core, WebAPI, Unit Testing (Nunit/Xunit), XML, LINQ , design patterns with minimum 1 year of experience in Azure and cloud development.",
            "intent": "job_description"
