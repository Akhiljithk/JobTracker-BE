          {
            "domain": "default",
            "utterance": "iOS Developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "About Company:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "PayU is the payments and fintech business of Prosus, a global consumer internet group and one of the largest technology investors in the world. Operating and investing globally in markets with long-term growth potential, Prosus builds leading consumer internet companies that empower people and enrich communities.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The leading online payment service provider in 36 countries, PayU is dedicated to creating a fast, simple and efficient payment process for merchants and buyers. Focused on empowering people through financial services and creating a world without financial borders where everyone can prosper, PayU is one of the biggest investors in the fintech space globally, with investments totalling $700 million- to date. PayU also specializes in credit products and services for emerging markets across the globe. We are dedicated to removing risks to merchants, allowing consumers to use credit in ways that suit them and enabling a greater number of global citizens to access credit services.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our local operations in Asia, Central and Eastern Europe, Latin America, the Middle East, Africa and South East Asia enable us to combine the expertise of high growth companies with our own unique local knowledge and technology to ensure that our customers have access to the best financial services.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "India is the biggest market for PayU globally and the company has already invested $400 million in this region in last 4 years. PayU in its next phase of growth is developing a full regional fintech ecosystem providing multiple digital financial services in one integrated experience. We are going to do this through 3 mechanisms: build, co-build/partner; select strategic investments.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "PayU supports over 350,000+ merchants and millions of consumers making payments online with over 250 payment methods and 1,800+ payment specialists. The markets in which PayU operates represent a potential consumer base of nearly 2.3 billion people and a huge growth potential for merchants.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Roles and Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will develop the code that improves our overall iOS mobile customer experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work alongside other partners (such as Product Managers, Designers, UX/UI and QA) to build and ship features that go into the main application.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Rapidly add new functionality, tackle complex problems, and ship defect free code at a rapid pace",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with other developers across PayU to ensure we're using the right methodologies and practices",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Help build our technical execution plans and ensure we hit all expectations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications and Experience:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2+ years of hands-on experience in swift (primary) and objective-c.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Hands on experience in designing and developing applications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Having Command on iOS SDK using latest tools Xcode.",
            "intent": "job_description"
          },
