          },
          {
            "domain": "default",
            "utterance": "To excel at Simform, you should be excited to work at a fast-growing technology company with a culture of opportunities. We’re looking for someone who will take advantage of the opportunity for personal development and increased responsibility that a fast growing company offers. Ideally, you are confident in your abilities, are positive and personable, and always looking for new and creative ways to get things done and serve our customers better.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a mobile developer to bring the best of our apps to iOS devices. Your primary focus will be to develop and maintain iOS apps in integration with the back-end services. With your host of expertise, you shall contribute to intuitive design, aesthetics and the best user experience of the app.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design and development of professional business applications for the iOS platform.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Your leadership will help to continuously discover, evaluate, and implement new technologies to improve development efficiency.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborate with multi-functional teams to define, design, and ship new features in a dynamic work environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will work with external data sources/ APIs, unit-test code for robustness, including edge cases, usability, and general reliability.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Will work on fixing bugs and improving application responsiveness, quality and performance.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Your leadership will help to continuously discover, evaluate, and implement new technologies to improve development efficiency.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirement:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient with Objective-C or Swift",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with macOS app development and watchOS app development will be a plus.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experienced with iOS frameworks viz. Core Data, Core Animation, Core Graphics and Core Text",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Deep understanding of Apple’s design principles and interface guidelines",
