            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Implement fundamental design principles behind a scalable application.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work on multiple delivery platforms, such as mobile, desktop, and optimize output to match the specific platform.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Create database schemas that represent and support business processes.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Implement automated testing platforms and unit tests.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Be proficient in the frameworks available for Node.js such as Express, StrongLoop, etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage asynchronous programming and its quirks and workarounds.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Handle projects related to server-side templating languages such as Jade, EJS, etc. or CSS preprocessors such as Stylus, Less etc. efficiently.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Have some basic understanding of front-end technologies, such as HTML5, and CSS3.",
