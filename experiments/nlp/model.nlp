          {
            "domain": "default",
            "utterance": "Software Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "We're changing the way enterprises think about Security. Our goal is to be the leading cloud security and analytics platform globally. It's time for smart cloud/web security, we innovate the way security is done, i.e. that we provide a cloud-based service as opposed to traditional on-prem solutions. Our patented Cloud XD technology eliminates blind spots by going deeper than any other security provider to quickly target and control activities across thousands of cloud services and millions of websites. With full control from our cloud, our customers benefit from 360-degree data protection that guards data everywhere and advanced threat protection that stops elusive attacks. At Netskope, we call this smart cloud security.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Netskope is the leader in cloud security. We believe that people and companies should be able to collaborate without limits, working safely across the cloud, web, devices, and locations. Our corporate leadership is clear, open, and honest, leaders share what's happening in the company, and all employees make a big impact. Recognized as a leader in Gartner's Magic Quadrant, on Glassdoor and Fortune Magazine as one of the top 100 cloud companies in the world, and as one of the three fastest-growing cybersecurity companies, Netskope is a fast-moving company built to be the strategic enterprise security partner for a long time to come. Netskope is headquartered in Santa Clara, California. Visit us at www.netskope.com and follow us on Twitter@NetskopeandFacebook.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Within Netskope Engineering department, Security Services organization is responsible for building core security products and features, such as Data Loss Prevention, Malware and Threat Prevention, Cloud Confidence Index, Breach and Anomaly Detection. We apply Artificial Intelligence and Machine Learning technologies across Netskope cloud security platform. We are looking for talented software engineers to join a newly created security efficacy engineering team. A successful candidate has deep technical expertise in malware detection, URL filtering, web security, threat modeling, and SaaS/IaaS security product development. You will have the opportunity to work with a team of talented engineers, researchers and data scientists to solve the most challenging cloud security problems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Discover , analyse and provide mitigation for latest security threats and malware.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Design, develop, test and productize security content updates across multiple security product lines.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure continuous high efficacy on all Netskope products, through well designed internal testing and collaboration with 3rd-party testing agencies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Respond to customer escalations. Cover latest threat discovered. Ensure the detection of Netskope threat protection.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work closely with data scientists, threat researchers, software engineers and QE engineers ensure our solutions deliver continuous security values to end customers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Be an evangelist of secure SDLC within the company.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborate with data analytics team to define new platform requirements and continuously improve our horizontally scalable data lake.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications/Requirements:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "First of all, must have true startup spirit. Be willing to wear multiple hats and deliver end-to-end.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability of thinking out-of-box and evaluating results based on customer value.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in developing security content updates (e.g. Yara), threat response, and working with threat intelligence feeds.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Industry experience in at least one of the following fields: modern malware detection technologies, URL filtering, IDS/IPS, ML-based anomaly detection technologies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Threat research and reverse engineering experience highly desirable.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Data mining and machine learning experience highly desirable.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient in at least one of these programming languages: Python, Java, C/C++.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Working knowledge of SQL and NoSQL databases.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Working knowledge of big data platform highly desirable.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Energetic self-starter, with the desire to work in a dynamic fast-paced environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent verbal and written communication skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to influence without authority.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "BS in Computer Science or equivalent technical degree required, MS preferred",
            "intent": "job_description"
          },
