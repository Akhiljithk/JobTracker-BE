            "domain": "default",
            "utterance": "Hewlett Packard Enterprise (HPE) advances the way people live and work. We bring together curious minds to create breakthrough technology solutions, helping our customers make their mark on the world.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "HPE Global IT is immediately seeking a DevOps Engineer.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Overview: Do you consider yourself a software engineer and leader with a tenacious attitude? Are you someone who can jump in and contribute to a dynamic team environment. Are you passionate about development, automation, and container technologies?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The DevOps Engineer will be part of the Global IT’s Cloud Services team in the Infrastructure and Operations organization and will report to the Sr. Manager of Cloud Services. The ideal candidate will have a demonstrated experience in software engineering, cloud native technologies DevOps automation frameworks, and architecture / deploying and managing CI/CD pipelines.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requirements:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to execute on multiple projects as an engineer with internal and outsourced partners responsible for all stages of design and development for the supported platforms. Responsibilities includes solution design, analysis, coding, testing, documentation, integration and operations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Drive innovation and integration of new technologies into projects and activities in the Global IT organization.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Champion DevOps best practices, including improved scalability, performance, reliability, and speed to market",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Professional software engineering experience in integration areas including container orchestration, authentication & authorization, micro-services architectures, distributed object storage software, image repositories, and configuration management.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "DevOps experience with CI/CD pipelines, automated testing platforms, site reliability engineering, and chaos monkey testing.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Software expertise in distributed systems and services models – REST-based services – as well as integration with 3rd party web services, orchestration systems, control and management planes",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Highly motivated and ability to provide self-directed execution",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge and Skills:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with containers, and micro-services in a production environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with API-driven integration across multiple sub-systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience defining robust APIs and providing implementations using a micro-services architecture model.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with a modern, CI/CD implementations (Jenkins, CircleCI, Gitlab CI, etc.)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with a Secret Management platforms (Hashicorp Vault)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2-5 years development experience with Python, Node or Go (or C#, C++, C, Java, JavaScript) or similar programming languages",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2-5 years of experience in designing, building and supporting (in DevOps fashion) multi-tenant software platforms.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must have Linux or Unix software development expertise",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in automating large-scale deployments with modern tools (Ansible, Ansible Tower, Chef, Puppet).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with various container run-times and orchestration platforms (Docker, Containerd/cri, Swarm, K8s, Mesos).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with container registries (DTR/Jfrog/Harbor) and how to manage security/governance for docker containers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Great verbal and written communication skills and ability to effectively communicate product architectures and design proposals.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrated ability to collaborate across teams and larger organization.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent analytical and problem solving skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor’s degree in Computer Science (or related field and a minimum of 2 years of related experience) or 5+ years of equivalent working experience.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Soft Skills:",
            "intent": "job_description"
          },
          {
            "domain": "default",
