            "utterance": "Strong knowledge and experience working with HTML5, CSS3",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with mobile and responsive web design",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with cross-browser compatibility issues and ways to work around such issues.",
            "intent": "job_description"
