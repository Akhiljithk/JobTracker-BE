            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": ">Experience in writing power shell, python scripts required for CI/CD.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": ">Experience on Nagios integration.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": ">Strong appetite for security, availability, scalability, performance, extensibility and maintainability.",
            "intent": "job_description"
