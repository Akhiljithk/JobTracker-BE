            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Take responsibility for managing our master data set, developing reports, and troubleshooting data issues. To do well in this role, you need a very fine eye for detail, experience as a data analyst, and a deep understanding of the popular data analysis tools and databases.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Specific Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Managing master data, including creation, updates, and deletion;",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Helping develop reports and analysis;",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Managing and designing the reporting environment, including data sources, security, and metadata;",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Supporting initiatives for data integrity and normalization;",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Assessing tests and implementing new or upgraded software and assisting with strategic decisions on new systems;",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Troubleshooting the reporting database environment and reports;",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Training end-users on new reports and dashboards;",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Providing technical expertise in data storage structures, data mining, and data cleansing.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Degree in IT, Computer Science or Engineering, Statistics, Applied Mathematics or Business Analytics and related fields;",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "5 to 7 years of work experience in data analytics and data virtualization field;",
            "intent": "job_description"
          },
