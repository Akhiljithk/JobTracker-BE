          {
            "domain": "default",
            "utterance": "JavaScript Developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a Full-stack Javascript Developer to help us build medium to large-scale, high performance web applications. Your primary focus will be the development of all server-side logic, definition and ensuring high performance and responsiveness to requests from the front-end. You will also be responsible for developing front-end elements using various Javascript frameworks like React.js, Angular.js, Node.js. Therefore, hands-on experience on front-end technologies (including HTML, CSS) from ground up is critical as well.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Skill Requirements:",
            "intent": "job_description"
          },
          {
            "domain": "default",
