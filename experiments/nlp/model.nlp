      ],
      [
        "en",
        "3. Translating designs and wireframes into high quality code"
      ],
      [
        "en",
        "4. Optimizing components for maximum performance across a vast array of web-capable devices and browsers"
      ],
      [
        "en",
        "1. Strong proficiency in JavaScript, including DOM manipulation and the JavaScript object model"
      ],
      [
        "en",
        "2. Thorough understanding of React.js and its core principles"
      ],
      [
        "en",
        "3. Experience with popular React.js workflows (such as Flux or Redux)"
      ],
      [
        "en",
        "4. Familiarity with RESTful APIs"
      ],
      [
        "en",
        "5. Knowledge of modern authorization mechanisms, such as JSON Web Token 6. Familiarity with modern front-end build pipelines and tools"
      ],
      [
        "en",
        "7. Experience with common front-end development tools such as Babel, Webpack, NPM, etc."
      ],
      [
        "en",
        "8. Ability to understand business requirements and translate them into technical requirements 9. Familiarity with code versioning tools like GIT 10. Good understanding on Agile and waterfall development process"
      ],
      [
        "en",
        "11. Knowledge on TDD and should have worked in SCRUM teams"
      ],
      [
        "en",
        "12. Fundamentally strong in computer science and should be aware of the latest development trends"
      ],
      [
        "en",
        "13. Quality conscious and should seek for continuous improvement"
      ],
      [
        "en",
        "14. Able to present the solutions to the team and do detailed code reviews"
      ],
