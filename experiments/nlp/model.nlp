          },
          {
            "domain": "default",
            "utterance": "What you do at AMD changes everything",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At AMD, we push the boundaries of what is possible. We believe in changing the world for the better by driving innovation in high-performance computing, graphics, and visualization technologies – building blocks for gaming, immersive platforms, and the data center.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Developing great technology takes more than talent: it takes amazing people who understand collaboration, respect, and who will go the “extra mile” to achieve unthinkable results. It takes people who have the passion and desire to disrupt the status quo, push boundaries, deliver innovation, and change the world. If you have this type of passion, we invite you to take a look at the opportunities available to come join our team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What you do at AMD changes everything",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At AMD, we push the boundaries of what is possible. We believe in changing the world for the better by driving innovation in high-performance computing, graphics, and visualization technologies – building blocks for machine learning, gaming, immersive platforms, and the data center.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Developing great technology takes more than talent: it takes amazing people who understand collaboration, respect, and who will go the “extra mile” to achieve unthinkable results. It takes people who have the passion and desire to disrupt the status quo, push boundaries, deliver innovation, and change the world. If you have this type of passion, we encourage you to look at the opportunities available to come join our team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Machine Learning Performance Engineer",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "AMD is seeking an expert at machine learning with background in frameworks such as Pytorch/TensorFlow, and machine learning workloads. The successful candidate will have a passion for machine learning algorithms, and understand the mapping of the machine learning workloads (such as CNNs, Transformer, BERT, recommendation models) on CPU/GPU architecture. This is a highly visible position with opportunity to work closely with teams across AMD and impact MLPerf optimizations on AMD hardware and software architectures.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will have the opportunity to:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Define next generation algorithmic and software optimizations for machine learning training by conducting in-depth performance analysis of workloads and presenting the design and implementation choices.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with internal AMD teams and external customers to understand and develop software optimizations at machine learning frameworks level such as Pytorch/Tensorflow.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Drive development, product definitions, and customer interactions that lead to the development of AMD best-in-class machine learning platforms.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop machine learning software optimizations specific to AMD GPU platforms.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The best applicant will have:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "MS or equivalent experience in a field associated with machine learning algorithms and frameworks; candidates with additional experience in architecture would be given preference",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Expertise with Pytorch/TensorFlow",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with standard machine learning models such as ResNet50, Transformer, SSD, BERT, DLRM and Reinforcement Learning",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with performance tools such as nvprof, and rocprof",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Familiarity with large scale execution of machine learning models on clusters connected with Ethernet/InfiniBand",
            "intent": "job_description"
          },
