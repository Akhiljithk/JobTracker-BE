          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a Senior / DevOps Engineer to take part in the development of our communication platform. You will be part of the Engineering team based in Jakarta, responsible for automated deployments, ensuring highest reliability and scalability of our production services and efficiently managing our cloud platform infrastructure.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Cloud Engineering, Architecture Strategy and Planning, especially for GCP and AWS Cloud, but on Kubernetes. Design cloud solutions that ensure most sustainable, flexible and cost appropriate solutions & technology platforms.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Support the development of complex enterprise architectures for computing architecture, architecture reviews, and selection efforts.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Find solutions to problems that disrupt availability, performance and stability of our systems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Use automation tools like cloud formation, terraform to automate the process. At the same time, make infra as a code so that they can be consumed by CI/CD.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Suggest ways to improve and reduce operational costs with adaptive performance tuning.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Continue to expand knowledge of industry trends, applying that knowledge by evaluating fit to the organization.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Key areas of work:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "1. Infrastructure Service Management",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Plan, track, review and monitor, schedule and project issues related to infrastructure services",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provide Planning for infrastructure hardware, software deployment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2. Infrastructure Solutions Deployment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure infrastructure setup are compliant with best architecture standards and information security policies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Review infra design architecture (database, system interfaces, network, middleware, platform)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure the robustness and resiliency of the system architecture design.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3. Infrastructure Implementation Services",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage and deploy infrastructure services to DEV/SIT/UAT/DR/PROD environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure infrastructure delivered in projects are operationally ready",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Expert in Kubernetes with hands-on experience of min 2-3 years on, with creating cloud architecture from scratch across any cloud platform, AWS / GCP. CKA Certification will be a huge plus.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At least 5 years of experience working with large scale (enterprise) and moderately complex IT architecture (catering at least > 1 million users)",
