        "Strong skills with Python"
      ],
      [
        "en",
        "Experience in working with large data sets and pipelines, distributed systems for machine learning using frameworks such as Apache Spark"
      ],
      [
        "en",
        "Experience in building Machine Learning models and experience using libraries such as scikit-learn, pandas, tensorflow, keras, etc."
      ],
      [
        "en",
        "Experience in technologies like Spark, Hadoop, Kafka"
      ],
      [
        "en",
        "Take end-to-end ownership of Machine Learning systems - from data pipelines and training to the realtime prediction engine"
      ],
