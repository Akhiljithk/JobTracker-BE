          {
            "domain": "default",
            "utterance": "Who we are?",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are searching for outstanding web/mobile developers to be responsible for developing innovative, reusable Mobile-based tools for progressive online activism and community building. Our mobile developers work closely with our project managers, strategists and design team members to develop specifications and make recommendations on the use of new and emerging technologies. Programming, graphic design and database administration are all elements of this position.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work closely with Project Managers and other members of the Development Team to both develop detailed specification documents with clear project deliverables and timelines, and to ensure timely completion of deliverables.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Attend client meetings during the sales process and during development.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with clients and Project Managers to build and refine graphic designs for websites.",
            "intent": "job_description"
