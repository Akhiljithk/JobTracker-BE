          {
            "domain": "default",
            "utterance": "Develop and maintain robust data processing pipelines and reproducible modelling pipelines",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Build mathematical models to solve various problems ranging from Time Series forecasting to Neural Networks and ensure seamless deployment in production pipelines.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Explore data and communicate insights clearly to non-technical as well as technical audience",
            "intent": "job_description"
