            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "· Performing all backend development of the website using the following skills like Web API, HTML5, CSS, JavaScript, JQuery, SQL Servers, and knowledge of Entity Framework.",
            "intent": "job_description"
          },
