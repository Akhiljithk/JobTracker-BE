            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Based in Silicon Valley, Tintri is a wholly owned subsidiary of DataDirect Networks (DDN), the data-at-scale powerhouse and world’s largest privately held storage company. Tintri solutions serve the needs of enterprise data centres with intelligent infrastructure. Our product portfolio includes advanced technologies from Tintri (acquired September 2018), Nexenta (acquired May 2019), and IntelliFlash (acquired from Western Digital November 2019). This portfolio offers a fresh choice and a new experience to elevate your user experiences through automation, analytic insight, and tight integration with application workflows for your enterprise applications, including mission-critical databases and business applications, virtualization, and flexible software defined solutions. Learn more about the Tintri portfolio of solutions at https://www.tintri.com/products",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Tintri is looking for motivated and passionate individuals that are self-motivated in their work and careers but we are valuing and thriving in an environment where collaboration and teamwork are at best. We are all together on a quest to provide game changing storage solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with a global team of stakeholders to understand requirements and define the product release and QA strategy.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Review solution requirements from a quality assessment point of view and participate in feature test scoping coverage",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Plan and drive high quality products validation plans. Prepare test data, execute tests, and review/evaluate results.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Drive Test scoping of new features with input from development, product management, and test engineering",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop use cases to ensure all functional and feature test requirements are captured during the design and development phase",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Define and maintain verification jobs through continuous integration tool",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Act as technical leader and mentor for the QA team members to lead the implementation of QA automation systems, processes and tests.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Functional and performance metrics analysis on storage software and infrastructure products",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Support appropriate technical meetings/scrums and message progress/status/concerns",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Skills and Experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "8 years of test development, at least 5 years and experienced python3 threading, multiprocessing and async modules with strong knowledge of parallelism and concurrency, at least 2 years distributed programming on distributed systems, storage clusters (not just using LUN’s. / using storage as an end user)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong grasp and experience in SW test design, execution, automation and metrics.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong knowledge in software and scripting in Python and C particularly for Linux/UNIX computing environments.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experiences must include some of the following: traditional storage protocols (e.g. CIFS/NFS/iSCSI), work with data storage concepts such as RAID, SCSI, FC, and file systems; designing, developing, executing, and maintaining test cases and procedures; applying QA lifecycle methodologies for white box, black box, functional, combinatorial testing.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Very good written/verbal communication skills in English.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Minimum of BS or MS; computer engineering, computer science or related technical field.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experiences with testing management tools (i.e. JIRA and Rally).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experiences with Git, Gerrit and Jenkins and Agile software development tools and process are a plus.",
            "intent": "job_description"
          },
