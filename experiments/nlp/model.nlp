            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Coordinate and develop all EDI data mapping into SQL database.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Provide testing and data validation of all EDI transaction interfaces.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Investigates and resolves increasingly complex problems including providing support for production systems in a timely manner.",
