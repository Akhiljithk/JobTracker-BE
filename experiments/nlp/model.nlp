          },
          {
            "domain": "default",
            "utterance": "Bachelor's degree in Computer Science or equivalent",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "5+ years of Java and Spring development experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In depth knowledge of design patterns, data structures and OO design",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience of building production quality, highly available services and designing service oriented architectures",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proven experience designing and building Restful APIs and Microservices architecture",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Unit and integration test development experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Document (NoSQL) or relational database experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience building message driven systems, use of Kafka",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience working as a full-stack engineer will be an added advantage.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good interpersonal skills and be an excellent teammate",
            "intent": "job_description"
          },
          {
            "domain": "default",
