            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2 years of experience in the Ads industry, risk and fraud investigation, Internet industry, or similar.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Familiarity in one or more of the following areas: statistical analytical tools (R, SPSS, SAS) and coding (C/C++, Python, Java).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding of how the Internet works economically, socially, and technically.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Demonstrated ability to identify workflow pain points, and optimize and scale processes.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent communication skills, and the ability to be comfortable interacting with internal and external users.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Interest in innovation, technology and Google products.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "About the job",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Trust & Safety team members are tasked with identifying and taking on the biggest problems that challenge the safety and integrity of our products. They use technical know-how, excellent problem-solving skills, user insights, and proactive communication to protect users and our partners from abuse across Google products like Search, Maps, Gmail, and Google Ads. On this team, you're a big-picture thinker and strategic team-player with a passion for doing what’s right. You work globally and cross-functionally with Google engineers and product managers to identify and fight abuse and fraud cases at Google speed - with urgency. And you take pride in knowing that every day you are working hard to promote trust in Google and ensuring the highest levels of user safety.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "On this team, you will focus on restricting or preventing policy violations and abuse to ensure a safe and secure Ads environment for our users. You will identify and solve complex problems, and innovate and optimize our processes and tools. You will also work with product and engineering teams to make sure that new products and features provide an excellent, safe experience for users.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "At Google we work hard to earn our users’ trust every day. Trust & Safety is Google’s team of abuse fighting and user trust experts working daily to make the internet a safer place. We partner with teams across Google to deliver bold solutions in abuse areas such as malware, spam and account hijacking. A diverse team of Analysts, Policy Specialists, Engineers, and Program Managers, we work to reduce risk and fight abuse across all of Google’s products, protecting our users, advertisers, and publishers across the globe in over 40 languages.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Prevent spam and abuse by identifying trends and products that aren't in line with policies in Google Ads. Perform statistical data analysis and identify patterns and trends.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Use technical knowledge to drive and implement identified automation projects, and provide an excellent experience to users by ensuring the product data provided to Google is accurate, up-to-date, and compliant with defined quality standards and policies.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborate with Engineering and Product teams to create and enhance tools, develop signals, system functionality, and robust reporting framework which will enhance the experience of our users/customers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Lead projects through the full project lifecycle and manage operations programs, working closely with Google engineers, product managers and vendor operations to develop and track project schedules and timelines.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Respond to escalations from internal and external parties within designated service levels.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Google is proud to be an equal opportunity workplace and is an affirmative action employer. We are committed to equal employment opportunity regardless of race, color, ancestry, religion, sex, national origin, sexual orientation, age, citizenship, marital status, disability, gender identity or Veteran status. We also consider qualified applicants regardless of criminal histories, consistent with legal requirements. See also Google's EEO Policy and EEO is the Law. If you have a disability or special need that requires accommodation, please let us know by completing this form.",
            "intent": "job_description"
          },
