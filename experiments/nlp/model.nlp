          {
            "domain": "default",
            "utterance": "Java Developer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "- As a java software engineer, you will be part of an elite and talented software team that designs, develop and deploy high end software solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "About TBM Technologies Pvt Ltd",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Established in 2006, we are a research-driven 'machine-to-next' technology company. In 2018, we were recognized as the 'Telecom Technology Company of the Year - India'. We were named 'Most Innovative Software Development Company - India in 2017' and 'Best Telecom Software Company - India'. Other awards include being named among the '20 Most Promising Software Development Companies' and recognition by GSMA at the Mobile World Congress 2011. Our smart solutions enhance lifestyles and save lives, by enabling more effective communications.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "With our proprietary software and technologies, we deliver solutions to telecom operators, including Airtel, Dialog Axiata, Verizon Wireless, Vodafone, and Idea. A dedicated research team focuses on next-generation solutions with sensors, smart devices, location 5.0 technology, multi-lingual multi-modal communication, omnichannel delivery platforms, cloud technologies, virtualization, rack servers, mobile phones, analytics, machine learning, and IoT.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsibilities and Duties",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "1. Build next-generation, enterprise grade, high performance scalable applications and services.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "2. Work on Core Java, JSP, WEBSERVICES, SERVLET 3+, STRUTS 1.3.8 & 2+, EJB 3.0, HIBERNATE, JMS, JAVA SCRIPT, SPRING 3+ and 4+ and XML.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "3. Utilize Agile and other advanced methodologies to document, design, develop, deploy and maintain java applications, services and solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "4. Staying up to date by learning new java frameworks, technologies and software.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "5. You will be empowered to express your opinion to help shape the design of the product or solution.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "6. Creating products or solutions that will involve you from design to completion.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "7. You will be part of several initiatives that help people and save lives on a very large scale across many countries.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "8. Some prior training courses in Java and J2EE.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "9. Strong knowledge of Core Java.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "10. Should have knowledge of ANY of the J2EE Frameworks, and J2EE skills (Spring 3 or higher, Hibernate, Servlets, STRUTS, EJB 3.0, Java Security, and JMS)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": ". Should have good analytical and troubleshooting skills, Self-Learning, motivated, and disciplined attitude., High level of logic and reasoning skills., Good verbal and written communication skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Required Experience and Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor's / Master's degree in Computer Science from a reputable university or related field or equivalent military or industry experience.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Type: Full-time",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience:",
            "intent": "job_description"
          },
          {
