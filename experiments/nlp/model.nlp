          },
          {
            "domain": "default",
            "utterance": "UWorld is a worldwide leader in online test prep for college entrance, undergraduate, graduate, and professional licensing exams throughout the United States. Since 2003, over million students have trusted us to help them prepare for high-stakes examinations.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are seeking a WordPress Specialist who enjoys taking on new challenges and is passionate about designing and building attractive and functional websites that meet the specifications of our end-users and stakeholders. The WordPress Specialist will be responsible for UI design and front-end development, being mindful of user experience and site integration as it pertains to our various Test Prep products.",
            "intent": "job_description"
          },
