            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to communicate, both verbally and written, with a high level of confidence",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Travel < 20% of the year",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "MS Office skills with focus on Visio, Word and Excel",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Education and Experience:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "College degree or comparable certification in IT, telecommunications, computer science, or related field preferred.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Minimum seven years of experience required in design, planning, coordination and implementation of technology projects.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must be experienced in the troubleshooting of complex multi-vendor geographically separated networks.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience in administrating authentication controls (Radius, RSA/SecureID and TACACS+) in the enterprise.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with implementing and maintaining encryption techniques and standards (3DES, PKI, MD5, SSH, SSL), in a client and site-to-site configuration.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must have operational level knowledge and experience in the deployment and maintenance of service provider network routing architectures using protocols such as OSPF, BGP, EIGRP, and RIP.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Expert knowledge in implementing and supporting switched networks, including (VTP, STP, HSRP, trunking, VLANs, port security and monitoring) in a multi-vendor environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding of logical network design including: DMZs, WANs, and client connectivity solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Requires an in-depth knowledge of TCP/IP and communication protocols in LAN / MAN / WAN environments.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Must be thoroughly proficient in the following protocols/technologies:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Route manipulation (Redistribution, Summarization, Route filtering and Policy Routing), VPN (client and site-to-site), Ethernet Switching: ( IOS, Junos switch configurations, VLANs/Trunking, Spanning Tree, HSRP/VRRP), IOS features: (PAT ,NAT, SNMP, Net Flow, QoS), Security server protocols (SCP, SFTP, HTTPS, etc.), Traffic filtering, Access lists, Radius, Tacacs+, IOS VPN, IPsec, Pix/ASA firewalls, Checkpoint firewalls, IDS/IPS, VPN Concentrators, Solarwinds Orion & NCM, Cisco Routers(ASR, 2900,3900, …), Catalyst 6500, 4500, Nexus, and other model switches, Citrix Netscaler and F5 load balancers/GTM, Infoblox DNS, Cisco Nexus & Juniper switches and routers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Engineer should have knowledge on one of the cloud technologies either AWS, or Azure.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Automation scripting knowledge on tools like Phyton & Ansible is an added asset.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Engineer should have",
            "intent": "job_description"
          },
          {
            "domain": "default",
