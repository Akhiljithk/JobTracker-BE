          {
            "domain": "default",
            "utterance": "DevOps Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "As an industry leader and Software-as-a-Service provider our mission at 8x8, Inc. (NYSE:EGHT) is to transform the future of business communications. The 8x8 Open Communications Platform (TM) uniquely brings together Voice, Video, Collaboration, Contact Center, and enterprise-class API solutions, helping businesses across the globe transform their customer and employee experience, and empowering workforces worldwide to work smarter.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "For additional information, visit www.8x8.com, or follow 8x8 on LinkedIn, Twitter, and Facebook.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are looking for a DevOps Engineer to take part in the development of our communication platform. You will be part of the Engineering team, responsible for automated deployments, ensuring highest reliability and scalability of our production services and efficiently manage our cloud platform infrastructure.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our ideal candidate is a professional with experience in automating deployments with modern configuration and deployment management systems. He/She requires a broad knowledge of systems, servers, load balancers, storages, security, networking and some background in programming. We are using cloud infrastructure (AWS), containerization, CI and CD process.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Main Responsibilities:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Automate builds, deployments and other aspects of release lifecycle",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Maintain and improve cloud platform infrastructure and configure auto-scaling",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Architecture and develop Docker-based infrastructure",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Find solutions to problems that disrupt availability, performance and stability of our systems",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work in conjunction with development and operations team to understand requirements for functionality, performance and security of applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Explore and maintain understanding of the internal architecture and client requirements to our applications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage the processes of deployments using blue-green deployment pattern whenever possible",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Implement the tools and processes for monitoring servers and services",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensure proper backup and restore when failure occurs",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Suggest ways to improve and reduce operational costs with adaptive performance tuning",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Investigate and develop skills in new technologies, collaborate across the company",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Desired Skills and Experience:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Computer Science degree, or equivalent experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Practical experience of building and operating platform in AWS (EC2, ECS, ELB, VPC)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experienced in Jenkins",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong experience in managing high-load and auto-scaling production environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Programming experience in any scripting language (like Python)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "7+ years of experience working on admin level with Linux and Windows",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience working with configuration management frameworks like Puppet, Chef, Ansible",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong experience in managing cluster setup of RabbitMQ, Redis, Mongodb.",
            "intent": "job_description"
          },
          {
            "domain": "default",
