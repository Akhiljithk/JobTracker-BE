            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop processes and tools to monitor and analyze model performance and data accuracy",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Translate deep mathematical concepts and practices into language that non-experts can understand and build upon. And conversely, translate business needs and user needs into language and concepts that other data scientists can understand and work with.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Productionalizing machine learning code and interfacing with industry standardmsoftware systems",
