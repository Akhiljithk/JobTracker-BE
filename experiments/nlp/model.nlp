          {
            "domain": "default",
            "utterance": "About phData",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We build next-generation strategic platforms helping customers to save money and unlock real business value for our customers and the community. If you are inspired by innovation, hard work, and a passion for data, we want to hear from you.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our Commitment – you will be working in a fast-moving environment with the brightest and most experienced minds in technology. We're committed to constant learning and innovation.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our Work – you'll be helping companies answer questions and create products that, until now, were too big, too expensive, and too complex to accomplish.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Our Technology – we focus on building and deploying disruptive big data technologies. If you have experience in or passion for Hadoop and its supporting technologies, we want to hear from you!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In addition to the phenomenal growth and learning opportunity, we offer competitive compensation and excellent perks including base salary, annual bonus, and extensive training - in addition to generous PTO, flexible hours and comprehensive Insurance cover.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Passionate about Big Data, Data Science, and Machine Learning Algorithms? Be part of a team of industry pioneering experts that operate some of the largest analytics and data science infrastructure systems at phData. Our customers apply these technologies on terabytes of data a day on petabyte-scale infrastructure.",
            "intent": "job_description"
          },
