            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "On receipt of an interview call for any job at AIG, the candidate may take some measures such as visiting the official website or career site of Airbus to get the contact details to enquire with the Human Resources department of Airbus India regarding such jobs and/or the interview details and any other relevant information.",
            "intent": "job_description"
          },
          {
            "domain": "default",
