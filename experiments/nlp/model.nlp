          {
            "domain": "default",
            "utterance": "We are an engineering firm looking for someone to work on our Laravel PHP based program that manages timesheets, work details, etc. Our current application was used to manage 150 peoples data and needs to be scaled up to be able to handle 5000 people.",
            "intent": "job_description"
          },
          {
