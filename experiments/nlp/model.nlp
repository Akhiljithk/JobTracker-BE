            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "This individual will perform the lead technical role in the implementation of AppDynamics’ Software as a Service, responsible for keeping our SaaS offering alive across all customer servers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "This person will be responsible for management of a team of DevOps Engineers, and will supervise successful delivery of service and projects. Significant technical initiatives include new and existing microservices in cloud environments to automate and shift left the typical responsibilities of operations to enable development. The environment and amount of data we’re supporting is substantial and growing exponentially year over year. For example, we have 100M+ metrics streaming in per minute into the SaaS environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Key responsibilities include:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Supervision and direction of technical resources for sophisticated operational projects, including tools and automations, hardware and software upgrades and capacity planning.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Infrastructure Automation",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Creating large company initiatives to enable development teams to quickly onboard their services",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Introduce new technology into the SaaS environment to remove dependencies on traditional operational tasks and better integrate into our Kubernetes environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Work with key AppDynamics customers to ensure they get a stable and highly available SaaS service.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Develop Key SLI’s/SLO’s to help lead and drive our team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "AppDynamics is an application performance monitoring solution that uses machine learning and artificial intelligence (AI) to provide real-time visibility and insight into IT environments. With our unique AIOps solution, you can take the right action at exactly the right time with automated anomaly detection, rapid root-cause analysis, and a unified view of your entire application ecosystem, including private and public clouds. Using AppDynamics, you’ll finally align IT, DevOps, and the business around the information that helps you protect your bottom line and deliver flawless customer experiences at scale.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "AppDynamics is headquartered in San Francisco and has a R&D center in Bangalore.",
            "intent": "job_description"
          },
          {
            "domain": "default",
