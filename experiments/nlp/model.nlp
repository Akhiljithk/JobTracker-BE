          {
            "domain": "default",
            "utterance": "Software Engineer",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "ServiceNow is changing the way people work. With a service-orientation towards the activities, tasks and processes that make up day-to-day work life, we help the modern enterprise operate faster and be more scalable than ever before.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Were disruptive. We work hard but try not to take ourselves too seriously. We are highly adaptable and constantly evolving. We are passionate about our product, and we live for our customers. We have high expectations and a career at ServiceNow means challenging yourself to always be better.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What you get to do in this role:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a Software Engineer Quality Engineering, you will be a key member of the SecOps Applications team driving the quality of our products and services to the next level. You will work within our agile software development process and have an important impact on the Security Operations Engineering team. You will have the opportunity to work with the latest technologies as well as quality testing frameworks & tools using Java, Jenkins, JUnit, Selenium and more.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "In order to be successful in this role, we need someone who has:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "4 to 6 years of experience in quality engineering and/or software application development.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong experience in working with wide variety of test automation frameworks, including Java, JUnit, Selenium, TestNG and other open-source projects.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Knowledge of continuous integration and deployment tools (e.g. Jenkins).",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience with a scripting language such as JavaScript/Python/Ruby in a Linux environment.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to create, execute and maintain scripts and tools for various testing frameworks.",
            "intent": "job_description"
          },
