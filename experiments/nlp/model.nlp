          {
            "domain": "default",
            "utterance": "Your Opportunity:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Schwab is looking for a Salesforce developer/administrator with experience working with marketing cloud in the Enterprise Marketing Technology organization. This organization manages the platforms and systems delivering capabilities to our marketing business partners.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a member of the Marketing Technology team, you will be immersed in a collaborative, innovative, and technically challenging environment. As a Salesforce Developer you will be responsible for design, development, and delivery of Salesforce artifacts. We're looking for team members that are eager to learn and implement new technologies and provide outstanding Marketing solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "What you are good at:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a Salesforce Developer you will be responsible for helping to deliver quality technology and software initiatives by:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Analyzing complex business and systems requirements and providing technical solutions to meet user requirements",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Designing and developing solutions on Salesforce Marketing platform integrating with backend systems and working closely with our development, product teams and Architects",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ensuring timely delivery of project deliverables",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Collaborating with business partners on issues",
            "intent": "job_description"
          },
          {
