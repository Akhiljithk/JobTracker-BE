          },
          {
            "domain": "default",
            "utterance": "PRIMARY FUNCTION: State the primary function or overall purpose of your position.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Data Science Manager is responsible for delivering tools and solutions for business analysis and strategic planning using various Data Science techniques and approaches.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "This position requires excellent knowledge of statistics and mathematics to be utilized on databases and generate actionable insights for the business.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will work closely with senior leaders; designing and delivering key metrics and insights. This position also demands strong business acumen, stakeholder management and sound application of analytics concepts.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "This position is a part of a team of analysts that supports Electrical Sector – Americas. Its primary responsibility is to identify growth opportunities, solve business problems and provide solutions using advance analytics through R, Python, Hadoop for decision making.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Lead projects end to end. This position is also to provide statistical functional expertise to the Eaton business operations in the reporting and analysis of data related to sales and customers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "ESSENTIAL FUNCTIONS: Major duties, functions and key responsibilities but not limited to are as follows",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A. Work with key stakeholders and lead high impact Advance Analytics and Data Science projects which enable Sales and Profit growth.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "B. Develop a niche team of data scientists & analysts to provide actionable intelligence for Sales, Marketing and Product teams.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "C. Proactively owns, drives and manages standardization of data and platforms to be build and share best practices for the field organization/ Senior Leaders.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "D. Exceptional analytical thinking to convert a business problem statement into an analytical problem statement.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "E. Play a lead role on cross-department projects and present business cases and systemic solutions to higher-level management teams.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "F. Understanding of Sales, marketing & digital data metrics would be added advantage.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "G. Lead / Co-lead analytical projects from conceptualization to execution and partner with the business in implementation of the analysis for driving incremental sales and profits.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "H. Identify and discover opportunities for utilizing advance analytics / Statistical methods and support in developing the competencies in the analytical team problem identification and problem solving",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "I. Ability to translate intelligence from data into business language with clearly articulating the approach, impacts and results – Sell Stories through presentations!",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "8-10 years of relevant work experience in solving sales & marketing problems using statistical techniques or advance analytics",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Master’s degree in Computer Science, Statistics, Mathematics or similar field preferred",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Statistical and Mathematical Modeling knowledge",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Structured approach to Problem Identification and Solving",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Hands-on experience and project delivery experiences on",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "o Machine Learning Techniques - K-mean, Random forest, Linear and Logistics Regression and Neural Networks etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "o Unstructured data analysis, eg: Text mining, Sentiment analysis etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "o Statistical analysis techniques and its applications to solve business problems using sales data such as Correlation Analysis, Hypothesis Testing, Multivariate Statistical Analysis, Time Series Techniques, Attribution Modelling. Strong experience on providing predictive modelling solutions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to leverage technology to solve analytical needs - SQL, R, Python and Power BI with working knowledge of Hadoop / Hive, SQL and NoSQL databases",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Hands on experience on KNIME Analytics Platform, Alteryx, Power BI and Hadoop / Hive is preferred",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Should be able to work with large datasets, measure results, identify impact and attribution, discovery, model and predict future performance.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Business proficiency in the following areas is required:",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "o Strong business acumen",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "o Understanding of sales cycle and seasonality impact on business and industry.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Good organizational and time management skills, strong analytical skills and the inter-personal skills to interact with all levels of management.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Highly motivated individual with excellent communication and collaboration skills.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We make what matters work. Everywhere you look—from the technology and machinery that surrounds us, to the critical services and infrastructure that we depend on every day—you’ll find one thing in common. It all relies on power. That’s why Eaton is dedicated to improving people’s lives and the environment with power management technologies that are more reliable, efficient, safe and sustainable. Because this is what matters.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are confident we can deliver on this promise because of the attributes that our employees embody. We’re ethical, passionate, accountable, efficient, transparent and we’re committed to learning. These values enable us to tackle some of the toughest challenges on the planet, never losing sight of what matters.",
            "intent": "job_description"
          },
