            "domain": "default",
            "utterance": "Network Administrator",
            "intent": "job_title"
          },
          {
            "domain": "default",
            "utterance": "Altruista Health is seeking the right candidate to join our dynamic and growing technology company (US healthcare domain) as a Network Administrator.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "POSITION SUMMARY",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The Network Administrator maintains and adjusts the network as needed ensuring maximum uptime, through monitoring, auditing, and reviewing network performance and security.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "THE ROLE & RESPONSIBILITIES",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage the implementation of IT strategy for the organization",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Perform the maintenance and administration of computer networks and related computing environments including computer networking hardware, software, applications, and related configurations",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Perform configuration backups and testing of backup restoration",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Participate in disaster recovery testing and scenario planning. Ability to perform when needed in the event of a failure requiring restoration of services",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Oversee the diagnosing, troubleshooting, and resolving of hardware, software, or other network and system problems, and replace defective components when necessary (Tier 2)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Responsible for planning, coordinating, and implementing network security measures to protect data, software, and hardware",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Secure network by developing network access, monitoring, control, evaluation and maintaining documentation",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Manage network performance to identify areas of opportunity for efficiency and growth",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Perform other duties as assigned",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Fully applies basic principles, theories, and concepts to job assignments. Exhibits technical and operational proficiency solving problems of moderate complexity. Contributes to the completion of projects and programs in the area of expertise. May interface with internal and/or external customers and provide guidance to entry level Developers.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "SUPERVISORY RESPONSIBILITIES",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The Network Administrator is not a supervisory role.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "QUALIFICATIONS",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "To perform this job successfully, an individual must be able to perform each essential duty satisfactorily. The requirements listed below are representative of the knowledge, skill, and/or ability required. Reasonable accommodations may be made to enable individuals with disabilities to perform the essential functions.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "EDUCATION and/or EXPERIENCE",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Bachelor’s Degree in Computer Science or related field (Master’s Degree preferred)",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "4+ years of related work experience",
            "intent": "job_description"
          },
