          },
          {
            "domain": "default",
            "utterance": "Leben Care is offering 3/ 6/ 9 month internships in the areas of deep machine learning and computer vision . The internships will require novel research as well as development for solving challenging problems . We are seeking qualified and highly motivated graduate students (Masters, PhD) interested in working on these problems.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The interns will have an opportunity to work on large public domain datasets; publish in top-tier conferences such as CVPR, ICCV, ECCV, NIPS, ICML and SIGGRAPH; work with business-proprietary use cases and datasets leading to inventions and patents.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Qualifications/ Experience",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A BS/ MS degree in Computer Science, Electrical Engineering or related field.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Hands-on experience in machine learning / computer vision . Prior publication record in relevant top-tier conferences/ journals highly desirable.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Technical Skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficiency in C, C++, Python. Experience using OpenCV, Caffe, Theano / Torch.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Experience on application development in Linux/ Windows desirable.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "General Skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Excellent communication, problem-solving and analytical skills, ability to learn quickly.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "A strong passion for empirical research and for answering hard questions with data.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ability to work both autonomously and in a team.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Number of Positions",
            "intent": "job_description"
          },
