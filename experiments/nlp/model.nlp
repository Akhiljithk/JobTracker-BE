            "utterance": "Basic Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Bachelors Degree in Computer Science or related field",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Equivalent experience to a Bachelor's degree based on 3 years of work experience for every 1 year of education",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• 2+ years professional experience in software development",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Computer Science fundamentals in object-oriented design",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Computer Science fundamentals in data structures",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Computer Science fundamentals in algorithm design, problem solving, and complexity analysis",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Proficiency in, at least, one modern programming language such as C, C++, Java, or Perl",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Preferred Qualifications",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Experience building complex software systems that have been successfully delivered to customers",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• Knowledge of professional software engineering practices & best practices for the full software development life cycle, including coding standards, code reviews, source control management, build processes, testing, and operations",
            "intent": "job_description"
          },
          {
            "domain": "default",
