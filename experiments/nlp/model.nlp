            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "• 5-8 years Javascript experience building products/solutions that are performant with big data sets. Experience with Node.js and React.js, Vue.js, or Angular.js",
            "intent": "job_description"
