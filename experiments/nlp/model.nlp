            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient with Component based development in JavaScript frameworks (React.JS is ideal). Hands-on with TypeScript or Material-UI would be a huge plus",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Proficient working in an Agile Software Development environment",
            "intent": "job_description"
          },
          {
            "domain": "default",
