            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We are an Artificial Intelligence (AI) focused product engineering company, providing our customers in healthcare, retail & e-commerce, manufacturing and hospitality sectors with cutting edge products & solutions, harnessing Big Data Analytics, Vision Analytics, and IoT.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Ever since our inception in March 2010, Tech Vedika has been a partner of choice for several clients in US, Canada, Middle East and APAC. We were listed as one of the Top 10 Healthcare Analytics Solution Provider for year 2019' by Healthcare Tech Outlook Magazine.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We strive for simple, elegant tech solutions to perform complex tasks. As a scalable technology partner, we enable organisations to improve operational efficiency and unleash new business potential",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Job Description",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "As a senior Infrastructure Engineer you will be working in a challenging environment, supporting the business in day to day operations, as well as facilitating business changes.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "The primary responsibility of this position is to develop, maintain, continuously improve and support both internal and client-facing IT infrastructure, including servers, storage, networks and telecoms systems.",
            "intent": "job_description"
          },
