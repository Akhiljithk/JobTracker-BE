            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "HTML5, CSS3, jquery, Javascript, Strong knowledge of PHP web frameworks such as Laravel, etc depending on your technology stack.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Understanding the fully synchronous behavior of PHP.",
