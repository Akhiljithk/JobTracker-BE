            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "We bring to the notice of all concerned that Airbus Group India Pvt. Ltd (hereinafter referred to as “AIG”) follows a fair and merit-based employee selection and recruitment practice.",
            "intent": "job_description"
