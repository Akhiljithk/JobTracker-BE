          },
          {
            "domain": "default",
            "utterance": "As a Senior Software Engineer you will be responsible to design, build, test and deploy cutting edge solutions at scale",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "You will need to exhibit strong leadership and communication skills to collaborate with product, engineering and management",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Create and recommend solution design options factoring in requirements, standards and current Infrastructure environment. Communicate and present solutions to the other stakeholders",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Guide and mentor others members in the team to promote highly technical and self-sufficient teams Skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Java, Spring Boot, Cloud, Web Services (RESTful & SOAP), Hibernate and SQL",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Strong computer science fundamentals in algorithms, data structures, databases, caching etc.",
            "intent": "job_description"
          },
          {
            "domain": "default",
            "utterance": "Solid object-oriented software development skills",
            "intent": "job_description"
          },
          {
            "domain": "default",
